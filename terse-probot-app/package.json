{
  "name": "terse-probot-app",
  "version": "1.0.0",
  "private": true,
  "description": "A Probot app",
  "author": "Thomas Karatzas",
  "license": "SEE LICENSE IN ../LICENSE.md",
  "homepage": "https://github.com//",
  "keywords": [
    "probot",
    "github",
    "probot-app"
  ],
  "scripts": {
    "build": "tsc && npm run postbuild",
    "format": "pnpm exec prettier --config ../.prettierrc --write \"src/**/*.ts\"",
    "format:check": "pnpm exec prettier --config ../.prettierrc --check \"src/**/*.ts\"",
    "postbuild": "tsc-esm-fix dist",
    "start": "probot run ./lib/index.js",
    "test": "vitest"
  },
  "dependencies": {
    "@octokit/webhooks": "^10.0.0",
    "axios": "^1.15.2",
    "jsonwebtoken": "^9.0.0",
    "probot": "^12.0.0",
    "tsc-esm-fix": "^3.1.2"
  },
  "overrides": {
    "handlebars": "^4.7.9",
    "path-to-regexp": "^0.1.13",
    "picomatch": "^2.3.2",
    "minimatch": "^5.1.8",
    "rollup": "^4.59.0",
    "jws": "^3.2.3",
    "validator": "^13.15.22",
    "postcss": "^8.5.10",
    "vite": "^6.4.2",
    "brace-expansion": "^2.0.3",
    "qs": "^6.14.1",
    "js-yaml": "^3.14.2 || ^4.1.1",
    "@octokit/request": "^8.4.1",
    "@octokit/plugin-paginate-rest": "^9.2.2",
    "@octokit/request-error": "^5.1.1",
    "esbuild": "^0.25.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.0",
    "@types/express": "^5.0.3",
    "@types/node": "^20.0.0",
    "nock": "^14.0.5",
    "smee-client": "^2.0.0",
    "typescript": "^5.8.3",
    "vitest": "^3.0.0"
  },
  "type": "module"
}
