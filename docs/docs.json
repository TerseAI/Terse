{
    "$schema": "https://mintlify.com/docs.json",
    "theme": "mint",
    "favicon": {
        "light": "/logo/light.svg",
        "dark": "/logo/dark.svg"
    },
    "name": "Terse",
    "logo": {
        "light": "/logo/terse.png",
        "dark": "/logo/terse.png",
        "size": 80
    },
    "colors": {
        "primary": "#0F766E",
        "light": "#14B8A6",
        "dark": "#115E59"
    },
    "navigation": {
        "groups": [
            {
                "group": "Getting started",
                "pages": ["index", "quickstart", "context-as-code", "hosting"]
            },
            {
                "group": "Core Concepts",
                "pages": ["core-concepts/jobs", "core-concepts/deterministic-tool-calls", "core-concepts/self-improvement"]
            },
            {
                "group": "Reference",
                "pages": ["reference/cli", "reference/triggers", "reference/skills", "reference/typescript-sdk", "reference/python-sdk"]
            },
            {
                "group": "Templates",
                "root": "templates/index",
                "pages": ["templates/new-deal-enrichment", "templates/weekly-pipeline-digest", "templates/crm-slack-alerts", "templates/contact-scoring"]
            },
            {
                "group": "Compare",
                "root": "compare/index",
                "pages": ["reference/vs-zapier", "reference/vs-custom-scripts", "reference/vs-ai-agents"]
            }
        ]
    },
    "navbar": {
        "links": [
            {
                "label": "Website",
                "href": "https://useterse.ai"
            }
        ],
        "primary": {
            "type": "button",
            "label": "Open app",
            "href": "https://app.useterse.ai"
        }
    },
    "redirects": [],
    "contextual": {
        "options": ["view", "chatgpt", "claude", "mcp", "cursor", "vscode"]
    },
    "icons": {
        "library": "lucide"
    },
    "seo": {
        "indexing": "all",
        "metatags": {
            "og:type": "website",
            "og:site_name": "Terse AI Documentation"
        }
    }
}
