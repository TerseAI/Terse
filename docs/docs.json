{
    "$schema": "https://mintlify.com/docs.json",
    "theme": "mint",
    "favicon": {
        "light": "/logo/light.svg",
        "dark": "/logo/dark.svg"
    },
    "name": "Terse",
    "logo": {
        "light": "/logo/terse.png",
        "dark": "/logo/terse.png",
        "size": 80
    },
    "colors": {
        "primary": "#2F7A52",
        "light": "#4FA774",
        "dark": "#1F5A38"
    },
    "navigation": {
        "groups": [
            {
                "group": "Getting started",
                "pages": ["index", "quickstart", "context-as-code", "hosting", "self-hosting"]
            },
            {
                "group": "Core Concepts",
                "pages": [
                    "core-concepts/jobs",
                    "core-concepts/terse-agent",
                    "core-concepts/generated-sdk",
                    "core-concepts/skills-and-integrations",
                    "core-concepts/deterministic-tool-calls",
                    "core-concepts/human-in-the-loop",
                    "core-concepts/self-improvement"
                ]
            },
            {
                "group": "Reference",
                "pages": ["reference/cli", "reference/triggers", "reference/skills", "reference/typescript-sdk"]
            }
        ]
    },
    "navbar": {
        "links": [
            {
                "label": "Website",
                "href": "https://useterse.ai"
            }
        ],
        "primary": {
            "type": "button",
            "label": "Open app",
            "href": "https://app.useterse.ai"
        }
    },
    "redirects": [],
    "contextual": {
        "options": ["view", "chatgpt", "claude", "mcp", "cursor", "vscode"]
    },
    "icons": {
        "library": "lucide"
    },
    "seo": {
        "indexing": "all",
        "metatags": {
            "og:type": "website",
            "og:site_name": "Terse AI Documentation"
        }
    }
}
