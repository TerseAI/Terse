{
    "name": "terse",
    "private": true,
    "scripts": {
        "build": "pnpm -r run build",
        "dev": "pnpm run dev:setup && pnpm -r --parallel --stream run dev",
        "dev:setup": "pnpm -r --filter terse-types --filter terse-sdk --filter terse-cli run build",
        "format": "pnpm -r run format && pnpm --dir terse-probot-app run format",
        "format:check": "pnpm -r run format:check && pnpm --dir terse-probot-app run format:check",
        "install-global": "pnpm -r --filter terse-sdk --filter terse-cli --filter create-terse run install-global",
        "publish:npm": "bash scripts/publish.sh"
    },
    "devDependencies": {
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "prettier": "^3.8.1"
    },
    "pnpm": {
        "overrides": {
            "@types/express-serve-static-core": "5.0.7",
            "protobufjs": ">=7.5.6 <8 || >=8.4.1",
            "axios": ">=1.15.2",
            "fast-uri": ">=3.1.2",
            "fast-xml-builder": ">=1.1.7",
            "langsmith": ">=0.6.0",
            "vite": "4 || >=8.0.16",
            "hono": ">=4.12.25",
            "@hono/node-server": ">=1.19.13",
            "ip-address": ">=10.1.1",
            "ws": ">=8.21.0",
            "undici": ">=7.28.0 <8 || >=8.5.0",
            "form-data": ">=2.5.6 <3 || >=4.0.6",
            "brace-expansion@>=5.0.0 <5.0.6": "5.0.6",
            "uuid@>=11.0.0 <11.1.1": "11.1.1",
            "uuid@>=13.0.0 <13.0.1": "13.0.1",
            "fast-xml-parser": ">=5.7.0",
            "dompurify": ">=3.4.0",
            "@grpc/grpc-js": ">=1.14.4 <1.15.0",
            "react-router": ">=7.15.0 <7.16.0",
            "react-router-dom": ">=7.15.0 <7.16.0",
            "zod": "4.3.6"
        },
        "ignoredBuiltDependencies": [
            "@prisma/client",
            "@prisma/engines",
            "cbor-extract",
            "esbuild",
            "prisma",
            "protobufjs"
        ]
    }
}
