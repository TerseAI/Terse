{
    "name": "terse",
    "private": true,
    "scripts": {
        "build": "pnpm -r run build",
        "dev": "pnpm run dev:setup && pnpm -r --parallel --stream run dev",
        "dev:setup": "pnpm -r --filter terse-types --filter terse-sdk --filter terse-cli run build",
        "format": "pnpm -r run format && pnpm --dir terse-probot-app run format",
        "format:check": "pnpm -r run format:check && pnpm --dir terse-probot-app run format:check",
        "install-global": "pnpm -r --filter terse-sdk --filter terse-cli run install-global",
        "publish:npm": "bash scripts/publish.sh"
    },
    "devDependencies": {
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "prettier": "^3.8.1"
    },
    "pnpm": {
        "overrides": {
            "@types/express-serve-static-core": "5.0.7",
            "protobufjs": ">=7.5.6 <8 || >=8.0.2",
            "axios": ">=1.15.2",
            "fast-uri": ">=3.1.2",
            "fast-xml-builder": ">=1.1.7",
            "langsmith": ">=0.6.0",
            "vite": "4 || >=7.3.2"
        },
        "ignoredBuiltDependencies": [
            "@prisma/client",
            "@prisma/engines",
            "cbor-extract",
            "esbuild",
            "prisma",
            "protobufjs"
        ]
    }
}
