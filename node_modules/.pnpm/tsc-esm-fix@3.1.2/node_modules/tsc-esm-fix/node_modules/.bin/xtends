else
  export NODE_PATH="/root/Terse/node_modules/.pnpm/@topoconfig+extends@0.16.2/node_modules/@topoconfig/extends/target/esm/node_modules:/root/Terse/node_modules/.pnpm/@topoconfig+extends@0.16.2/node_modules/@topoconfig/extends/target/node_modules:/root/Terse/node_modules/.pnpm/@topoconfig+extends@0.16.2/node_modules/@topoconfig/extends/node_modules:/root/Terse/node_modules/.pnpm/@topoconfig+extends@0.16.2/node_modules/@topoconfig/node_modules:/root/Terse/node_modules/.pnpm/@topoconfig+extends@0.16.2/node_modules:/root/Terse/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../../../../../@topoconfig+extends@0.16.2/node_modules/@topoconfig/extends/target/esm/cli.mjs" "$@"
else
  exec node  "$basedir/../../../../../@topoconfig+extends@0.16.2/node_modules/@topoconfig/extends/target/esm/cli.mjs" "$@"
