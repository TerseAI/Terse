{
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter terse-types run build && pnpm --filter frontend run build",
  "outputDirectory": "frontend/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://api.useterse.ai/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
