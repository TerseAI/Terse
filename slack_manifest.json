{
    "display_information": {
        "name": "Terse",
        "description": "Never Update Documents Again",
        "background_color": "#081640",
        "long_description": "A Slack app for listening to messages and posting messages to channels."
    },
    "features": {
        "bot_user": {
            "display_name": "Terse",
            "always_online": false
        }
    },
    "oauth_config": {
        "redirect_urls": [
            "https://app.useterse.ai/api/slack/oauth-callback",
            "http://localhost:3001/slack/oauth-callback"
        ],
        "scopes": {
            "user": [
                "admin.apps:read"
            ],
            "bot": [
                "chat:write",
                "groups:write",
                "im:write",
                "mpim:write",
                "users:read",
                "users:read.email",
                "app_mentions:read",
                "im:read"
            ]
        }
    },
    "settings": {
        "event_subscriptions": {
            "request_url": "https://loss-occupation-usa-video.trycloudflare.com/slack/events",
            "user_events": [
                "app_uninstalled_team"
            ],
            "bot_events": [
                "app_uninstalled"
            ]
        },
        "org_deploy_enabled": false,
        "socket_mode_enabled": false,
        "token_rotation_enabled": false
    }
}