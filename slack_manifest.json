{
    "display_information": {
        "name": "Vectra",
        "description": "Removes Engineering Over-head. Just code",
        "background_color": "#081640",
        "long_description": "A simple Slack app that pushes updates that are done by the Vectra AI.\r\n\r\nVectra AI acts as a virtual Product Manager that looks over GitHub activity and will update your Tickets on your behalf.\r\n\r\nWhen it makes an updaete, it will notify you on slack."
    },
    "features": {
        "bot_user": {
            "display_name": "Vectra",
            "always_online": false
        }
    },
    "oauth_config": {
        "redirect_urls": [
            "https://cursor-for-tickets.onrender.com/slack/oauth-callback"
        ],
        "scopes": {
            "user": [],
            "bot": [
                "chat:write",
                "groups:write",
                "im:write",
                "mpim:write",
                "users:read",
                "users:read.email",
                "app_mentions:read",
                "channels:read",
                "channels:history",
                "channels:join",
                "groups:read",
                "groups:history",
                "im:read",
                "im:history",
                "mpim:read",
                "mpim:history"
            ]
        }
    },
    "settings": {
        "event_subscriptions": {
            "request_url": "https://destiny-gym-doctor-motorcycles.trycloudflare.com/slack/events",
            "user_events": [
                "app_uninstalled_team"
            ],
            "bot_events": [
                "app_uninstalled",
                "message"
            ]
        },
        "org_deploy_enabled": false,
        "socket_mode_enabled": false,
        "token_rotation_enabled": false
    }
}