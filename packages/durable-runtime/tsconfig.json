{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "types": ["node", "vitest/globals"]
    },
    "include": ["src/**/*.ts", "test/**/*.ts", "vitest.config.ts"],
    "exclude": ["node_modules", "dist"]
}
