{
    "name": "terse-cli",
    "version": "0.5.0",
    "type": "module",
    "license": "SEE LICENSE IN LICENSE.md",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/TerseAI/Terse.git",
        "directory": "packages/terse-cli"
    },
    "homepage": "https://docs.useterse.ai",
    "bugs": {
        "url": "https://github.com/TerseAI/Terse/issues"
    },
    "bin": {
        "terse": "dist/index.js"
    },
    "files": [
        "dist",
        "templates",
        "src/providers/typescript/modules/**/*.hbs"
    ],
    "scripts": {
        "build": "rm -rf dist && tsc && chmod +x dist/index.js",
        "dev": "tsc --watch --preserveWatchOutput",
        "test": "node --import tsx --test test/**/*.test.ts",
        "format": "pnpm exec prettier --config ../../.prettierrc --write \"src/**/*.ts\"",
        "format:check": "pnpm exec prettier --config ../../.prettierrc --check \"src/**/*.ts\"",
        "install-global": "npm run build && npm link"
    },
    "dependencies": {
        "@clack/prompts": "^1.0.0",
        "@inquirer/prompts": "^7.0.0",
        "@pnpm/tabtab": "^0.5.4",
        "chalk": "^5.0.0",
        "commander": "^14.0.0",
        "conf": "^15.1.0",
        "dotenv": "^17.4.2",
        "fflate": "^0.8.0",
        "handlebars": "^4.7.9",
        "json-schema-to-typescript": "^15.0.4",
        "luxon": "^3.7.2",
        "little-durable": "0.1.3",
        "ora": "^8.0.0",
        "terse-sdk": "workspace:*",
        "terse-types": "workspace:*",
        "tsx": "^4.0.0",
        "typescript": "^5.0.0",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@types/luxon": "^3.7.1",
        "@types/node": "^22.0.0"
    }
}
