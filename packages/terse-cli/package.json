{
    "name": "terse-cli",
    "version": "0.1.44",
    "type": "module",
    "bin": {
        "terse": "dist/index.js"
    },
    "files": [
        "dist",
        "templates"
    ],
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch --preserveWatchOutput",
        "format": "pnpm exec prettier --config ../../.prettierrc --write \"src/**/*.ts\"",
        "format:check": "pnpm exec prettier --config ../../.prettierrc --check \"src/**/*.ts\"",
        "install-global": "npm run build && npm link"
    },
    "dependencies": {
        "@clack/prompts": "^1.0.0",
        "@inquirer/prompts": "^7.0.0",
        "chalk": "^5.0.0",
        "commander": "^14.0.0",
        "conf": "^15.1.0",
        "dotenv": "^17.4.2",
        "fflate": "^0.8.0",
        "handlebars": "^4.7.9",
        "ora": "^8.0.0",
        "terse-sdk": "workspace:*",
        "terse-types": "workspace:*",
        "tsx": "^4.0.0"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "typescript": "^5.0.0"
    }
}
