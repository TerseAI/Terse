        },
        /** Trigger on user deletion */
        onUserDeleted(): TypedTrigger<WorkOSUserDeletedTrigger> {
            return new WorkOSInputConfig("workos-int-1", [WorkOSEventType.USER_DELETED])
        },
        /** Trigger on organization membership creation */
        onMembershipCreated(): TypedTrigger<WorkOSOrganizationMembershipCreatedTrigger> {
            return new WorkOSInputConfig("workos-int-1", [WorkOSEventType.ORGANIZATION_MEMBERSHIP_CREATED])
        },
        /** Trigger on organization membership update */
        onMembershipUpdated(): TypedTrigger<WorkOSOrganizationMembershipUpdatedTrigger> {
            return new WorkOSInputConfig("workos-int-1", [WorkOSEventType.ORGANIZATION_MEMBERSHIP_UPDATED])
        },
        /** Trigger on organization membership deletion */
        onMembershipDeleted(): TypedTrigger<WorkOSOrganizationMembershipDeletedTrigger> {
            return new WorkOSInputConfig("workos-int-1", [WorkOSEventType.ORGANIZATION_MEMBERSHIP_DELETED])
        },
        /** Trigger on any organization membership change */
        onMembershipChanged(): TypedTrigger<WorkOSMembershipTrigger> {
            return new WorkOSInputConfig("workos-int-1", [WorkOSEventType.ORGANIZATION_MEMBERSHIP_CREATED, WorkOSEventType.ORGANIZATION_MEMBERSHIP_UPDATED, WorkOSEventType.ORGANIZATION_MEMBERSHIP_DELETED])
        },
        /** Trigger when an invitation is sent (created or resent) */
        onInvitationSent(): TypedTrigger<WorkOSInvitationTrigger> {
            return new WorkOSInputConfig("workos-int-1", [WorkOSEventType.INVITATION_CREATED, WorkOSEventType.INVITATION_RESENT])
        },
        /** Trigger when an invitation is first created */
        onInvitationCreated(): TypedTrigger<WorkOSInvitationCreatedTrigger> {
            return new WorkOSInputConfig("workos-int-1", [WorkOSEventType.INVITATION_CREATED])
        },
        /** Trigger when an invitation is resent */
        onInvitationResent(): TypedTrigger<WorkOSInvitationResentTrigger> {
            return new WorkOSInputConfig("workos-int-1", [WorkOSEventType.INVITATION_RESENT])
        },
        /** Trigger on invitation accepted */
        onInvitationAccepted(): TypedTrigger<WorkOSInvitationAcceptedTrigger> {
            return new WorkOSInputConfig("workos-int-1", [WorkOSEventType.INVITATION_ACCEPTED])
        },
        /** Trigger when an invitation is revoked */
        onInvitationRevoked(): TypedTrigger<WorkOSInvitationRevokedTrigger> {
            return new WorkOSInputConfig("workos-int-1", [WorkOSEventType.INVITATION_REVOKED])
        },
        /** Trigger on organization creation */
        onOrganizationCreated(): TypedTrigger<WorkOSOrganizationTrigger> {
            return new WorkOSInputConfig("workos-int-1", [WorkOSEventType.ORGANIZATION_CREATED])
        },
        /** Trigger on specific WorkOS event types */
        trigger(opts?: { eventTypes?: WorkOSEventType[] }): TypedTrigger<WorkOSTrigger | WorkOSUserTrigger | WorkOSMembershipTrigger | WorkOSInvitationTrigger | WorkOSOrganizationTrigger> {
            return new WorkOSInputConfig("workos-int-1", opts?.eventTypes)
        },
    },
    schedule: {
        /** Run on a cron schedule */
        cron(opts: { expression: string }): TypedTrigger<CronTrigger> {
            return new TimeTriggerConfig(opts.expression)
        },
    },
    webhook: {
        /** Trigger via an external HTTP request to a generated URL */
        onRequest<TBody = unknown>(): TypedTrigger<WebhookTrigger<TBody>> {
            return new WebhookInputConfig()
        },
    },
    webMonitor: {
        /** Trigger when a query against the live web matches the given schema */
        onEvent<const TSchema>(opts: {
            query: string
            frequency: { number: number; unit: FrequencyUnit }
            outputSchema?: TSchema
        }): TypedTrigger<WebMonitorTrigger<InferStructuredOutput<TSchema>>> {
            return new WebMonitorConfig(opts.query, opts.frequency, opts.outputSchema)
        },
    },
}
// ── Skills ────────────────────────────────────────────────────

/**
 * Skills available in your workspace.
 *
 * Type `Skills.` in your editor to see every connected integration's skill at a glance.
 * Use these in `generateText({ skills: [...] })` (or `TerseAgent.create({ skills: [...] })`).
 */
export const Skills = {
    /** Slack — send messages and manage threads in a specific channel */
    slack(opts: { channel: SlackChannel; userIds?: string[]; userNames?: string[]; listenToUserDms?: boolean }): TypedSkill<"slack_read_conversation" | "slack_send_message"> {
        return new SlackOutputConfig("slack-int-1", opts.channel.channelId ?? null, opts.channel.name ?? null, opts.userIds ?? [], opts.userNames ?? null, opts.listenToUserDms)
    },
    /** GitHub — read code and pull requests from the given repositories */
    github(opts: { repos: Repos[] }): TypedSkill<"readGitHubFile" | "searchGitHubCode"> {
        return new GitHubConfig("github-int-1", opts.repos.map(r => r.repositoryId))
    },
    /** Linear — read and write issues, optionally scoped to a team or project */
    linear(opts?: { team?: LinearTeam; project?: LinearProject }): TypedSkill<"linear_create_ticket" | "linear_read_ticket"> {
        return new LinearOutputConfig(
            "linear-int-1",
            opts?.team?.teamId ?? null,
            opts?.team?.name ?? null,
            opts?.project?.projectId ?? null
        )
    },
    /** Gmail — send emails */
    gmail(): TypedSkill<"gmail_send_email"> {
        return new GmailOutputConfig("gmail-int-1")
    },
    /** Gmail — create draft emails (no auto-send) */
    gmailDraft(): TypedSkill<"gmail_send_email"> {
        return new GmailDraftOutputConfig("gmail-int-1")
    },
    /** Notion — read and write to the given databases or pages */
    notion(opts?: { databases?: NotionDatabase[]; pages?: NotionPage[] }): TypedSkill<"notion_query_database"> {
        return new NotionConfig("notion-int-1",
            opts?.databases?.map(d => d.databaseId), opts?.databases?.map(d => d.title),
            opts?.pages?.map(p => p.pageId), opts?.pages?.map(p => p.title))
    },
    /** PostHog — query analytics for a specific project */
    posthog(opts: { project: PosthogProject }): TypedSkill<"searchPosthogEvents"> {
        return new PosthogConfig("posthog-int-1", opts.project.projectId, opts.project.name)
    },
    /** Datadog — search and analyze logs, optionally scoped to specific indexes */
    datadog(opts?: { indexes?: DatadogIndex[] }): TypedSkill<"searchDatadogLogs"> {
        return new DatadogConfig("datadog-int-1", opts?.indexes?.map(i => i.name))
    },
    /** LaunchDarkly — read and toggle feature flags in a project + environments */
    launchDarkly(opts: { project: LaunchDarklyProject; environmentKeys: string[] }): TypedSkill<"listLaunchDarklyFlags"> {
        return new LaunchDarklyConfig("ld-int-1", opts.project.projectKey, opts.environmentKeys)
    },
    /** WorkOS — manage users, organizations and invitations */
    workOS(): TypedSkill<"listWorkOSUsers"> {
        return new WorkOSOutputConfig("workos-int-1")
    },
    /** Attio — query and upsert records on a CRM object */
    attio(opts: { object: AttioObject<any> }): TypedSkill<"attio_list_objects" | "attio_query_records" | "attio_upsert_record"> {
        return new AttioOutputConfig("attio-int-1", opts.object.apiSlug)
    },
    /** Snowflake — run SQL queries against your warehouse */
    snowflake(): TypedSkill<"snowflakeExecuteQuery"> {
        return new SnowflakeOutputConfig("snowflake-int-1")
    },
    /** Web — built-in web search, page extraction, and multi-source research. Pass `allowedDomains` to restrict search and page extraction to specific sites (and their subdomains). */
    web(opts: { allowedDomains?: string[] } = {}): TypedSkill<"web_search" | "web_extract" | "web_research"> {
        return new WebConfig(opts)
    },
    /** ImageEdit — edit and generate images */
    imageEdit(): TypedSkill<"image_edit"> {
        return new ImageEditConfig()
    },
    /** Memory — built-in persistent memory the agent reads and writes under /memories, scoped to this job and surviving across runs. */
    memory(): TypedSkill<"memory"> {
        return new MemoryConfig()
    },
}
// ── Typed Tools ───────────────────────────────────────────────

type __AttioPrimitive = string | number | boolean | null
type __AttioStructuredValue = Record<string, unknown>
type __AttioValue = __AttioPrimitive | __AttioStructuredValue | (__AttioPrimitive | __AttioStructuredValue)[]
type __AttioFilterShorthand<T> = T extends (infer U)[] ? U | T : T
type __AttioFilterValue<T> = __AttioFilterShorthand<T> | { $eq?: __AttioFilterShorthand<T>; $contains?: string; $starts_with?: string; $ends_with?: string } | Record<string, unknown>
type __AttioFilterExpression<TValues extends Record<string, unknown>> = Partial<{ [K in keyof TValues]: __AttioFilterValue<TValues[K]> }> & { $and?: Array<__AttioFilterExpression<TValues>>; $or?: Array<__AttioFilterExpression<TValues>> }
type __AttioRecordBase = NonNullable<NonNullable<ToolOutputByName["attio_upsert_record"]["records"]>[number]>
type __AttioRecordWithValues<TValues extends Record<string, unknown>> = Omit<__AttioRecordBase, "values"> & TValues & { values: TValues; attributes: TValues }

export type AttioInputValuesByObject = {
    "people": {
    "name"?: string
    "email_addresses"?: string[]
}
}

export type AttioRecordValuesByObject = {
    "people": {
    "name"?: string
    "email_addresses"?: string[]
}
}

export type AttioFilterByObject = {
    "people": __AttioFilterExpression<AttioRecordValuesByObject["people"]>
}

export type AttioRecordByObject = {
    "people": __AttioRecordWithValues<AttioRecordValuesByObject["people"]>
}

export type AttioValuesFor<TObject extends GeneratedAttioObject = GeneratedAttioObject> = TObject extends { __inputValues: infer TInputValues } ? TInputValues : AttioInputValuesByObject[TObject["apiSlug"]]
export type AttioRecordValuesFor<TObject extends GeneratedAttioObject = GeneratedAttioObject> = TObject extends { __recordValues: infer TRecordValues } ? TRecordValues : AttioRecordValuesByObject[TObject["apiSlug"]]
export type AttioAttributeSlug<TObject extends GeneratedAttioObject = GeneratedAttioObject> = Extract<keyof AttioValuesFor<TObject>, string>
export type AttioFilterFor<TObject extends GeneratedAttioObject = GeneratedAttioObject> = __AttioFilterExpression<AttioRecordValuesFor<TObject>>
export type AttioRecordFor<TObject extends GeneratedAttioObject = GeneratedAttioObject> = __AttioRecordWithValues<AttioRecordValuesFor<TObject>>
export type AttioQueryRecordsParams<TObject extends GeneratedAttioObject = GeneratedAttioObject> = { object: TObject; filter?: AttioFilterFor<TObject> | null; limit?: number | null }
export type AttioUpsertRecordParams<TObject extends GeneratedAttioObject = GeneratedAttioObject> = { object: TObject; matchingAttribute: AttioAttributeSlug<TObject>; records: AttioValuesFor<TObject>[] }
export type AttioListObjectsParams = Record<string, never>
export type AttioQueryRecordsResult<TObject extends GeneratedAttioObject = GeneratedAttioObject> = Omit<ToolOutputByName["attio_query_records"], "records"> & { records: Array<AttioRecordFor<TObject>> }
export type AttioUpsertRecordResult<TObject extends GeneratedAttioObject = GeneratedAttioObject> = Omit<ToolOutputByName["attio_upsert_record"], "records"> & { records?: Array<AttioRecordFor<TObject>> }

function __normalizeAttioObjectSlug(object: unknown): string {
    if (object && typeof object === "object" && "apiSlug" in (object as Record<string, unknown>)) {
        const apiSlug = (object as { apiSlug?: unknown }).apiSlug
        if (typeof apiSlug === "string" && apiSlug.length > 0) return apiSlug
    }
    return typeof object === "string" ? object : ""
}

function __serializeAttioFilter(filter: unknown): string | null {
    if (filter === undefined || filter === null) return null
    return JSON.stringify(filter)
}

function __serializeAttioRecords(records: unknown): string {
    if (!Array.isArray(records)) return JSON.stringify([])
    return JSON.stringify(records.filter((record): record is Record<string, unknown> => typeof record === "object" && record !== null && !Array.isArray(record)))
}

function __enhanceAttioRecord<TObject extends GeneratedAttioObject>(object: TObject, record: unknown): __AttioRecordWithValues<AttioRecordValuesFor<TObject>> | undefined {
    if (!record || typeof record !== "object") return undefined
    const values = __getAttioRecordValues<AttioRecordValuesFor<TObject>>(__normalizeAttioObjectSlug(object), record)
    return { ...values, ...(record as __AttioRecordBase), values, attributes: values } as __AttioRecordWithValues<AttioRecordValuesFor<TObject>>
}

function __enhanceAttioQueryResult<TObject extends GeneratedAttioObject>(object: TObject, result: ToolOutputByName["attio_query_records"]): AttioQueryRecordsResult<TObject> {
    return {
        ...result,
        records: (result.records || []).map(record => __enhanceAttioRecord(object, record)).filter(Boolean) as Array<AttioRecordFor<TObject>>,
    }
}

function __enhanceAttioUpsertResult<TObject extends GeneratedAttioObject>(object: TObject, result: ToolOutputByName["attio_upsert_record"]): AttioUpsertRecordResult<TObject> {
    return {
        ...result,
        records: (result.records || []).map(record => __enhanceAttioRecord(object, record)).filter(Boolean) as Array<AttioRecordFor<TObject>>,
    }
}

/** Audit-log entry describing an action a tool performed; included on tool results as `actions`. */
export interface RunHistoryAction {
    action: string
    integration:
        | "github"
        | "hey_reach"
        | "gmail"
        | "linear"
        | "slack"
        | "notion"
        | "terse"
        | "posthog"
        | "datadog"
        | "cron_job"
        | "launchdarkly"
        | "workos"
        | "attio"
        | "snowflake"
        | "webhook"
        | "webmonitor"
    target: string
    details: string
    url?: string
    step_id?: string
    type: "create" | "update" | "delete" | "read" | "approve" | "error"
    isReadOnly?: boolean
    output_items?: {
        output_item_id: string
        output_item_type:
            | "gmail"
            | "gmail_output"
            | "gmail_draft_output"
            | "slack"
            | "slack_output"
            | "notion"
            | "linear_input"
            | "linear_output"
            | "github"
            | "POSTHOG"
            | "DATADOG"
            | "time_trigger"
            | "launchdarkly"
            | "web"
            | "image_edit"
            | "memory"
            | "workos_input"
            | "workos_output"
            | "attio_input"
            | "attio_output"
            | "snowflake_output"
            | "webhook_input"
            | "webmonitor"
            | "hey_reach_input"
    }[]
}

// ── datadog tool types ────────────────────────────────────────

/** Search Datadog logs. */
export interface SearchDatadogLogsParams {
    /**
     * Default log indexes to search (e.g., ["main"]). Falls back to ["main"] if not provided.
     */
    defaultIndexes?: string[] | null
    /**
     * Datadog log search query (e.g., service:web AND @status:error)
     */
    query?: string | null
    /**
     * Log indexes to search (e.g., ["main"]). Defaults to defaultIndexes if not provided.
     */
    indexes?: string[] | null
    /**
     * Start time (ISO8601 or relative like "now-1h")
     */
    from?: string | null
    /**
     * End time (ISO8601). Defaults to now if not provided.
     */
    to?: string | null
    /**
     * Maximum number of log entries to return (default: 50)
     */
    limit?: number
    /**
     * Pagination cursor from previous response
     */
    cursor?: string | null
    /**
     * Sort order: "timestamp" (ascending) or "-timestamp" (descending)
     */
    sort?: "timestamp" | "-timestamp"
}

export interface SearchDatadogLogsResult {
    success: boolean
    actions?: RunHistoryAction[]
    query: string | null
    indexes: string[]
    totalLogs: number
    logs: {
        id: string
        timestamp?: string
        message?: string
        host?: string
        service?: string
        status?: string
        tags: string[]
        customAttributes: {
            [k: string]: unknown
        }
    }[]
    logsLink: string
    pagination: {
        limit: number
        cursor?: string | null
        nextCursor: string | null
        hasMore: boolean
        showing: string
    }
    warnings: string | null
    message: string
}

// ── github tool types ─────────────────────────────────────────

/** Read a file from a GitHub repository. */
export interface ReadGitHubFileParams {
    /**
     * The repository in "owner/repo" format (e.g., "facebook/react"). Must be one of the configured repositories.
     */
    repository: string
    /**
     * The file path within the repository (e.g., "src/components/Button.tsx" or "README.md")
     */
    path: string
    /**
     * Start reading from this line number (1-indexed). Use with endLine for partial file reads. Use null to start from beginning.
     */
    startLine?: number | null
    /**
     * Stop reading at this line number (1-indexed, inclusive). Use with startLine for partial file reads. Use null to read to end.
     */
    endLine?: number | null
}

export interface ReadGitHubFileResult {
    success: boolean
    actions?: RunHistoryAction[]
    repository: string
    path: string
    url: string
    totalLines: number
    displayedLines: string
    size: number
    content: string
    warning?: string
}

/** Search code across repositories. */
export interface SearchGitHubCodeParams {
    /**
     * Array of repository full names (owner/repo format) to search in.
     */
    repositoryNames: string[]
    /**
     * The search query. Use natural language or code-specific terms. Examples: "authentication middleware", "class UserRepository", "handleSubmit form validation"
     */
    query: string
    /**
     * Filter by programming language (e.g., "typescript", "javascript"). Use null to search all languages.
     */
    language?: string | null
    /**
     * Filter by filename pattern (e.g., "*.test.ts" for test files, "*.config.*" for config files). Use null to search all files.
     */
    filename?: string | null
    /**
     * Filter by path (e.g., "src/components" to only search in that directory). Use null to search everywhere.
     */
    path?: string | null
    /**
     * Number of results to return (default: 10, max: 100)
     */
    perPage: number
    /**
     * Page number for pagination (default: 1). Use this to fetch additional results if there are more than perPage results. Use null for page 1. Must be a positive integer >= 1.
     */
    page: number | null
}

export interface SearchGitHubCodeResult {
    success: boolean
    actions?: RunHistoryAction[]
    totalCount: number
    resultsReturned: number
    query: string
    repositories: string[]
    pagination: {
        page: number
        perPage: number
        hasMore: boolean
    }
    results: {
        index: number
        repository: string
        path: string
        url: string
        snippets: string
    }[]
    message: string
    tip: string
}

// ── gmail tool types ──────────────────────────────────────────

/** Send an email through Gmail. */
export interface GmailSendEmailParams {
    /**
     * Recipient email address(es). Multiple addresses can be comma-separated.
     */
    to: string
    /**
     * Email subject line
     */
    subject: string
    /**
     * Plain text email body content. Do not include image URLs here — images cannot be embedded in plain text.
     */
    body?: string | null
    /**
     * HTML email body content. If provided with body, sends multipart/alternative. NEVER use <img src="https://..."> with remote URLs — they will expire. Images must be passed via image_urls and referenced as <img src="cid:image-1.png">.
     */
    html_body?: string | null
    /**
     * Gmail Thread ID (numeric string from the email event, NOT the Message-ID header). Omit for new emails.
     */
    thread_id?: string | null
    /**
     * CC recipient email address(es). Multiple addresses can be comma-separated.
     */
    cc?: string | null
    /**
     * BCC recipient email address(es). Multiple addresses can be comma-separated.
     */
    bcc?: string | null
    /**
     * URLs of images to embed in the email. Must be signed URLs from our internal GCS image bucket. Each image is downloaded and base64-encoded as an inline MIME attachment with a Content-ID. Images are assigned sequential filenames: image-1.png, image-2.png, etc. (extension reflects actual MIME type). You MUST reference each one in html_body as <img src="cid:image-1.png">, <img src="cid:image-2.png">, etc. Do NOT put the raw URLs in html_body.
     */
    image_urls?: string[] | null
    /**
     * Custom email headers as key-value pairs. Useful for adding headers like List-Unsubscribe, List-Unsubscribe-Post, X-Priority, etc. Example: {"List-Unsubscribe": "<mailto:unsubscribe@example.com>", "List-Unsubscribe-Post": "List-Unsubscribe=One-Click"}
     */
    custom_headers?:
        | {
              key: string
              value: string
          }[]
        | null
}

export interface GmailSendEmailResult {
    success: true
    actions?: RunHistoryAction[]
    message_id: string
    thread_id: string
    to: string
    subject: string
    summary: string
    is_reply: boolean
}

