const __githubRepoNameToFullName = new Map<string, string>([
    ["docs", "terse-inc/docs"],
    ["terse", "terse-inc/terse"],
])

function __normalizeGitHubRepos(repo: unknown): string {
    if (repo && typeof repo === "object" && "fullName" in (repo as Record<string, unknown>)) {
        const fullName = (repo as { fullName?: unknown }).fullName
        if (typeof fullName === "string" && fullName.length > 0) return fullName
    }
    if (typeof repo === "string") {
        if (repo.includes("/")) return repo
        return __githubRepoNameToFullName.get(repo) ?? repo
    }
    return String(repo ?? "")
}

function __normalizeGitHubReposNames(repositories: unknown): string[] {
    if (!Array.isArray(repositories)) return []
    return repositories.map(repo => __normalizeGitHubRepos(repo))
}

export type GeneratedTools = {
    attio: {
        /** List Attio objects. */
        listObjects(params?: AttioListObjectsParams): Promise<ToolOutputByName["attio_list_objects"]>
        /** Query Attio records. */
        queryRecords<TObject extends GeneratedAttioObject>(params: AttioQueryRecordsParams<TObject>): Promise<AttioQueryRecordsResult<TObject>>
        /** Upsert an Attio record. */
        upsertRecord<TObject extends GeneratedAttioObject>(params: AttioUpsertRecordParams<TObject>): Promise<AttioUpsertRecordResult<TObject>>
    }
    datadog: {
        /** Search Datadog logs. */
        searchDatadogLogs(params: SearchDatadogLogsParams): Promise<SearchDatadogLogsResult>
    }
    github: {
        /** Read a file from a GitHub repository. */
        readGitHubFile(params: ReadGitHubFileParams): Promise<ReadGitHubFileResult>
        /** Search code across repositories. */
        searchGitHubCode(params: SearchGitHubCodeParams): Promise<SearchGitHubCodeResult>
    }
    gmail: {
        /** Send an email through Gmail. */
        sendEmail(params: GmailSendEmailParams): Promise<GmailSendEmailResult>
    }
    launchdarkly: {
        /** List feature flags. */
        listLaunchDarklyFlags(params: ListLaunchDarklyFlagsParams): Promise<ListLaunchDarklyFlagsResult>
    }
    linear: {
        /** Create a Linear issue. */
        createTicket(params: LinearCreateTicketParams): Promise<LinearCreateTicketResult>
        /** Read a Linear issue with comments. */
        readTicket(params: LinearReadTicketParams): Promise<LinearReadTicketResult>
    }
    notion: {
        /** Query a Notion database. */
        queryDatabase(params: NotionQueryDatabaseParams): Promise<NotionQueryDatabaseResult>
    }
    posthog: {
        /** Search PostHog events. */
        searchPostHogEvents(params: SearchPosthogEventsParams): Promise<SearchPosthogEventsResult>
    }
    slack: {
        /** Send a message to a Slack channel or user. */
        sendMessage(params: SlackSendMessageParams): Promise<SlackSendMessageResult>
        /** Read recent messages from a Slack conversation. */
        readConversation(params: SlackReadConversationParams): Promise<SlackReadConversationResult>
    }
    snowflake: {
        /** Run a read-only Snowflake query. */
        executeQuery(params: SnowflakeExecuteQueryParams): Promise<SnowflakeExecuteQueryResult>
    }
    terse: {
        /** Search the web for up-to-date information. */
        webSearch(params: WebSearchParams): Promise<WebSearchResult>
        /** Read and write persistent memory files. */
        memory(params: MemoryParams): Promise<MemoryResult>
    }
    workos: {
        /** List users in WorkOS. */
        listWorkOSUsers(params: ListWorkOSUsersParams): Promise<ListWorkOSUsersResult>
    }
}

declare module "terse-sdk" {
    interface TerseAgent {
        readonly tools: GeneratedTools
    }
}

function createTools(agent: TerseAgent): GeneratedTools {
    const allowed: Set<string> = new Set(agent.skills.map(config => config.integrationType))
    return {
        ...(allowed.has("attio") ? { attio: {
            listObjects: (params: AttioListObjectsParams = {}) =>
                TerseAgent.executeTool<ToolOutputByName["attio_list_objects"]>("attio_list_objects", { ...params, integrationId: "attio-int-1" }),
            queryRecords: <TObject extends GeneratedAttioObject>(params: AttioQueryRecordsParams<TObject>) =>
                TerseAgent.executeTool<ToolOutputByName["attio_query_records"]>("attio_query_records", { objectSlug: __normalizeAttioObjectSlug(params.object), filter: __serializeAttioFilter(params.filter), limit: params.limit ?? null, integrationId: "attio-int-1" }).then(result => __enhanceAttioQueryResult(params.object, result)),
            upsertRecord: <TObject extends GeneratedAttioObject>(params: AttioUpsertRecordParams<TObject>) =>
