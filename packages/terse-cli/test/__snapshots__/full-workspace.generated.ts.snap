}

export type CronTrigger = SDKTrigger<CronTriggerPayload>

export interface WebMonitorTriggerPayload<TPayload = unknown> {
    integrationType: "webmonitor"
    eventType: "webmonitor"
    inputId: string
    query: string
    frequency: {
        number: number
        unit: "hour" | "day" | "week"
    }
    monitorId: string
    eventGroupId: string
    metadata: {
        [k: string]: string
    }
    outputType: "text" | "json"
    rawPayload?: string
    payload: TPayload
    eventDate: string
    sourceUrls: string[]
}

export type WebMonitorTrigger<TPayload = unknown> = SDKTrigger<WebMonitorTriggerPayload<TPayload>>

// ── Triggers ──────────────────────────────────────────────────

/**
 * Triggers available in your workspace.
 *
 * Type `Triggers.` in your editor to see every connected integration with triggers.
 * Use these in `createJob({ triggers: [...] })`.
 */
export const Triggers = {
    slack: {
        /** Trigger on any message in a channel */
        onMessage(opts: { channel: SlackChannel; userIds?: string[] }): TypedTrigger<SlackMessageTrigger> {
            return new SlackConfig("slack-int-1", opts.channel.channelId, opts.channel.name, false, opts.userIds ?? [], [SlackEventType.MESSAGE])
        },
        /** Trigger on direct messages to the bot */
        onDm(opts?: { userIds?: string[] }): TypedTrigger<SlackMessageTrigger> {
            return new SlackConfig("slack-int-1", undefined, undefined, true, opts?.userIds ?? [], [SlackEventType.MESSAGE])
        },
        /** Trigger when the Slack app is directly mentioned */
        onAppMention(opts: { channel: SlackChannel; userIds?: string[] }): TypedTrigger<SlackAppMentionTrigger> {
            return new SlackConfig("slack-int-1", opts.channel.channelId, opts.channel.name, false, opts.userIds ?? [], [SlackEventType.APP_MENTION])
        },
        /** Trigger when a reaction is added to a message in a channel */
        onReactionAdded(opts: { channel: SlackChannel; userIds?: string[] }): TypedTrigger<SlackReactionAddedTrigger> {
            return new SlackConfig("slack-int-1", opts.channel.channelId, opts.channel.name, false, opts.userIds ?? [], [SlackEventType.REACTION_ADDED])
        },
        /** Trigger on all Slack events (messages + DMs) for a channel */
        trigger(opts?: { channel?: SlackChannel; listenToUserDms?: boolean; userIds?: string[]; eventTypes?: SlackEventType[] }): TypedTrigger<SlackTrigger> {
            return new SlackConfig("slack-int-1", opts?.channel?.channelId, opts?.channel?.name, opts?.listenToUserDms, opts?.userIds ?? [], opts?.eventTypes)
        },
    },
    github: {
        /** Trigger on push to a repository */
        onPush(opts: { repo: Repos }): TypedTrigger<GithubPushTrigger> {
            return new GitHubConfig("github-int-1", [opts.repo.repositoryId], [GitHubEventType.PUSH])
        },
        /** Trigger when a pull request is opened */
        onPROpened(opts: { repo: Repos }): TypedTrigger<GithubPROpenedTrigger> {
            return new GitHubConfig("github-int-1", [opts.repo.repositoryId], [GitHubEventType.PR_OPENED])
        },
        /** Trigger when a pull request is merged */
        onPRMerged(opts: { repo: Repos }): TypedTrigger<GithubPRMergedTrigger> {
            return new GitHubConfig("github-int-1", [opts.repo.repositoryId], [GitHubEventType.PR_MERGED])
        },
        /** Trigger when a pull request is closed */
        onPRClosed(opts: { repo: Repos }): TypedTrigger<GithubPRClosedTrigger> {
            return new GitHubConfig("github-int-1", [opts.repo.repositoryId], [GitHubEventType.PR_CLOSED])
        },
        /** Trigger when a pull request is synchronized */
        onPRSynchronized(opts: { repo: Repos }): TypedTrigger<GithubPRSynchronizedTrigger> {
            return new GitHubConfig("github-int-1", [opts.repo.repositoryId], [GitHubEventType.PR_SYNCHRONIZE])
        },
        /** Trigger on any pull request event */
        onPR(opts: { repo: Repos }): TypedTrigger<GithubPRTrigger> {
            return new GitHubConfig("github-int-1", [opts.repo.repositoryId], [GitHubEventType.PR_OPENED, GitHubEventType.PR_MERGED, GitHubEventType.PR_CLOSED, GitHubEventType.PR_SYNCHRONIZE])
        },
        /** Trigger when a comment is created on an issue or pull request */
        onIssueComment(opts: { repo: Repos }): TypedTrigger<GithubIssueCommentCreatedTrigger> {
            return new GitHubConfig("github-int-1", [opts.repo.repositoryId], [GitHubEventType.ISSUE_COMMENT_CREATED])
        },
        /** Trigger on specific GitHub events for the given repositories */
        trigger(opts: { repos: Repos[]; eventTypes?: GitHubEventType[] }): TypedTrigger<GithubTrigger> {
            return new GitHubConfig("github-int-1", opts.repos.map(r => r.repositoryId), opts.eventTypes)
        },
    },
    linear: {
        /** Trigger when a new issue is created. Optionally scope with `LinearTeam.*` / `LinearProject.*`. */
        onIssueCreated(opts?: { team?: LinearTeam; project?: LinearProject }): TypedTrigger<LinearIssueCreatedTrigger> {
            return new LinearInputConfig("linear-int-1", opts?.project?.projectId ?? null, [LinearEventType.ISSUE_CREATED], opts?.team?.teamId ?? null)
        },
        /** Trigger when an issue is updated */
        onIssueUpdated(opts?: { team?: LinearTeam; project?: LinearProject }): TypedTrigger<LinearIssueUpdatedTrigger> {
            return new LinearInputConfig("linear-int-1", opts?.project?.projectId ?? null, [LinearEventType.ISSUE_UPDATED], opts?.team?.teamId ?? null)
        },
        /** Trigger when a comment is added to an issue */
        onComment(opts?: { team?: LinearTeam; project?: LinearProject }): TypedTrigger<LinearCommentCreatedTrigger> {
            return new LinearInputConfig("linear-int-1", opts?.project?.projectId ?? null, [LinearEventType.COMMENT_CREATED], opts?.team?.teamId ?? null)
        },
        /** Trigger on all Linear events */
        trigger(opts?: { team?: LinearTeam; project?: LinearProject; eventTypes?: LinearEventType[] }): TypedTrigger<LinearTrigger> {
            return new LinearInputConfig("linear-int-1", opts?.project?.projectId ?? null, opts?.eventTypes, opts?.team?.teamId ?? null)
        },
    },
    gmail: {
        /** Trigger when a new email is received */
        onEmail(): TypedTrigger<GmailTrigger> {
            return new GmailConfig("gmail-int-1", [GmailEventType.EMAIL_RECEIVED])
        },
        /** Trigger on all Gmail events */
        trigger(opts?: { eventTypes?: GmailEventType[] }): TypedTrigger<GmailTrigger> {
            return new GmailConfig("gmail-int-1", opts?.eventTypes)
        },
    },
    heyReach: {
        /** Trigger when a connection request is sent */
        onConnectionRequestSent(opts?: { campaigns?: HeyReachCampaign[] }): TypedTrigger<HeyReachConnectionRequestSentTrigger> {
            return new HeyReachInputConfig("heyreach-int-1", HeyReachEventType.CONNECTION_REQUEST_SENT, (opts?.campaigns ?? []).map(c => c.campaignId))
        },
        /** Trigger when a connection request is accepted */
        onConnectionRequestAccepted(opts?: { campaigns?: HeyReachCampaign[] }): TypedTrigger<HeyReachConnectionRequestAcceptedTrigger> {
            return new HeyReachInputConfig("heyreach-int-1", HeyReachEventType.CONNECTION_REQUEST_ACCEPTED, (opts?.campaigns ?? []).map(c => c.campaignId))
        },
        /** Trigger when a LinkedIn message is sent */
        onMessageSent(opts?: { campaigns?: HeyReachCampaign[] }): TypedTrigger<HeyReachMessageSentTrigger> {
            return new HeyReachInputConfig("heyreach-int-1", HeyReachEventType.MESSAGE_SENT, (opts?.campaigns ?? []).map(c => c.campaignId))
        },
        /** Trigger on the first reply to a LinkedIn message */
        onMessageReplyReceived(opts?: { campaigns?: HeyReachCampaign[] }): TypedTrigger<HeyReachMessageReplyReceivedTrigger> {
            return new HeyReachInputConfig("heyreach-int-1", HeyReachEventType.MESSAGE_REPLY_RECEIVED, (opts?.campaigns ?? []).map(c => c.campaignId))
        },
        /** Trigger when an InMail is sent */
        onInmailSent(opts?: { campaigns?: HeyReachCampaign[] }): TypedTrigger<HeyReachInmailSentTrigger> {
            return new HeyReachInputConfig("heyreach-int-1", HeyReachEventType.INMAIL_SENT, (opts?.campaigns ?? []).map(c => c.campaignId))
        },
        /** Trigger on the first reply to an InMail */
        onInmailReplyReceived(opts?: { campaigns?: HeyReachCampaign[] }): TypedTrigger<HeyReachInmailReplyReceivedTrigger> {
            return new HeyReachInputConfig("heyreach-int-1", HeyReachEventType.INMAIL_REPLY_RECEIVED, (opts?.campaigns ?? []).map(c => c.campaignId))
        },
        /** Trigger when a follow is sent */
        onFollowSent(opts?: { campaigns?: HeyReachCampaign[] }): TypedTrigger<HeyReachFollowSentTrigger> {
            return new HeyReachInputConfig("heyreach-int-1", HeyReachEventType.FOLLOW_SENT, (opts?.campaigns ?? []).map(c => c.campaignId))
        },
        /** Trigger when a post is liked */
        onLikedPost(opts?: { campaigns?: HeyReachCampaign[] }): TypedTrigger<HeyReachLikedPostTrigger> {
            return new HeyReachInputConfig("heyreach-int-1", HeyReachEventType.LIKED_POST, (opts?.campaigns ?? []).map(c => c.campaignId))
        },
        /** Trigger when a profile is viewed */
        onViewedProfile(opts?: { campaigns?: HeyReachCampaign[] }): TypedTrigger<HeyReachViewedProfileTrigger> {
            return new HeyReachInputConfig("heyreach-int-1", HeyReachEventType.VIEWED_PROFILE, (opts?.campaigns ?? []).map(c => c.campaignId))
        },
        /** Trigger when a campaign completes */
        onCampaignCompleted(opts?: { campaigns?: HeyReachCampaign[] }): TypedTrigger<HeyReachCampaignCompletedTrigger> {
            return new HeyReachInputConfig("heyreach-int-1", HeyReachEventType.CAMPAIGN_COMPLETED, (opts?.campaigns ?? []).map(c => c.campaignId))
        },
        /** Trigger when lead tags are updated */
        onLeadTagUpdated(opts?: { campaigns?: HeyReachCampaign[] }): TypedTrigger<HeyReachLeadTagUpdatedTrigger> {
            return new HeyReachInputConfig("heyreach-int-1", HeyReachEventType.LEAD_TAG_UPDATED, (opts?.campaigns ?? []).map(c => c.campaignId))
        },
        /** Trigger on specific HeyReach event types */
        trigger(opts: { campaigns?: HeyReachCampaign[]; eventType: HeyReachEventType }): TypedTrigger<HeyReachTrigger> {
            return new HeyReachInputConfig("heyreach-int-1", opts.eventType, (opts.campaigns ?? []).map(c => c.campaignId))
        },
    },
    attio: {
        /** Trigger when a call recording is created */
        onCallRecordingCreated(): TypedTrigger<AttioCallRecordingCreatedTrigger> {
            return new AttioInputConfig("attio-int-1", [{ eventType: AttioEventType.CALL_RECORDING_CREATED }])
        },
        /** Trigger when a comment is created */
        onCommentCreated(): TypedTrigger<AttioCommentCreatedTrigger> {
            return new AttioInputConfig("attio-int-1", [{ eventType: AttioEventType.COMMENT_CREATED }])
        },
        /** Trigger when a comment is resolved */
        onCommentResolved(): TypedTrigger<AttioCommentResolvedTrigger> {
            return new AttioInputConfig("attio-int-1", [{ eventType: AttioEventType.COMMENT_RESOLVED }])
        },
        /** Trigger when a comment is unresolved */
        onCommentUnresolved(): TypedTrigger<AttioCommentUnresolvedTrigger> {
            return new AttioInputConfig("attio-int-1", [{ eventType: AttioEventType.COMMENT_UNRESOLVED }])
        },
        /** Trigger when a comment is deleted */
        onCommentDeleted(): TypedTrigger<AttioCommentDeletedTrigger> {
            return new AttioInputConfig("attio-int-1", [{ eventType: AttioEventType.COMMENT_DELETED }])
        },
        /** Trigger when a list is created */
