        onWorkspaceMemberCreated(): TypedTrigger<AttioWorkspaceMemberCreatedTrigger> {
            return new AttioInputConfig("attio-int-1", [{ eventType: AttioEventType.WORKSPACE_MEMBER_CREATED }])
        },
        /** Trigger on one or more Attio event types. Pass `object` to scope record events to a specific Attio object. */
        trigger(opts: { eventTypes: AttioEventType[]; object?: GeneratedAttioObject }): TypedTrigger<AttioTrigger> {
            const filter = attioParentObjectFilter(opts.object)
            return new AttioInputConfig("attio-int-1", opts.eventTypes.map(eventType => ({ eventType, filter })))
        },
    },
    workOS: {
        /** Trigger on user creation */
        onUserCreated(): TypedTrigger<WorkOSUserCreatedTrigger> {
            return new WorkOSInputConfig("workos-int-1", [WorkOSEventType.USER_CREATED])
        },
        /** Trigger on user update */
        onUserUpdated(): TypedTrigger<WorkOSUserUpdatedTrigger> {
