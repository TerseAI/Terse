/** Search the web for up-to-date information. */
export interface WebSearchParams {
    /**
     * The search query
     */
    query: string
    /**
     * Number of results to return (default 5)
     */
    max_results: number | null
    /**
     * 'basic' is faster, 'advanced' is more thorough (default 'basic')
     */
    search_depth: ("basic" | "advanced") | null
    /**
     * Include an LLM-generated answer summarizing the results (default false)
     */
    include_answer: boolean | null
    /**
     * 'news' for recent news articles, 'general' for all web content (default 'general')
     */
    topic: ("general" | "news") | null
    /**
     * Filter results by recency
     */
    time_range: ("day" | "week" | "month" | "year") | null
    /**
     * Restrict results to these domains (e.g. ['example.com']). Required when web access is limited to an allowed list of domains.
     */
    include_domains: string[] | null
}

export interface WebSearchResult {
    query: string
    answer?: string
    results: {
        title: string
        url: string
        content: string
        score: number
    }[]
}

/** Read and write persistent memory files. */
export interface MemoryParams {
    /**
     * The memory operation to perform and its arguments
     */
    command:
        | {
              op: "view"
              /**
               * Path under /memories to view; omit to list the memory root
               */
              path?: string | null
              /**
               * Optional [startLine, endLine] (1-indexed) to view a slice of a file
               */
              view_range?: number[] | null
          }
        | {
              op: "create"
              /**
               * Path under /memories to create (e.g. '/memories/notes.md')
               */
              path: string
              /**
               * Full file contents; defaults to empty
               */
              file_text?: string | null
          }
        | {
              op: "str_replace"
              /**
               * Path under /memories to edit
               */
              path: string
              /**
               * Exact text to replace (must appear verbatim exactly once)
               */
              old_str: string
              /**
               * Replacement text; omit to delete the matched text
               */
              new_str?: string | null
          }
        | {
              op: "insert"
              /**
               * Path under /memories to edit
               */
              path: string
              /**
               * Line number after which to insert (0 = beginning of file)
               */
              insert_line: number
              /**
               * Text to insert; defaults to empty
               */
              insert_text?: string | null
          }
        | {
              op: "delete"
              /**
               * Path under /memories to delete
               */
              path: string
          }
        | {
              op: "rename"
              /**
               * Source path under /memories
               */
              old_path: string
              /**
               * Destination path under /memories
               */
              new_path: string
          }
}

export interface MemoryResult {
    success: boolean
    actions?: RunHistoryAction[]
    result: string
}

