// Re-run `terse generate` to update.

// ═══ Contents ═══════════════════════════════════════════════
// Trigger Payloads - event shapes handlers receive, grep the event name
// Triggers - factories for createJob({ triggers: [...] })
// Skills - factories for agent skills: [...]
// Tools - <ToolName>Params / <ToolName>Result types, agent.tools and toolbox methods
// ════════════════════════════════════════════════════════════

// The integrations currently available in Terse: slack, github, linear, gmail, notion, posthog, datadog, launchdarkly, workos, attio, snowflake, hey_reach, webhook.
// Connect one with `terse integrate connect <type>`; list its tools with `terse integrate tool <type> --json`.

import {
    FrequencyUnit,
    ImageEditConfig,
    InferStructuredOutput,
    MemoryConfig,
    SDKTrigger,
    TerseAgent,
    TimeTriggerConfig,
    TypedSkill,
    TypedTrigger,
    WebConfig,
    WebMonitorConfig,
    WebhookInputConfig,
} from "terse-sdk"

// ── Trigger Payloads ──────────────────────────────────────────

/**
 * Fully resolved event shapes your trigger handlers receive.
 *
 * Each `<Name>Payload` interface lists every field on the event; the matching
 * `<Name>` alias wraps it in `SDKTrigger`, which only adds `formatForAgentRunner()`
 * and `debugLog()`. Annotate handler params with the `<Name>` types below.
 */
// ── Schedule / webhook / web monitor trigger payloads ─────────

export interface WebhookTriggerPayload<TBody = unknown> {
    integrationType: "webhook"
    eventType: "webhook"
    body: TBody
    headers: {
        [k: string]: string
    }
    method: string
}

export type WebhookTrigger<TBody = unknown> = SDKTrigger<WebhookTriggerPayload<TBody>>

export interface CronTriggerPayload {
    integrationType: "cron_job"
    eventType: "cron"
    inputId: string
    isManualTrigger?: boolean
    manualContext?: string
}

export type CronTrigger = SDKTrigger<CronTriggerPayload>

export interface WebMonitorTriggerPayload<TPayload = unknown> {
    integrationType: "webmonitor"
    eventType: "webmonitor"
    inputId: string
    query: string
    frequency: {
        number: number
        unit: "hour" | "day" | "week"
    }
    monitorId: string
    eventGroupId: string
    metadata: {
        [k: string]: string
    }
    outputType: "text" | "json"
    rawPayload?: string
    payload: TPayload
    eventDate: string
    sourceUrls: string[]
}

export type WebMonitorTrigger<TPayload = unknown> = SDKTrigger<WebMonitorTriggerPayload<TPayload>>

// ── Triggers ──────────────────────────────────────────────────

/**
 * Triggers available in your workspace.
 *
 * Type `Triggers.` in your editor to see every connected integration with triggers.
 * Use these in `createJob({ triggers: [...] })`.
 */
export const Triggers = {
    schedule: {
        /** Run on a cron schedule */
        cron(opts: { expression: string }): TypedTrigger<CronTrigger> {
            return new TimeTriggerConfig(opts.expression)
        },
    },
    webhook: {
        /** Trigger via an external HTTP request to a generated URL */
        onRequest<TBody = unknown>(): TypedTrigger<WebhookTrigger<TBody>> {
            return new WebhookInputConfig()
        },
    },
    webMonitor: {
        /** Trigger when a query against the live web matches the given schema */
        onEvent<const TSchema>(opts: {
            query: string
            frequency: { number: number; unit: FrequencyUnit }
            outputSchema?: TSchema
        }): TypedTrigger<WebMonitorTrigger<InferStructuredOutput<TSchema>>> {
            return new WebMonitorConfig(opts.query, opts.frequency, opts.outputSchema)
        },
    },
}
// ── Skills ────────────────────────────────────────────────────

/**
 * Skills available in your workspace.
 *
 * Type `Skills.` in your editor to see every connected integration's skill at a glance.
 * Use these in `generateText({ skills: [...] })` (or `TerseAgent.create({ skills: [...] })`).
 */
export const Skills = {
    /** Web — built-in web search, page extraction, and multi-source research. Pass `allowedDomains` to restrict search and page extraction to specific sites (and their subdomains). */
    web(opts: { allowedDomains?: string[] } = {}): TypedSkill<"web_search" | "web_extract" | "web_research"> {
        return new WebConfig(opts)
    },
    /** ImageEdit — edit and generate images */
    imageEdit(): TypedSkill<"image_edit"> {
        return new ImageEditConfig()
    },
    /** Memory — built-in persistent memory the agent reads and writes under /memories, scoped to this job and surviving across runs. */
    memory(): TypedSkill<"memory"> {
        return new MemoryConfig()
    },
}
// ── Typed Tools ───────────────────────────────────────────────

/** Audit-log entry describing an action a tool performed; included on tool results as `actions`. */
export interface RunHistoryAction {
    action: string
    integration:
        | "github"
        | "hey_reach"
        | "gmail"
        | "linear"
        | "slack"
        | "notion"
        | "terse"
        | "posthog"
        | "datadog"
        | "cron_job"
        | "launchdarkly"
        | "workos"
        | "attio"
        | "snowflake"
        | "webhook"
        | "webmonitor"
    target: string
    details: string
    url?: string
    step_id?: string
    type: "create" | "update" | "delete" | "read" | "approve" | "error"
    isReadOnly?: boolean
    output_items?: {
        output_item_id: string
        output_item_type:
            | "gmail"
            | "gmail_output"
            | "gmail_draft_output"
            | "slack"
            | "slack_output"
            | "notion"
            | "linear_input"
            | "linear_output"
            | "github"
            | "POSTHOG"
            | "DATADOG"
            | "time_trigger"
            | "launchdarkly"
            | "web"
            | "image_edit"
            | "memory"
            | "workos_input"
            | "workos_output"
            | "attio_input"
            | "attio_output"
            | "snowflake_output"
            | "webhook_input"
            | "webmonitor"
            | "hey_reach_input"
    }[]
}

// ── terse tool types ──────────────────────────────────────────

/** Search the web for up-to-date information. */
export interface WebSearchParams {
    /**
     * The search query
     */
    query: string
    /**
     * Number of results to return (default 5)
     */
    max_results: number | null
    /**
     * 'basic' is faster, 'advanced' is more thorough (default 'basic')
     */
    search_depth: ("basic" | "advanced") | null
    /**
     * Include an LLM-generated answer summarizing the results (default false)
     */
    include_answer: boolean | null
    /**
     * 'news' for recent news articles, 'general' for all web content (default 'general')
     */
    topic: ("general" | "news") | null
    /**
     * Filter results by recency
     */
    time_range: ("day" | "week" | "month" | "year") | null
    /**
     * Restrict results to these domains (e.g. ['example.com']). Required when web access is limited to an allowed list of domains.
     */
    include_domains: string[] | null
}

export interface WebSearchResult {
    query: string
    answer?: string
    results: {
        title: string
        url: string
        content: string
        score: number
    }[]
}

/** Extract the readable content of a web page. */
export interface WebExtractParams {
    /**
     * URL or list of URLs to extract content from
     */
    urls: string | string[]
    /**
     * 'advanced' handles JavaScript-heavy pages but is slower
     */
    extract_depth: ("basic" | "advanced") | null
}

export interface WebExtractResult {
    results: {
        url: string
        raw_content: string
    }[]
    failed_results: unknown
}

/** Research a topic across multiple sources. */
export interface WebResearchParams {
    /**
     * The research question or topic to investigate
     */
    input: string
    /**
     * 'mini' for quick focused research, 'pro' for comprehensive multi-angle research, 'auto' picks automatically
     */
    model: ("mini" | "pro" | "auto") | null
}

export interface WebResearchResult {
    success: boolean
    actions?: RunHistoryAction[]
    status: "completed"
    request_id: string
    content?: string
    sources?: {
        title: string
        url: string
    }[]
}

/** Edit or generate an image. */
export interface ImageEditParams {
    /**
     * URL of the image to edit. Must be a signed URL from our internal GCS image bucket.
     */
    image_url: string
    /**
     * Natural language instruction describing how to edit the image.
     */
    prompt: string
}

export interface ImageEditResult {
    success: boolean
    actions?: RunHistoryAction[]
    url: string
    image_url: string
    summary: string
    snippets: {
        type: "image"
        url: string
    }[]
}

/** Read and write persistent memory files. */
export interface MemoryParams {
    /**
     * The memory operation to perform and its arguments
     */
    command:
        | {
              op: "view"
              /**
               * Path under /memories to view; omit to list the memory root
               */
              path?: string | null
              /**
               * Optional [startLine, endLine] (1-indexed) to view a slice of a file
               */
              view_range?: number[] | null
          }
        | {
              op: "create"
              /**
               * Path under /memories to create (e.g. '/memories/notes.md')
               */
              path: string
              /**
               * Full file contents; defaults to empty
               */
              file_text?: string | null
          }
        | {
              op: "str_replace"
              /**
               * Path under /memories to edit
               */
              path: string
              /**
               * Exact text to replace (must appear verbatim exactly once)
               */
              old_str: string
              /**
               * Replacement text; omit to delete the matched text
               */
              new_str?: string | null
          }
        | {
              op: "insert"
              /**
               * Path under /memories to edit
               */
              path: string
              /**
               * Line number after which to insert (0 = beginning of file)
               */
              insert_line: number
              /**
               * Text to insert; defaults to empty
               */
              insert_text?: string | null
          }
        | {
              op: "delete"
              /**
               * Path under /memories to delete
               */
              path: string
          }
        | {
              op: "rename"
              /**
               * Source path under /memories
               */
              old_path: string
              /**
               * Destination path under /memories
               */
              new_path: string
          }
}

export interface MemoryResult {
    success: boolean
    actions?: RunHistoryAction[]
    result: string
}

export type GeneratedTools = {
    terse: {
        /** Search the web for up-to-date information. */
        webSearch(params: WebSearchParams): Promise<WebSearchResult>
        /** Extract the readable content of a web page. */
        webExtract(params: WebExtractParams): Promise<WebExtractResult>
        /** Research a topic across multiple sources. */
        webResearch(params: WebResearchParams): Promise<WebResearchResult>
        /** Edit or generate an image. */
        imageEdit(params: ImageEditParams): Promise<ImageEditResult>
        /** Read and write persistent memory files. */
        memory(params: MemoryParams): Promise<MemoryResult>
    }
}

declare module "terse-sdk" {
    interface TerseAgent {
        readonly tools: GeneratedTools
    }
}

function createTools(agent: TerseAgent): GeneratedTools {
    const allowed: Set<string> = new Set(agent.skills.map(config => config.integrationType))
    return {
        ...(allowed.has("terse") ? { terse: {
            webSearch: (params: WebSearchParams) =>
                TerseAgent.executeTool<WebSearchResult>("web_search", { ...params }),
            webExtract: (params: WebExtractParams) =>
                TerseAgent.executeTool<WebExtractResult>("web_extract", { ...params }),
            webResearch: (params: WebResearchParams) =>
                TerseAgent.executeTool<WebResearchResult>("web_research", { ...params }),
            imageEdit: (params: ImageEditParams) =>
                TerseAgent.executeTool<ImageEditResult>("image_edit", { ...params }),
            memory: (params: MemoryParams) =>
                TerseAgent.executeTool<MemoryResult>("memory", { ...params }),
        } } : {}),
    } as GeneratedTools
}

;(globalThis as any).__terse_createTools = createTools

/**
 * Deterministic tool calls without an agent.
 *
 * `toolbox` exposes every connected integration tool as a typed function. Unlike
 * `agent.tools`, it does not require constructing a `TerseAgent` and is not
 * filtered by `skills`. Use it when you know exactly which tool to call and
 * don't need an LLM in the loop.
 *
 * @example
 * ```ts
 * import { toolbox } from "./terse.generated"
 * await toolbox.slack.sendMessage({ channelId: "...", message: "hi" })
 * ```
 */
export const toolbox: GeneratedTools = {
    terse: {
        webSearch: (params: WebSearchParams) =>
            TerseAgent.executeTool<WebSearchResult>("web_search", { ...params }),
        webExtract: (params: WebExtractParams) =>
            TerseAgent.executeTool<WebExtractResult>("web_extract", { ...params }),
        webResearch: (params: WebResearchParams) =>
            TerseAgent.executeTool<WebResearchResult>("web_research", { ...params }),
        imageEdit: (params: ImageEditParams) =>
            TerseAgent.executeTool<ImageEditResult>("image_edit", { ...params }),
        memory: (params: MemoryParams) =>
            TerseAgent.executeTool<MemoryResult>("memory", { ...params }),
    },
}
