{{sectionHeader "PostHog skill"}}

/** PostHog — query analytics for a specific project */
export function posthogSkill(opts: { project: PosthogProject }): TypedSkill<{{{section.skillToolType}}}> {
    return new PosthogConfig("{{escape section.id}}", opts.project.projectId, opts.project.name)
}
