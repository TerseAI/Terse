/**
 * Custom event names observed in your PostHog project over the last 180 days.
 * Built-in $-prefixed events (e.g. "$pageview") are always accepted alongside these.
 * Terse supports US PostHog Cloud (us.posthog.com) only; EU-hosted PostHog is not supported.
 */
export type PosthogEventName =
{{#each section.eventNames}}
    | "{{escape this}}"
{{/each}}

