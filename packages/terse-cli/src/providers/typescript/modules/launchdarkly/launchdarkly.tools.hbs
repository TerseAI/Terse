/** LaunchDarkly — read and toggle feature flags in a project + environments */
export function launchDarklySkill(opts: { project: LaunchDarklyProject; environmentKeys: string[] }): TypedSkill<{{{section.skillToolType}}}> {
    return new LaunchDarklyConfig("{{escape section.id}}", opts.project.projectKey, opts.environmentKeys)
}
