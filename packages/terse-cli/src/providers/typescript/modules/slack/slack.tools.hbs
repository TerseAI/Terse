{{sectionHeader "Slack skill"}}

/** Slack — send messages and manage threads in a specific channel */
export function slackSkill(opts: { channel: SlackChannel; userIds?: string[]; userNames?: string[]; listenToUserDms?: boolean }): TypedSkill<{{{section.skillToolType}}}> {
    return new SlackOutputConfig("{{escape section.id}}", opts.channel.channelId ?? null, opts.channel.name ?? null, opts.userIds ?? [], opts.userNames ?? null, opts.listenToUserDms)
}
