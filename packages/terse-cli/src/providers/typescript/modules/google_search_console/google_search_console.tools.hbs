/** Google Search Console — read Search Analytics and manage the given properties. A Domain property also covers its subdomains. */
export function googleSearchConsoleSkill(opts: { sites: GoogleSearchConsoleSite[] }): TypedSkill<{{{section.skillToolType}}}> {
    return new GoogleSearchConsoleOutputConfig("{{escape section.id}}", opts.sites.map(s => s.siteUrl))
}
