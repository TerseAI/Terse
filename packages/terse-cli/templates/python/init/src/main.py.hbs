from terse_sdk import Terse, TerseAgent
from terse_sdk.types.events import GithubPRTrigger

from terse_generated import GitHub, GitHubRepo, Slack, SlackChannel

app = Terse()

@app.job(
    name="{{projectName}}",
    triggers=[GitHub.on_pr(repo=GitHubRepo.Terse)],
    skills=[
        GitHub.skill(repos=[GitHubRepo.Terse]),
        Slack.skill(channel=SlackChannel.AllTerseInc),
    ],
)
def run_job(event: GithubPRTrigger, agent: TerseAgent, /) -> None:
    prompt = f"Summarise the PR and send a message to slack: {event.formatted_content}"
    agent.run_and_wait(prompt, event)
