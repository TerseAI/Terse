{{#if slack}}


# === Slack ===


class SlackChannel(BaseModel):
    model_config = ConfigDict(frozen=True)
    channel_id: str
    name: str
{{#if slack.channels.length}}
{{#each slack.channels}}
    {{staticName}}: ClassVar["SlackChannel"]
{{/each}}

{{#each slack.channels}}
SlackChannel.{{staticName}} = SlackChannel(channel_id={{{channelIdRepr}}}, name={{{nameRepr}}})
{{/each}}
{{/if}}


class Slack:
    @staticmethod
    def on_message(channel: SlackChannel, *, user_ids: Sequence[str] | None = None) -> TriggerConfig[SlackTriggerEvent]:
        return TriggerConfig(
            integration_id={{{slack.instanceIdRepr}}},
            integration_type='slack',
            event_type='message',
            config_type='slack',
            config=_compact_dict(
                channelId=channel.channel_id,
                channelName=channel.name,
                listenToUserDms=False,
                userIds=list(user_ids) if user_ids is not None else None,
                eventTypes=['message'],
            ),
        )

    @staticmethod
    def on_dm(*, user_ids: Sequence[str] | None = None) -> TriggerConfig[SlackTriggerEvent]:
        return TriggerConfig(
            integration_id={{{slack.instanceIdRepr}}},
            integration_type='slack',
            event_type='message',
            config_type='slack',
            config=_compact_dict(
                listenToUserDms=True,
                userIds=list(user_ids) if user_ids is not None else None,
                eventTypes=['message'],
            ),
        )

    @staticmethod
    def trigger(
        *,
        channel: SlackChannel | None = None,
        listen_to_user_dms: bool | None = None,
        user_ids: Sequence[str] | None = None,
        event_types: Sequence[SlackEventType] | None = None,
    ) -> TriggerConfig[SlackTriggerEvent]:
        return TriggerConfig(
            integration_id={{{slack.instanceIdRepr}}},
            integration_type='slack',
            config_type='slack',
            config=_compact_dict(
                channelId=channel.channel_id if channel is not None else None,
                channelName=channel.name if channel is not None else None,
                listenToUserDms=listen_to_user_dms,
                userIds=list(user_ids) if user_ids is not None else None,
                eventTypes=list(event_types) if event_types is not None else None,
            ),
        )

    @staticmethod
    def skill(
        *,
        channel: SlackChannel | None = None,
        user_ids: Sequence[str] | None = [],
        user_names: Sequence[str] | None = [],
        listen_to_user_dms: bool | None = False,
    ) -> SkillConfig[{{slack.skillToolType}}]:
        return SkillConfig(
            integration_id={{{slack.instanceIdRepr}}},
            integration_type='slack',
            config_type='slack_output',
            config=_compact_dict(
                channelId=channel.channel_id if channel is not None else None,
                channelName=channel.name if channel is not None else None,
                userIds=list(user_ids) if user_ids is not None else None,
                userNames=list(user_names) if user_names is not None else None,
                listenToUserDms=listen_to_user_dms,
            ),
        )
