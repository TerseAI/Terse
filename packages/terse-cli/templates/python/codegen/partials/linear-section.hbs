{{~#if linear}}


# === Linear ===


class LinearTeam(BaseModel):
    model_config = ConfigDict(frozen=True)
    team_id: str
    name: str
    key: str
{{#if linear.teams.length}}
{{#each linear.teams}}
    {{staticName}}: ClassVar["LinearTeam"]
{{/each}}
{{#each linear.teams}}

LinearTeam.{{staticName}} = LinearTeam(team_id={{{teamIdRepr}}}, name={{{nameRepr}}}, key={{{keyRepr}}})
{{/each}}
{{/if}}


class LinearProject(BaseModel):
    model_config = ConfigDict(frozen=True)
    project_id: str
    name: str
{{#if linear.projects.length}}
{{#each linear.projects}}
    {{staticName}}: ClassVar["LinearProject"]
{{/each}}
{{#each linear.projects}}

LinearProject.{{staticName}} = LinearProject(project_id={{{projectIdRepr}}}, name={{{nameRepr}}})
{{/each}}
{{/if}}


class Linear:
    @staticmethod
    def on_issue_created(
        *,
        team: LinearTeam | None = None,
        project: LinearProject | None = None,
    ) -> TriggerConfig[LinearIssueCreatedTrigger]:
        return TriggerConfig(
            integration_id={{{linear.instanceIdRepr}}},
            integration_type='linear',
            config_type='linear_input',
            config=_compact_dict(
                teamId=team.team_id if team is not None else None,
                projectId=project.project_id if project is not None else None,
                eventTypes=[LinearEventType.issue_created],
            ),
        )

    @staticmethod
    def on_issue_updated(
        *,
        team: LinearTeam | None = None,
        project: LinearProject | None = None,
    ) -> TriggerConfig[LinearIssueUpdatedTrigger]:
        return TriggerConfig(
            integration_id={{{linear.instanceIdRepr}}},
            integration_type='linear',
            config_type='linear_input',
            config=_compact_dict(
                teamId=team.team_id if team is not None else None,
                projectId=project.project_id if project is not None else None,
                eventTypes=[LinearEventType.issue_updated],
            ),
        )

    @staticmethod
    def on_comment(
        *,
        team: LinearTeam | None = None,
        project: LinearProject | None = None,
    ) -> TriggerConfig[LinearCommentCreatedTrigger]:
        return TriggerConfig(
            integration_id={{{linear.instanceIdRepr}}},
            integration_type='linear',
            config_type='linear_input',
            config=_compact_dict(
                teamId=team.team_id if team is not None else None,
                projectId=project.project_id if project is not None else None,
                eventTypes=[LinearEventType.comment_created],
            ),
        )

    @staticmethod
    def trigger(
        *,
        team: LinearTeam | None = None,
        project: LinearProject | None = None,
        event_types: Sequence[LinearEventType] | None = None,
    ) -> TriggerConfig[LinearTrigger]:
        return TriggerConfig(
            integration_id={{{linear.instanceIdRepr}}},
            integration_type='linear',
            config_type='linear_input',
            config=_compact_dict(
                teamId=team.team_id if team is not None else None,
                projectId=project.project_id if project is not None else None,
                eventTypes=list(event_types) if event_types is not None else None,
            ),
        )

    @staticmethod
    def skill(
        *,
        team: LinearTeam | None = None,
        project: LinearProject | None = None,
    ) -> SkillConfig[str]:
        return SkillConfig(
            integration_id={{{linear.instanceIdRepr}}},
            integration_type='linear',
            config_type='linear_output',
            config=_compact_dict(
                teamId=team.team_id if team is not None else None,
                teamName=team.name if team is not None else None,
                projectId=project.project_id if project is not None else None,
            ),
        )
