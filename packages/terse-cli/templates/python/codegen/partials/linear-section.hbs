# === Linear ===


class LinearTeam:
    def __init__(self, team_id: str, name: str, key: str) -> None:
        self.team_id = team_id
        self.name = name
        self.key = key


class LinearProject:
    def __init__(self, project_id: str, name: str) -> None:
        self.project_id = project_id
        self.name = name


