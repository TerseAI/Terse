{{~#if github}}


# === GitHub ===


class GitHubOwner(BaseModel):
    model_config = ConfigDict(frozen=True)
    name: str
{{#if github.owners.length}}
{{#each github.owners}}
    {{staticName}}: ClassVar["GitHubOwner"]
{{/each}}
{{#each github.owners}}

GitHubOwner.{{staticName}} = GitHubOwner(name={{{nameRepr}}})
{{/each}}
{{/if}}


class GitHubRepo(BaseModel):
    model_config = ConfigDict(frozen=True)
    repository_id: int
    name: str
    owner: GitHubOwner
    full_name: str
{{#each github.repoGroups}}
{{#each repos}}
    {{staticName}}: ClassVar["GitHubRepo"]
{{/each}}
{{/each}}
{{#each github.repoGroups}}
{{#each repos}}

GitHubRepo.{{staticName}} = GitHubRepo(
    repository_id={{{repositoryId}}},
    name={{{nameRepr}}},
    owner=GitHubOwner.{{ownerStaticName}},
    full_name={{{fullNameRepr}}},
)
{{/each}}
{{/each}}


class GitHub:
    @staticmethod
    def on_push(*, repo: GitHubRepo) -> TriggerConfig[GithubPushTrigger]:
        return TriggerConfig(
            integration_id={{{github.instanceIdRepr}}},
            integration_type='github',
            config_type='github',
            config=_compact_dict(
                repositoryIds=[repo.repository_id],
                eventTypes=[GitHubEventType.push],
            ),
        )

    @staticmethod
    def on_pr_opened(*, repo: GitHubRepo) -> TriggerConfig[GithubPROpenedTrigger]:
        return TriggerConfig(
            integration_id={{{github.instanceIdRepr}}},
            integration_type='github',
            config_type='github',
            config=_compact_dict(
                repositoryIds=[repo.repository_id],
                eventTypes=[GitHubEventType.pull_request_opened],
            ),
        )

    @staticmethod
    def on_pr_merged(*, repo: GitHubRepo) -> TriggerConfig[GithubPRMergedTrigger]:
        return TriggerConfig(
            integration_id={{{github.instanceIdRepr}}},
            integration_type='github',
            config_type='github',
            config=_compact_dict(
                repositoryIds=[repo.repository_id],
                eventTypes=[GitHubEventType.pull_request_merged],
            ),
        )

    @staticmethod
    def on_pr_closed(*, repo: GitHubRepo) -> TriggerConfig[GithubPRClosedTrigger]:
        return TriggerConfig(
            integration_id={{{github.instanceIdRepr}}},
            integration_type='github',
            config_type='github',
            config=_compact_dict(
                repositoryIds=[repo.repository_id],
                eventTypes=[GitHubEventType.pull_request_closed],
            ),
        )

    @staticmethod
    def on_pr_synchronized(*, repo: GitHubRepo) -> TriggerConfig[GithubPRSynchronizedTrigger]:
        return TriggerConfig(
            integration_id={{{github.instanceIdRepr}}},
            integration_type='github',
            config_type='github',
            config=_compact_dict(
                repositoryIds=[repo.repository_id],
                eventTypes=[GitHubEventType.pull_request_synchronize],
            ),
        )

    @staticmethod
    def on_pr(*, repo: GitHubRepo) -> TriggerConfig[GithubPRTrigger]:
        return TriggerConfig(
            integration_id={{{github.instanceIdRepr}}},
            integration_type='github',
            config_type='github',
            config=_compact_dict(
                repositoryIds=[repo.repository_id],
                eventTypes=[
                    GitHubEventType.pull_request_opened,
                    GitHubEventType.pull_request_merged,
                    GitHubEventType.pull_request_closed,
                    GitHubEventType.pull_request_synchronize,
                ],
            ),
        )

    @staticmethod
    def trigger(
        *,
        repos: Sequence[GitHubRepo],
        event_types: Sequence[GitHubEventType] | None = None,
    ) -> TriggerConfig[GithubTrigger]:
        return TriggerConfig(
            integration_id={{{github.instanceIdRepr}}},
            integration_type='github',
            config_type='github',
            config=_compact_dict(
                repositoryIds=[repo.repository_id for repo in repos],
                eventTypes=list(event_types) if event_types is not None else None,
            ),
        )
{{~/if}}
