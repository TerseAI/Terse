{{#if workos}}


# === WorkOS ===


class WorkOS:
    @staticmethod
    def on_user_created() -> TriggerConfig[WorkOSUserCreatedTriggerEvent]:
        return TriggerConfig(
            integration_id={{{workos.instanceIdRepr}}},
            integration_type='workos',
            config_type='workos_input',
            config=_compact_dict(eventTypes=[WorkOSEventType.user_created]),
        )

