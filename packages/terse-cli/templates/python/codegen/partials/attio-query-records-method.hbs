{{#if attio.hasAttrs}}

    def query_records(
        self,
        obj: AttioObjectType[Any, _TRecordValues, Any, _TFilterValues],
        filter: _TFilterValues | None = None,
        limit: int | None = None,
    ) -> AttioTypedQueryResult[_TRecordValues]:
        raw = AttioQueryRecordsToolOutput.model_validate(
            self._agent.execute_tool(
                {{{tool.nameRepr}}},
                _compact_dict(
                    integrationId={{{attio.instanceIdRepr}}},
                    objectSlug=obj.api_slug,
                    filter=_serialize_attio_filter(obj.api_slug, filter),
                    limit=limit,
                ),
            )
        )
        return AttioTypedQueryResult(
            success=raw.success, count=raw.count,
            records=[cast(AttioTypedRecord[_TRecordValues],
            _flatten_attio_record(obj.api_slug, r))
            for r in raw.records],
        )
{{else}}

    def query_records(
        self,
        obj: AttioObjectType,
        filter: object | None = None,
        limit: int | None = None,
    ) -> {{tool.outputModel}}:
        return AttioQueryRecordsToolOutput.model_validate(
            self._agent.execute_tool(
                {{{tool.nameRepr}}},
                _compact_dict(
                    integrationId={{{attio.instanceIdRepr}}},
                    objectSlug=obj.api_slug,
                    filter=_serialize_attio_filter(obj.api_slug, filter),
                    limit=limit,
                ),
            )
        )
{{/if}}
