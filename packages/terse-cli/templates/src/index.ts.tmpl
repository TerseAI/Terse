import {
    Terse,
} from "terse-sdk"
import type { CreateJobParameters } from "terse-sdk"
import {
    ScheduleTrigger,
    TerseSkill,
    GithubSkill
} from "./terse.generated"

const client = new Terse()

const job: CreateJobParameters = {
    name: "{{PROJECT_NAME}}",
    triggers: [new ScheduleTrigger("0 0 * * *")],
    skills: [new GithubSkill()],
    onTrigger: async (event, agent) => {
        // Your job logic here
        const result = agent.run("Summarize the latest changes", event)

        for await (const chunk of result) {
            console.log(chunk)
        }
    },
    webhookURL: "https://example.com/webhook",
}

client.createJob(job)
