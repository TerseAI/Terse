import { createJob, TerseAgent, type GithubPRTrigger } from "terse-sdk"
import { GitHub, Repos, Slack, SlackChannel } from "./terse.generated"

createJob({
    name: "Summarize PR and send slack message",
    triggers: [GitHub.onPROpened({ repo: Repos.TerseAI.Terse })],
    onTrigger: async (event: GithubPRTrigger) => {
        const agent = TerseAgent.create({
            prompt: "You summarise GitHub pull requests and post concise updates to Slack.",
            skills: [GitHub.skill({ repos: [Repos.TerseAI.LandingPage, Repos.TerseAI.Terse] }), Slack.skill({ channel: SlackChannel.AllTerseInc })]
        })

        const message = await agent.tools.slack.sendMessage({
            channelId: SlackChannel.AllTerseInc.channelId,
            message: "New PR from " + event.sender.login + "!"
        })

        const prompt =
            `Summarize this PR ` +
            event.formatForAgentRunner() +
            `. Go look at the code and summarize the changes at a high level. Keep it short and concise, and call out the first file to review. Reply in a thread to the message with ts: ` +
            message.message_ts +
            `. Format the summary using Block Kit, and include any images found in the PR (screenshots, diagrams, etc.) as image blocks.`

        await agent.runAndWait(prompt)
    }
})
