import { createJob, TerseAgent } from "terse-sdk"
import { z } from "zod"

// Triggers, Skills, and resource constants for your workspace live here.
// Run `terse generate` to refresh after connecting new integrations.
import { Triggers } from "./terse.generated"

// `createJob` registers a job with Terse. Each job has a name, one or more
// triggers, and an `onTrigger` handler. `terse deploy` ships every registered
// job; `terse test` and `terse run` execute them locally.
createJob({
    name: "Tell a programming joke example job",

    // When should this job run? `Triggers.*` lists everything available in
    // your workspace (cron, webhooks, integration events). Add more by
    // connecting integrations and running `terse generate`.
    triggers: [Triggers.schedule.cron({ expression: "0 9 * * 1" })],

    // The handler runs every time a trigger fires. `event` is typed to match
    // the trigger(s) above.
    onTrigger: async (event) => {
        // Define an agent. `prompt` shapes how it behaves across runs.
        // `skills` declares which integrations the agent can call — keep the
        // list narrow so the agent only touches what you intend.
        const agent = TerseAgent.create({
            prompt: "You are a helpful assistant that tells programming jokes.",
            skills: []
        })

        // Run the agent on a single input. The optional Zod schema forces a
        // structured response — `response` is typed `{ joke: string }`.
        const response = await agent.runAndWait("Tell me a programming joke.", z.object({
            joke: z.string()
        }))

        console.log(response.joke)
    }
})
