import { Terse, TerseAgent, GithubPRTrigger } from "terse-sdk"; import { Repos, Slack, GitHub, SlackChannel } from "./terse.generated"; const client = new Terse(); await client.createJob({ name:
"Summarize PR and send slack message", triggers: [GitHub.onPROpened({ repo: Repos.TerseAI.Terse })], skills: [ GitHub.skill({ repos: [Repos.TerseAI.LandingPage, Repos.TerseAI.Terse] }), Slack.skill({
channel: SlackChannel.AllTerseInc }), ], onTrigger: async (event: GithubPRTrigger, Agent: TerseAgent) => { const message = await Agent.tools.slack.sendMessage({ channelId:
SlackChannel.AllTerseInc.channelId, message: "New PR from " + event.sender.login + "!", }); const prompt = `Summarize this PR ` + event.formatForAgentRunner() + `. Make sure to go and look at the code
too and summarize the changes at a high level. I want to know what they changes are and what file I should Look at first. Keep it short and concise. Place into a separate thread reply to the message
with ts: ` + message.message_ts + `. Format summaries in Block Kit. Include any images found in the PRs (screenshots, diagrams, etc.) in the Block Kit using image blocks.`; await
Agent.runAndWait(prompt); } });