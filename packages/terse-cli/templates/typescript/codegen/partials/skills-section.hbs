{{sectionHeader "Skills"}}

/**
 * Skills available in your workspace.
 *
 * Type `Skills.` in your editor to see every connected integration's skill at a glance.
 * Use these in `TerseAgent.create({ skills: [...] })`.
 */
export const Skills = {
{{#if slack}}
    /** Slack — send messages and manage threads in a specific channel */
    slack(opts: { channel: SlackChannel; userIds?: string[]; userNames?: string[]; listenToUserDms?: boolean }): TypedSkill<{{{slack.skillToolType}}}> {
        return new SlackOutputConfig("{{escape slack.id}}", opts.channel.channelId ?? null, opts.channel.name ?? null, opts.userIds ?? [], opts.userNames ?? null, opts.listenToUserDms)
    },
{{/if}}
{{#if github}}
    /** GitHub — read code and pull requests from the given repositories */
    github(opts: { repos: Repos[] }): TypedSkill<{{{github.skillToolType}}}> {
        return new GitHubConfig("{{escape github.id}}", opts.repos.map(r => r.repositoryId)) as TypedSkill<{{{github.skillToolType}}}>
    },
{{/if}}
{{#if linear}}
    /** Linear — read and write issues, optionally scoped to a team or project */
    linear(opts?: { team?: LinearTeam; project?: LinearProject }): TypedSkill<{{{linear.skillToolType}}}> {
        return new LinearOutputConfig(
            "{{escape linear.id}}",
            opts?.team?.teamId ?? null,
            opts?.team?.name ?? null,
            opts?.project?.projectId ?? null
        ) as TypedSkill<{{{linear.skillToolType}}}>
    },
{{/if}}
{{#if gmail}}
    /** Gmail — send emails */
    gmail(): TypedSkill<{{{gmail.skillToolType}}}> {
        return new GmailOutputConfig("{{escape gmail.id}}") as TypedSkill<{{{gmail.skillToolType}}}>
    },
    /** Gmail — create draft emails (no auto-send) */
    gmailDraft(): TypedSkill<{{{gmail.skillToolType}}}> {
        return new GmailDraftOutputConfig("{{escape gmail.id}}") as TypedSkill<{{{gmail.skillToolType}}}>
    },
{{/if}}
{{#if notion}}
    /** Notion — read and write to the given databases or pages */
    notion(opts?: { databases?: NotionDatabase[]; pages?: NotionPage[] }): TypedSkill<{{{notion.skillToolType}}}> {
        return new NotionConfig("{{escape notion.id}}",
            opts?.databases?.map(d => d.databaseId), opts?.databases?.map(d => d.title),
            opts?.pages?.map(p => p.pageId), opts?.pages?.map(p => p.title)) as TypedSkill<{{{notion.skillToolType}}}>
    },
{{/if}}
{{#if posthog}}
    /** PostHog — query analytics for a specific project */
    posthog(opts: { project: PosthogProject }): TypedSkill<{{{posthog.skillToolType}}}> {
        return new PosthogConfig("{{escape posthog.id}}", opts.project.projectId, opts.project.name) as TypedSkill<{{{posthog.skillToolType}}}>
    },
{{/if}}
{{#if datadog}}
    /** Datadog — search and analyze logs, optionally scoped to specific indexes */
    datadog(opts?: { indexes?: DatadogIndex[] }): TypedSkill<{{{datadog.skillToolType}}}> {
        return new DatadogConfig("{{escape datadog.id}}", opts?.indexes?.map(i => i.name)) as TypedSkill<{{{datadog.skillToolType}}}>
    },
{{/if}}
{{#if launchdarkly}}
    /** LaunchDarkly — read and toggle feature flags in a project + environments */
    launchDarkly(opts: { project: LaunchDarklyProject; environmentKeys: string[] }): TypedSkill<{{{launchdarkly.skillToolType}}}> {
        return new LaunchDarklyConfig("{{escape launchdarkly.id}}", opts.project.projectKey, opts.environmentKeys) as TypedSkill<{{{launchdarkly.skillToolType}}}>
    },
{{/if}}
{{#if workos}}
    /** WorkOS — manage users, organizations and invitations */
    workOS(): TypedSkill<{{{workos.skillToolType}}}> {
        return new WorkOSOutputConfig("{{escape workos.id}}") as TypedSkill<{{{workos.skillToolType}}}>
    },
{{/if}}
{{#if attio}}
    /** Attio — query and upsert records on a CRM object */
    attio(opts: { object: AttioObject<any> }): TypedSkill<{{{attio.skillToolType}}}> {
        return new AttioOutputConfig("{{escape attio.id}}", opts.object.apiSlug) as TypedSkill<{{{attio.skillToolType}}}>
    },
{{/if}}
{{#if snowflake}}
    /** Snowflake — run SQL queries against your warehouse */
    snowflake(): TypedSkill<{{{snowflake.skillToolType}}}> {
        return new SnowflakeOutputConfig("{{escape snowflake.id}}") as TypedSkill<{{{snowflake.skillToolType}}}>
    },
{{/if}}
    /** Web — built-in web search, page extraction, and multi-source research */
    web(): TypedSkill<"web_search" | "web_extract" | "web_research"> {
        return new WebConfig() as TypedSkill<"web_search" | "web_extract" | "web_research">
    },
    /** ImageEdit — edit and generate images */
    imageEdit(): TypedSkill<"image_edit"> {
        return new ImageEditConfig() as TypedSkill<"image_edit">
    },
}
