{{#if githubRepoMappings.length}}
const __githubRepoNameToFullName = new Map<string, string>([
{{#each githubRepoMappings}}
    ["{{escape name}}", "{{escape fullName}}"],
{{/each}}
])

function __normalizeGitHubRepos(repo: unknown): string {
    if (repo && typeof repo === "object" && "fullName" in (repo as Record<string, unknown>)) {
        const fullName = (repo as { fullName?: unknown }).fullName
        if (typeof fullName === "string" && fullName.length > 0) return fullName
    }
    if (typeof repo === "string") {
        if (repo.includes("/")) return repo
        return __githubRepoNameToFullName.get(repo) ?? repo
    }
    return String(repo ?? "")
}

function __normalizeGitHubReposNames(repositories: unknown): string[] {
    if (!Array.isArray(repositories)) return []
    return repositories.map(repo => __normalizeGitHubRepos(repo))
}

{{/if}}
export type GeneratedTools = {
{{#each groups}}
    {{key}}: {
{{#each methods}}
{{#if description}}        /** {{description}} */
{{/if}}        {{{generatedSignature}}}
{{/each}}
    }
{{/each}}
}

declare module "terse-sdk" {
    interface TerseAgent {
        readonly tools: GeneratedTools
    }
}

function createTools(agent: TerseAgent): GeneratedTools {
    const allowed: Set<string> = new Set(agent.skills.map(config => config.integrationType))
    return {
{{#each groups}}
        ...(allowed.has("{{escape integrationType}}") ? { {{key}}: {
{{#each methods}}
{{#each runtimeLines}}
            {{{this}}}
{{/each}}
{{/each}}
        } } : {}),
{{/each}}
    } as GeneratedTools
}

;(globalThis as any).__terse_createTools = createTools

/**
 * Deterministic tool calls without an agent.
 *
 * `toolbox` exposes every connected integration tool as a typed function. Unlike
 * `agent.tools`, it does not require constructing a `TerseAgent` and is not
 * filtered by `skills`. Use it when you know exactly which tool to call and
 * don't need an LLM in the loop.
 *
 * @example
 * ```ts
 * import { toolbox } from "./terse.generated"
 * await toolbox.slack.sendMessage({ channelId: "...", message: "hi" })
 * ```
 */
export const toolbox: GeneratedTools = {
{{#each groups}}
    {{key}}: {
{{#each methods}}
{{#each runtimeLines}}
        {{{this}}}
{{/each}}
{{/each}}
    },
{{/each}}
}
