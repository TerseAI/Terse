{{sectionHeader "WorkOS"}}

export const WorkOS = {
    /** Trigger on user creation */
    onUserCreated(): TypedTrigger<WorkOSUserTriggerEvent> {
        return new WorkOSInputConfig("{{escape id}}", [WorkOSEventType.USER_CREATED]) as TypedTrigger<WorkOSUserTriggerEvent>
    },
    /** Trigger on user update */
    onUserUpdated(): TypedTrigger<WorkOSUserTriggerEvent> {
        return new WorkOSInputConfig("{{escape id}}", [WorkOSEventType.USER_UPDATED]) as TypedTrigger<WorkOSUserTriggerEvent>
    },
    /** Trigger on user deletion */
    onUserDeleted(): TypedTrigger<WorkOSUserTriggerEvent> {
        return new WorkOSInputConfig("{{escape id}}", [WorkOSEventType.USER_DELETED]) as TypedTrigger<WorkOSUserTriggerEvent>
    },
    /** Trigger on organization membership change */
    onMembershipChanged(): TypedTrigger<WorkOSMembershipTriggerEvent> {
        return new WorkOSInputConfig("{{escape id}}", [WorkOSEventType.ORGANIZATION_MEMBERSHIP_CREATED, WorkOSEventType.ORGANIZATION_MEMBERSHIP_UPDATED, WorkOSEventType.ORGANIZATION_MEMBERSHIP_DELETED]) as TypedTrigger<WorkOSMembershipTriggerEvent>
    },
    /** Trigger when an invitation is sent */
    onInvitationSent(): TypedTrigger<WorkOSInvitationTriggerEvent> {
        return new WorkOSInputConfig("{{escape id}}", [WorkOSEventType.INVITATION_CREATED, WorkOSEventType.INVITATION_RESENT]) as TypedTrigger<WorkOSInvitationTriggerEvent>
    },
    /** Trigger when an invitation is first created */
    onInvitationCreated(): TypedTrigger<WorkOSInvitationTriggerEvent> {
        return new WorkOSInputConfig("{{escape id}}", [WorkOSEventType.INVITATION_CREATED]) as TypedTrigger<WorkOSInvitationTriggerEvent>
    },
    /** Trigger when an invitation is resent */
    onInvitationResent(): TypedTrigger<WorkOSInvitationTriggerEvent> {
        return new WorkOSInputConfig("{{escape id}}", [WorkOSEventType.INVITATION_RESENT]) as TypedTrigger<WorkOSInvitationTriggerEvent>
    },
    /** Trigger on invitation accepted */
    onInvitationAccepted(): TypedTrigger<WorkOSInvitationTriggerEvent> {
        return new WorkOSInputConfig("{{escape id}}", [WorkOSEventType.INVITATION_ACCEPTED]) as TypedTrigger<WorkOSInvitationTriggerEvent>
    },
    /** Trigger when an invitation is revoked */
    onInvitationRevoked(): TypedTrigger<WorkOSInvitationTriggerEvent> {
        return new WorkOSInputConfig("{{escape id}}", [WorkOSEventType.INVITATION_REVOKED]) as TypedTrigger<WorkOSInvitationTriggerEvent>
    },
    /** Trigger on organization creation */
    onOrganizationCreated(): TypedTrigger<WorkOSOrganizationTriggerEvent> {
        return new WorkOSInputConfig("{{escape id}}", [WorkOSEventType.ORGANIZATION_CREATED]) as TypedTrigger<WorkOSOrganizationTriggerEvent>
    },
    /** Trigger on specific WorkOS event types */
    trigger(opts?: { eventTypes?: WorkOSEventType[] }): TypedTrigger<WorkOSTriggerEvent | WorkOSUserTriggerEvent | WorkOSMembershipTriggerEvent | WorkOSInvitationTriggerEvent | WorkOSOrganizationTriggerEvent> {
        return new WorkOSInputConfig("{{escape id}}", opts?.eventTypes) as TypedTrigger<WorkOSTriggerEvent | WorkOSUserTriggerEvent | WorkOSMembershipTriggerEvent | WorkOSInvitationTriggerEvent | WorkOSOrganizationTriggerEvent>
    },
    /** Use in `skills[]` */
    skill(): TypedSkill<{{{skillToolType}}}> {
        return new WorkOSOutputConfig("{{escape id}}") as TypedSkill<{{{skillToolType}}}>
    },
}

