{{sectionHeader "WorkOS"}}

export const WorkOS = {
    /** Trigger on user creation */
    onUserCreated(): TypedTrigger<WorkOSUserInputEvent> {
        return new WorkOSInputConfig("{{escape id}}", [WorkOSEventType.USER_CREATED]) as TypedTrigger<WorkOSUserInputEvent>
    },
    /** Trigger on user update */
    onUserUpdated(): TypedTrigger<WorkOSUserInputEvent> {
        return new WorkOSInputConfig("{{escape id}}", [WorkOSEventType.USER_UPDATED]) as TypedTrigger<WorkOSUserInputEvent>
    },
    /** Trigger on user deletion */
    onUserDeleted(): TypedTrigger<WorkOSUserInputEvent> {
        return new WorkOSInputConfig("{{escape id}}", [WorkOSEventType.USER_DELETED]) as TypedTrigger<WorkOSUserInputEvent>
    },
    /** Trigger on organization membership change */
    onMembershipChanged(): TypedTrigger<WorkOSMembershipInputEvent> {
        return new WorkOSInputConfig("{{escape id}}", [WorkOSEventType.ORGANIZATION_MEMBERSHIP_CREATED, WorkOSEventType.ORGANIZATION_MEMBERSHIP_UPDATED, WorkOSEventType.ORGANIZATION_MEMBERSHIP_DELETED]) as TypedTrigger<WorkOSMembershipInputEvent>
    },
    /** Trigger when an invitation is sent */
    onInvitationSent(): TypedTrigger<WorkOSInvitationInputEvent> {
        return new WorkOSInputConfig("{{escape id}}", [WorkOSEventType.INVITATION_CREATED, WorkOSEventType.INVITATION_RESENT]) as TypedTrigger<WorkOSInvitationInputEvent>
    },
    /** Trigger when an invitation is first created */
    onInvitationCreated(): TypedTrigger<WorkOSInvitationInputEvent> {
        return new WorkOSInputConfig("{{escape id}}", [WorkOSEventType.INVITATION_CREATED]) as TypedTrigger<WorkOSInvitationInputEvent>
    },
    /** Trigger when an invitation is resent */
    onInvitationResent(): TypedTrigger<WorkOSInvitationInputEvent> {
        return new WorkOSInputConfig("{{escape id}}", [WorkOSEventType.INVITATION_RESENT]) as TypedTrigger<WorkOSInvitationInputEvent>
    },
    /** Trigger on invitation accepted */
    onInvitationAccepted(): TypedTrigger<WorkOSInvitationInputEvent> {
        return new WorkOSInputConfig("{{escape id}}", [WorkOSEventType.INVITATION_ACCEPTED]) as TypedTrigger<WorkOSInvitationInputEvent>
    },
    /** Trigger when an invitation is revoked */
    onInvitationRevoked(): TypedTrigger<WorkOSInvitationInputEvent> {
        return new WorkOSInputConfig("{{escape id}}", [WorkOSEventType.INVITATION_REVOKED]) as TypedTrigger<WorkOSInvitationInputEvent>
    },
    /** Trigger on organization creation */
    onOrganizationCreated(): TypedTrigger<WorkOSOrganizationInputEvent> {
        return new WorkOSInputConfig("{{escape id}}", [WorkOSEventType.ORGANIZATION_CREATED]) as TypedTrigger<WorkOSOrganizationInputEvent>
    },
    /** Trigger on specific WorkOS event types */
    trigger(opts?: { eventTypes?: WorkOSEventType[] }): TypedTrigger<WorkOSInputEvent | WorkOSUserInputEvent | WorkOSMembershipInputEvent | WorkOSInvitationInputEvent | WorkOSOrganizationInputEvent> {
        return new WorkOSInputConfig("{{escape id}}", opts?.eventTypes) as TypedTrigger<WorkOSInputEvent | WorkOSUserInputEvent | WorkOSMembershipInputEvent | WorkOSInvitationInputEvent | WorkOSOrganizationInputEvent>
    },
    /** Use in `skills[]` */
    skill(): TypedSkill<{{{skillToolType}}}> {
        return new WorkOSOutputConfig("{{escape id}}") as TypedSkill<{{{skillToolType}}}>
    },
}

