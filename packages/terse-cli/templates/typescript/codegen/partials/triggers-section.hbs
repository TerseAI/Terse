        onConnectionRequestAccepted(opts?: { campaigns?: HeyReachCampaign[] }): TypedTrigger<HeyReachConnectionRequestAcceptedTrigger> {
            return new HeyReachInputConfig("{{escape heyreach.id}}", [HeyReachEventType.CONNECTION_REQUEST_ACCEPTED], (opts?.campaigns ?? []).map(c => c.campaignId))
        },
        /** Trigger when a LinkedIn message is sent */
        onMessageSent(opts?: { campaigns?: HeyReachCampaign[] }): TypedTrigger<HeyReachMessageSentTrigger> {
            return new HeyReachInputConfig("{{escape heyreach.id}}", [HeyReachEventType.MESSAGE_SENT], (opts?.campaigns ?? []).map(c => c.campaignId))
        },
        /** Trigger on the first reply to a LinkedIn message */
        onMessageReplyReceived(opts?: { campaigns?: HeyReachCampaign[] }): TypedTrigger<HeyReachMessageReplyReceivedTrigger> {
            return new HeyReachInputConfig("{{escape heyreach.id}}", [HeyReachEventType.MESSAGE_REPLY_RECEIVED], (opts?.campaigns ?? []).map(c => c.campaignId))
        },
        /** Trigger when an InMail is sent */
        onInmailSent(opts?: { campaigns?: HeyReachCampaign[] }): TypedTrigger<HeyReachInmailSentTrigger> {
            return new HeyReachInputConfig("{{escape heyreach.id}}", [HeyReachEventType.INMAIL_SENT], (opts?.campaigns ?? []).map(c => c.campaignId))
        },
        /** Trigger on the first reply to an InMail */
        onInmailReplyReceived(opts?: { campaigns?: HeyReachCampaign[] }): TypedTrigger<HeyReachInmailReplyReceivedTrigger> {
            return new HeyReachInputConfig("{{escape heyreach.id}}", [HeyReachEventType.INMAIL_REPLY_RECEIVED], (opts?.campaigns ?? []).map(c => c.campaignId))
        },
        /** Trigger when a follow is sent */
        onFollowSent(opts?: { campaigns?: HeyReachCampaign[] }): TypedTrigger<HeyReachFollowSentTrigger> {
            return new HeyReachInputConfig("{{escape heyreach.id}}", [HeyReachEventType.FOLLOW_SENT], (opts?.campaigns ?? []).map(c => c.campaignId))
        },
        /** Trigger when a post is liked */
        onPostLiked(opts?: { campaigns?: HeyReachCampaign[] }): TypedTrigger<HeyReachPostLikedTrigger> {
            return new HeyReachInputConfig("{{escape heyreach.id}}", [HeyReachEventType.POST_LIKED], (opts?.campaigns ?? []).map(c => c.campaignId))
        },
        /** Trigger when a profile is viewed */
        onProfileViewed(opts?: { campaigns?: HeyReachCampaign[] }): TypedTrigger<HeyReachProfileViewedTrigger> {
            return new HeyReachInputConfig("{{escape heyreach.id}}", [HeyReachEventType.PROFILE_VIEWED], (opts?.campaigns ?? []).map(c => c.campaignId))
        },
        /** Trigger when a campaign completes */
        onCampaignCompleted(opts?: { campaigns?: HeyReachCampaign[] }): TypedTrigger<HeyReachCampaignCompletedTrigger> {
            return new HeyReachInputConfig("{{escape heyreach.id}}", [HeyReachEventType.CAMPAIGN_COMPLETED], (opts?.campaigns ?? []).map(c => c.campaignId))
        },
        /** Trigger when prospect tags are updated */
        onProspectTagUpdated(opts?: { campaigns?: HeyReachCampaign[] }): TypedTrigger<HeyReachProspectTagUpdatedTrigger> {
            return new HeyReachInputConfig("{{escape heyreach.id}}", [HeyReachEventType.PROSPECT_TAG_UPDATED], (opts?.campaigns ?? []).map(c => c.campaignId))
        },
        /** Trigger on specific HeyReach event types */
        trigger(opts?: { campaigns?: HeyReachCampaign[]; eventTypes?: HeyReachEventType[] }): TypedTrigger<HeyReachTrigger> {
            return new HeyReachInputConfig("{{escape heyreach.id}}", opts?.eventTypes ?? [], (opts?.campaigns ?? []).map(c => c.campaignId))
        },
    },
{{/if}}
{{#if workos}}
    workOS: {
        /** Trigger on user creation */
        onUserCreated(): TypedTrigger<WorkOSUserCreatedTrigger> {
            return new WorkOSInputConfig("{{escape workos.id}}", [WorkOSEventType.USER_CREATED])
        },
        /** Trigger on user update */
        onUserUpdated(): TypedTrigger<WorkOSUserUpdatedTrigger> {
            return new WorkOSInputConfig("{{escape workos.id}}", [WorkOSEventType.USER_UPDATED])
        },
        /** Trigger on user deletion */
        onUserDeleted(): TypedTrigger<WorkOSUserDeletedTrigger> {
            return new WorkOSInputConfig("{{escape workos.id}}", [WorkOSEventType.USER_DELETED])
        },
        /** Trigger on organization membership creation */
        onMembershipCreated(): TypedTrigger<WorkOSOrganizationMembershipCreatedTrigger> {
            return new WorkOSInputConfig("{{escape workos.id}}", [WorkOSEventType.ORGANIZATION_MEMBERSHIP_CREATED])
        },
        /** Trigger on organization membership update */
        onMembershipUpdated(): TypedTrigger<WorkOSOrganizationMembershipUpdatedTrigger> {
            return new WorkOSInputConfig("{{escape workos.id}}", [WorkOSEventType.ORGANIZATION_MEMBERSHIP_UPDATED])
        },
        /** Trigger on organization membership deletion */
        onMembershipDeleted(): TypedTrigger<WorkOSOrganizationMembershipDeletedTrigger> {
            return new WorkOSInputConfig("{{escape workos.id}}", [WorkOSEventType.ORGANIZATION_MEMBERSHIP_DELETED])
        },
        /** Trigger on any organization membership change */
        onMembershipChanged(): TypedTrigger<WorkOSMembershipTrigger> {
            return new WorkOSInputConfig("{{escape workos.id}}", [WorkOSEventType.ORGANIZATION_MEMBERSHIP_CREATED, WorkOSEventType.ORGANIZATION_MEMBERSHIP_UPDATED, WorkOSEventType.ORGANIZATION_MEMBERSHIP_DELETED])
        },
        /** Trigger when an invitation is sent (created or resent) */
        onInvitationSent(): TypedTrigger<WorkOSInvitationTrigger> {
            return new WorkOSInputConfig("{{escape workos.id}}", [WorkOSEventType.INVITATION_CREATED, WorkOSEventType.INVITATION_RESENT])
        },
        /** Trigger when an invitation is first created */
        onInvitationCreated(): TypedTrigger<WorkOSInvitationCreatedTrigger> {
            return new WorkOSInputConfig("{{escape workos.id}}", [WorkOSEventType.INVITATION_CREATED])
        },
        /** Trigger when an invitation is resent */
        onInvitationResent(): TypedTrigger<WorkOSInvitationResentTrigger> {
            return new WorkOSInputConfig("{{escape workos.id}}", [WorkOSEventType.INVITATION_RESENT])
        },
        /** Trigger on invitation accepted */
        onInvitationAccepted(): TypedTrigger<WorkOSInvitationAcceptedTrigger> {
            return new WorkOSInputConfig("{{escape workos.id}}", [WorkOSEventType.INVITATION_ACCEPTED])
        },
        /** Trigger when an invitation is revoked */
        onInvitationRevoked(): TypedTrigger<WorkOSInvitationRevokedTrigger> {
            return new WorkOSInputConfig("{{escape workos.id}}", [WorkOSEventType.INVITATION_REVOKED])
        },
        /** Trigger on organization creation */
        onOrganizationCreated(): TypedTrigger<WorkOSOrganizationTrigger> {
            return new WorkOSInputConfig("{{escape workos.id}}", [WorkOSEventType.ORGANIZATION_CREATED])
        },
        /** Trigger on specific WorkOS event types */
        trigger(opts?: { eventTypes?: WorkOSEventType[] }): TypedTrigger<WorkOSTrigger | WorkOSUserTrigger | WorkOSMembershipTrigger | WorkOSInvitationTrigger | WorkOSOrganizationTrigger> {
            return new WorkOSInputConfig("{{escape workos.id}}", opts?.eventTypes)
        },
    },
{{/if}}
    schedule: {
        /** Run on a cron schedule */
        cron(opts: { expression: string }): TypedTrigger<CronTrigger> {
            return new TimeTriggerConfig(opts.expression)
        },
    },
    webhook: {
        /** Trigger via an external HTTP request to a generated URL */
        onRequest<TBody = unknown>(): TypedTrigger<WebhookTrigger<TBody>> {
            return new WebhookInputConfig()
        },
    },
    webMonitor: {
        /** Trigger when a query against the live web matches the given schema */
        onEvent<const TSchema>(opts: {
            query: string
            frequency: { number: number; unit: FrequencyUnit }
            outputSchema?: TSchema
        }): TypedTrigger<WebMonitorTrigger<InferStructuredOutput<TSchema>>> {
            return new WebMonitorConfig(opts.query, opts.frequency, opts.outputSchema)
        },
    },
}
