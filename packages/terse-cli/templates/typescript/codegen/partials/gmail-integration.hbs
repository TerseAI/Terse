export const gmailTriggers = {
    /** Trigger when a new email is received */
    onEmail(): TypedTrigger<GmailTrigger> {
        return new GmailConfig("{{escape gmail.id}}", [GmailEventType.EMAIL_RECEIVED])
    },
    /** Trigger on all Gmail events */
    trigger(opts?: { eventTypes?: GmailEventType[] }): TypedTrigger<GmailTrigger> {
        return new GmailConfig("{{escape gmail.id}}", opts?.eventTypes)
    },
}

{{sectionHeader "Gmail skills"}}

/** Gmail — send emails */
export function gmailSkill(): TypedSkill<{{{gmail.skillToolType}}}> {
    return new GmailOutputConfig("{{escape gmail.id}}")
}

/** Gmail — create draft emails (no auto-send) */
export function gmailDraftSkill(): TypedSkill<{{{gmail.skillToolType}}}> {
    return new GmailDraftOutputConfig("{{escape gmail.id}}")
}
