{{sectionHeader "Gmail"}}

export const Gmail = {
    /** Trigger when a new email is received */
    onEmail(): TypedTrigger<GmailTriggerEvent> {
        return new GmailConfig("{{escape id}}", [GmailEventType.EMAIL_RECEIVED]) as TypedTrigger<GmailTriggerEvent>
    },
    /** Trigger on all Gmail events */
    trigger(opts?: { eventTypes?: GmailEventType[] }): TypedTrigger<GmailTriggerEvent> {
        return new GmailConfig("{{escape id}}", opts?.eventTypes) as TypedTrigger<GmailTriggerEvent>
    },
    /** Use in `skills[]` */
    skill(): TypedSkill<{{{skillToolType}}}> {
        return new GmailOutputConfig("{{escape id}}") as TypedSkill<{{{skillToolType}}}>
    },
    /** Use in `skills[]` — creates draft emails */
    draftSkill(): TypedSkill<{{{skillToolType}}}> {
        return new GmailDraftOutputConfig("{{escape id}}") as TypedSkill<{{{skillToolType}}}>
    },
}

