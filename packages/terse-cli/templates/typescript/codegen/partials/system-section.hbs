{{sectionHeader "Schedule"}}

export const Schedule = {
    /** Use in `triggers[]` — run on a cron schedule */
    cron(opts: { expression: string }): TimeTriggerConfig {
        return new TimeTriggerConfig(opts.expression)
    },
}

{{sectionHeader "Webhook"}}

export const Webhook = {
    /** Use in `triggers[]` — trigger via an external HTTP request to a generated URL */
    onRequest(): TypedTrigger<WebhookInputEvent> {
        return new WebhookInputConfig() as TypedTrigger<WebhookInputEvent>
    },
}

{{sectionHeader "Terse"}}

export const Terse = {
    /** Use in `skills[]` — built-in web search */
    skill(): TypedSkill<{{{skillToolType}}}> {
        return new TerseConfig() as TypedSkill<{{{skillToolType}}}>
    },
}

