{{sectionHeader "Schedule"}}

export const Schedule = {
    /** Use in `triggers[]` — run on a cron schedule */
    cron(opts: { expression: string }): TypedTrigger<CronTrigger> {
        return new TimeTriggerConfig(opts.expression)
    },
}

{{sectionHeader "Webhook"}}

export const Webhook = {
    /** Use in `triggers[]` — trigger via an external HTTP request to a generated URL */
    onRequest<TBody = unknown>(): TypedTrigger<WebhookTrigger<TBody>> {
        return new WebhookInputConfig()
    },
}

{{sectionHeader "WebMonitor"}}

export const WebMonitor = {
    onEvent<const TSchema>(opts: {
        query: string
        frequency: { number: number; unit: FrequencyUnit }
        outputSchema?: TSchema
    }): TypedTrigger<WebMonitorTrigger<InferStructuredOutput<TSchema>>> {
        return new WebMonitorConfig(opts.query, opts.frequency, opts.outputSchema)
    },
}

{{sectionHeader "Web tools"}}

export const Web = {
    /** Use in `skills[]` — built-in web search, page extraction, and multi-source research */
    skill(): TypedSkill<"web_search" | "web_extract" | "web_research"> {
        return new WebConfig() as TypedSkill<"web_search" | "web_extract" | "web_research">
    },
}

export const ImageEdit = {
    /** Use in `skills[]` — edit/generate images */
    skill(): TypedSkill<"image_edit"> {
        return new ImageEditConfig() as TypedSkill<"image_edit">
    },
}
