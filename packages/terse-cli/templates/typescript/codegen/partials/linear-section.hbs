{{sectionHeader "Linear"}}

{{> resource-class teamClass}}

export const Linear = {
    /** Trigger when a new issue is created */
    onIssueCreated(opts?: { projectId?: string; projectName?: string }): TypedTrigger<LinearIssueCreatedTriggerEvent> {
        return new LinearInputConfig("{{escape id}}", opts?.projectId, opts?.projectName, [LinearEventType.ISSUE_CREATED]) 
    },
    /** Trigger when an issue is updated */
    onIssueUpdated(opts?: { projectId?: string; projectName?: string }): TypedTrigger<LinearIssueUpdatedTriggerEvent> {
        return new LinearInputConfig("{{escape id}}", opts?.projectId, opts?.projectName, [LinearEventType.ISSUE_UPDATED]) 
    },
    /** Trigger when a comment is added to an issue */
    onComment(opts?: { projectId?: string; projectName?: string }): TypedTrigger<LinearCommentCreatedTriggerEvent> {
        return new LinearInputConfig("{{escape id}}", opts?.projectId, opts?.projectName, [LinearEventType.COMMENT_CREATED]) 
    },
    /** Trigger on all Linear events */
    trigger(opts?: { projectId?: string; projectName?: string; eventTypes?: LinearEventType[] }): TypedTrigger<LinearTriggerEvent> {
        return new LinearInputConfig("{{escape id}}", opts?.projectId, opts?.projectName, opts?.eventTypes)
    },
    /** Use in `skills[]` */
    skill(opts?: { team?: LinearTeam; projectId?: string; projectName?: string }): TypedSkill<{{{skillToolType}}}> {
        return new LinearOutputConfig("{{escape id}}", opts?.team?.teamId, opts?.team?.name, opts?.projectId, opts?.projectName) as TypedSkill<{{{skillToolType}}}>
    },
}

