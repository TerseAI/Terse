export const Linear = {
    /** Trigger when a new issue is created. Use `LinearTeam.*.teamId` / `LinearProject.*.projectId` from generated constants. */
    onIssueCreated(opts?: { teamId?: string; projectId?: string }): TypedTrigger<LinearIssueCreatedTrigger> {
        return new LinearInputConfig("{{escape id}}", opts?.projectId ?? null, [LinearEventType.ISSUE_CREATED], opts?.teamId ?? null)
    },
    /** Trigger when an issue is updated */
    onIssueUpdated(opts?: { teamId?: string; projectId?: string }): TypedTrigger<LinearIssueUpdatedTrigger> {
        return new LinearInputConfig("{{escape id}}", opts?.projectId ?? null, [LinearEventType.ISSUE_UPDATED], opts?.teamId ?? null)
    },
    /** Trigger when a comment is added to an issue */
    onComment(opts?: { teamId?: string; projectId?: string }): TypedTrigger<LinearCommentCreatedTrigger> {
        return new LinearInputConfig("{{escape id}}", opts?.projectId ?? null, [LinearEventType.COMMENT_CREATED], opts?.teamId ?? null)
    },
    /** Trigger on all Linear events */
    trigger(opts?: { teamId?: string; projectId?: string; eventTypes?: LinearEventType[] }): TypedTrigger<LinearTrigger> {
        return new LinearInputConfig("{{escape id}}", opts?.projectId ?? null, opts?.eventTypes, opts?.teamId ?? null)
    },
    /** Use in `skills[]`. Pass ids/names from `LinearTeam.*` / `LinearProject.*` constants. */
    skill(opts?: { teamId?: string; teamName?: string; projectId?: string }): TypedSkill<{{{skillToolType}}}> {
        return new LinearOutputConfig("{{escape id}}", opts?.teamId ?? null, opts?.teamName ?? null, opts?.projectId ?? null) as TypedSkill<{{{skillToolType}}}>
    },
}
