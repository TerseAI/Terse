/** PostHog — query analytics for a specific project */
export function posthogSkill(opts: { project: PosthogProject }): TypedSkill<{{{posthog.skillToolType}}}> {
    return new PosthogConfig("{{escape posthog.id}}", opts.project.projectId, opts.project.name)
}
