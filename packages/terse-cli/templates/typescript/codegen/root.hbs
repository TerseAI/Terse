{{sectionHeader "Triggers"}}

/**
 * Triggers available in your workspace.
 *
 * Type `Triggers.` in your editor to see every connected integration with triggers.
 * Use these in `createJob({ triggers: [...] })`.
 */
export const Triggers = {
{{#if slack}}
    slack: slackTriggers,
{{/if}}
{{#if github}}
    github: githubTriggers,
{{/if}}
{{#if linear}}
    linear: linearTriggers,
{{/if}}
{{#if gmail}}
    gmail: gmailTriggers,
{{/if}}
{{#if heyreach}}
    heyReach: heyReachTriggers,
{{/if}}
{{#if attio}}
    attio: attioTriggers,
{{/if}}
{{#if workos}}
    workOS: workOSTriggers,
{{/if}}
    schedule: {
        /** Run on a cron schedule (5-field cron expression, evaluated in UTC) */
        cron(opts: { expression: string }): TypedTrigger<CronTrigger> {
            return new TimeTriggerConfig(opts.expression)
        },
    },
    webhook: {
        /** Trigger via an external HTTP request to a generated URL */
        onRequest<TBody = unknown>(): TypedTrigger<WebhookTrigger<TBody>> {
            return new WebhookInputConfig()
        },
    },
    webMonitor: {
        /** Trigger when a query against the live web matches the given schema */
        onEvent<const TSchema>(opts: {
            query: string
            frequency: { number: number; unit: FrequencyUnit }
            outputSchema?: TSchema
        }): TypedTrigger<WebMonitorTrigger<InferStructuredOutput<TSchema>>> {
            return new WebMonitorConfig(opts.query, opts.frequency, opts.outputSchema)
        },
    },
}

{{sectionHeader "Skills"}}

/**
 * Skills available in your workspace.
 *
 * Type `Skills.` in your editor to see every connected integration's skill at a glance.
 * Use these in `generateText({ skills: [...] })` (or `TerseAgent.create({ skills: [...] })`).
 */
export const Skills = {
{{#if slack}}
    /** Slack — send messages and manage threads in a specific channel */
    slack: slackSkill,
{{/if}}
{{#if github}}
    /** GitHub — read code and pull requests from the given repositories */
    github: githubSkill,
{{/if}}
{{#if linear}}
    /** Linear — read and write issues, optionally scoped to a team or project */
    linear: linearSkill,
{{/if}}
{{#if gmail}}
    /** Gmail — send emails */
    gmail: gmailSkill,
    /** Gmail — create draft emails (no auto-send) */
    gmailDraft: gmailDraftSkill,
{{/if}}
{{#if notion}}
    /** Notion — read and write to the given databases or pages */
    notion: notionSkill,
{{/if}}
{{#if posthog}}
    /** PostHog — query analytics for a specific project */
    posthog: posthogSkill,
{{/if}}
{{#if datadog}}
    /** Datadog — search and analyze logs, optionally scoped to specific indexes */
    datadog: datadogSkill,
{{/if}}
{{#if launchdarkly}}
    /** LaunchDarkly — read and toggle feature flags in a project + environments */
    launchDarkly: launchDarklySkill,
{{/if}}
{{#if workos}}
    /** WorkOS — manage users, organizations and invitations */
    workOS: workOSSkill,
{{/if}}
{{#if attio}}
    /** Attio — query and upsert records on a CRM object */
    attio: attioSkill,
{{/if}}
{{#if snowflake}}
    /** Snowflake — run SQL queries against your warehouse */
    snowflake: snowflakeSkill,
{{/if}}
    /** Web — built-in web search, page extraction, and multi-source research. Pass `allowedDomains` to restrict search and page extraction to specific sites (and their subdomains). */
    web(opts: { allowedDomains?: string[] } = {}): TypedSkill<"web_search" | "web_extract" | "web_research"> {
        return new WebConfig(opts)
    },
    /** ImageEdit — edit and generate images */
    imageEdit(): TypedSkill<"image_edit"> {
        return new ImageEditConfig()
    },
    /** Memory — built-in persistent memory the agent reads and writes under /memories, scoped to this job and surviving across runs. */
    memory(): TypedSkill<"memory"> {
        return new MemoryConfig()
    },
}

{{sectionHeader "Typed Tools"}}

{{#if toolFiles.terse}}
{{> tools-slice toolFiles.terse}}

{{/if}}
export type GeneratedTools = {
{{#each toolboxEntries}}
    {{key}}: {{typeName}}
{{/each}}
}

declare module "terse-sdk" {
    interface TerseAgent {
        readonly tools: GeneratedTools
    }
}

function createTools(agent: TerseAgent): GeneratedTools {
    const allowed: Set<string> = new Set(agent.skills.map(config => config.integrationType))
    return {
{{#each toolboxEntries}}
        ...(allowed.has("{{escape integrationType}}") ? { {{key}}: {{constName}} } : {}),
{{/each}}
    } as GeneratedTools
}

;(globalThis as any).__terse_createTools = createTools

/**
 * Deterministic tool calls without an agent.
 *
 * `toolbox` exposes every connected integration tool as a typed function. Unlike
 * `agent.tools`, it does not require constructing a `TerseAgent` and is not
 * filtered by `skills`. Use it when you know exactly which tool to call and
 * don't need an LLM in the loop.
 *
 * @example
 * ```ts
 * import { toolbox } from "./terse.generated"
 * await toolbox.slack.sendMessage({ channelId: "...", message: "hi" })
 * ```
 */
export const toolbox: GeneratedTools = {
{{#each toolboxEntries}}
    {{key}}: {{constName}},
{{/each}}
}
