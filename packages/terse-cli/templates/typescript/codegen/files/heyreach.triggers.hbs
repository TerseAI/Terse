export const heyReachTriggers = {
    /** Trigger when a connection request is sent */
    onConnectionRequestSent(opts?: { campaigns?: HeyReachCampaign[] }): TypedTrigger<HeyReachConnectionRequestSentTrigger> {
        return new HeyReachInputConfig("{{escape heyreach.id}}", HeyReachEventType.CONNECTION_REQUEST_SENT, (opts?.campaigns ?? []).map(c => c.campaignId))
