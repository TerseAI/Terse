/** Datadog — search and analyze logs, optionally scoped to specific indexes */
export function datadogSkill(opts?: { indexes?: DatadogIndex[] }): TypedSkill<{{{datadog.skillToolType}}}> {
    return new DatadogConfig("{{escape datadog.id}}", opts?.indexes?.map(i => i.name))
}
