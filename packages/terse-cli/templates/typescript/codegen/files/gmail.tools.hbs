/** Gmail — send emails */
export function gmailSkill(): TypedSkill<{{{gmail.skillToolType}}}> {
    return new GmailOutputConfig("{{escape gmail.id}}")
}

/** Gmail — create draft emails (no auto-send) */
export function gmailDraftSkill(): TypedSkill<{{{gmail.skillToolType}}}> {
    return new GmailDraftOutputConfig("{{escape gmail.id}}")
}
