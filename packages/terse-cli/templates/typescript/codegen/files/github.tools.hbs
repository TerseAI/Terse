{{sectionHeader "GitHub resources"}}

export class GithubOwner {
    constructor(public readonly name: string) {}
{{#if github.owners.length}}

{{#each github.owners}}
    static {{staticName}} = new GithubOwner("{{escape name}}")
{{/each}}
{{/if}}
}

export class Repos {
    constructor(
        public readonly repositoryId: number,
        public readonly name: string,
        public readonly owner: GithubOwner,
        public readonly fullName: string
    ) {}
{{#if github.repoGroups.length}}

{{#each github.repoGroups}}
    static {{ownerStaticName}} = {
{{#each repos}}
        {{staticName}}: new Repos({{id}}, "{{escape name}}", GithubOwner.{{../ownerStaticName}}, "{{escape fullName}}"),
{{/each}}
    } as const
{{/each}}
{{/if}}
}

{{#if githubRepoMappings.length}}
const __githubRepoNameToFullName = new Map<string, string>([
{{#each githubRepoMappings}}
    ["{{escape name}}", "{{escape fullName}}"],
{{/each}}
])

function __normalizeGitHubRepos(repo: unknown): string {
    if (repo && typeof repo === "object" && "fullName" in (repo as Record<string, unknown>)) {
        const fullName = (repo as { fullName?: unknown }).fullName
        if (typeof fullName === "string" && fullName.length > 0) return fullName
    }
    if (typeof repo === "string") {
        if (repo.includes("/")) return repo
        return __githubRepoNameToFullName.get(repo) ?? repo
    }
    return String(repo ?? "")
}

function __normalizeGitHubReposNames(repositories: unknown): string[] {
    if (!Array.isArray(repositories)) return []
    return repositories.map(repo => __normalizeGitHubRepos(repo))
}

{{/if}}
{{#if toolFiles.github}}
{{sectionHeader "GitHub tools"}}

{{> tools-slice toolFiles.github}}

{{/if}}
{{sectionHeader "GitHub skill"}}

/** GitHub — read code and pull requests from the given repositories */
export function githubSkill(opts: { repos: Repos[] }): TypedSkill<{{{github.skillToolType}}}> {
    return new GitHubConfig("{{escape github.id}}", opts.repos.map(r => r.repositoryId))
}
