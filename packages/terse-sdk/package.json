{
    "name": "terse-sdk",
    "version": "0.3.8",
    "type": "module",
    "license": "SEE LICENSE IN LICENSE.md",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/TerseAI/Terse.git",
        "directory": "packages/terse-sdk"
    },
    "homepage": "https://docs.useterse.ai",
    "bugs": {
        "url": "https://github.com/TerseAI/Terse/issues"
    },
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch --preserveWatchOutput",
        "format": "pnpm exec prettier --config ../../.prettierrc --write \"src/**/*.ts\"",
        "format:check": "pnpm exec prettier --config ../../.prettierrc --check \"src/**/*.ts\"",
        "install-global": "npm run build && npm link"
    },
    "peerDependencies": {
        "workflow": "5.0.0-beta.19",
        "zod": "^4.2.0"
    },
    "devDependencies": {
        "@types/ms": "^2.1.0",
        "@types/node": "^22.0.0",
        "typescript": "^5.0.0",
        "workflow": "5.0.0-beta.19",
        "zod": "^4.3.6"
    },
    "dependencies": {
        "ms": "2.1.3",
        "terse-types": "workspace:*"
    }
}
