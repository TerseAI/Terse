{# Literal type aliases for each integration's tool names, plus AllToolNames.
   Emits nothing when no tools are configured. #}
{% macro tool_names_literal(tools) -%}
{%- for tool in tools -%}
{{ tool.name_repr }}{% if not loop.last %}, {% endif %}
{%- endfor -%}
{%- endmacro %}

{% macro tool_name_types(attio, snowflake) %}
{% set attio_approvable_tools = attio.tools | selectattr('approvable') | list if attio else [] %}
{% set snowflake_approvable_tools = snowflake.tools | selectattr('approvable') | list if snowflake else [] %}
{% if attio_approvable_tools or snowflake_approvable_tools %}


# === Tool name types ===

{% if attio_approvable_tools %}
AttioToolNames = Literal[{{ tool_names_literal(attio_approvable_tools) }}]
{% endif %}
{% if snowflake_approvable_tools %}
SnowflakeToolNames = Literal[{{ tool_names_literal(snowflake_approvable_tools) }}]
{% endif %}
{% if attio_approvable_tools or snowflake_approvable_tools %}
AllToolNames = Literal[{{ tool_names_literal(attio_approvable_tools + snowflake_approvable_tools) }}]
{% endif %}
{% endif %}
{% endmacro %}
