{% from "macros/attio/object_types.jinja2" import attio_object_types %}

{# Full Attio type layer: per-object TypedDicts, AttioObjectType, AttioObjects,
   the Attio skill helper, and (when schema is known) the record-flattening helpers.
   Emits nothing when Attio is not configured. #}
{% macro attio_section(attio) %}
{% if attio %}
{% set attio_approvable_tools = attio.tools | selectattr('approvable') | list %}


# === Attio ===

{% for obj in attio.objects %}
{% if obj.attributes %}{{ attio_object_types(obj) }}{% endif %}
{% endfor %}
class AttioAttributeDefinition(BaseModel):
    model_config = ConfigDict(frozen=True)
    api_slug: str
    title: str = ''
    type: str = ''
    is_required: bool = False
    is_unique: bool = False

{% if attio.has_attrs %}

_TSlug = TypeVar('_TSlug', bound=str)
_TRecordValues = TypeVar('_TRecordValues')
_TInputValues = TypeVar('_TInputValues')
_TFilterValues = TypeVar('_TFilterValues')


class AttioObjectType(BaseModel, Generic[_TSlug, _TRecordValues, _TInputValues, _TFilterValues]):
    model_config = ConfigDict(frozen=True)
    api_slug: str
    name: str
    attributes: tuple[AttioAttributeDefinition, ...] = ()

{% else %}

class AttioObjectType(BaseModel):
    model_config = ConfigDict(frozen=True)
    api_slug: str
    name: str
    attributes: tuple[AttioAttributeDefinition, ...] = ()

{% endif %}
{% if attio.objects %}
class AttioObjects:
{% for obj in attio.objects %}
{% if attio.has_attrs and obj.attributes %}
    {{ obj.static_name }}: AttioObjectType[{{ obj.pascal }}AttributeSlug, {{ obj.pascal }}RecordValues, {{ obj.pascal }}InputValues, {{ obj.pascal }}Filter] = AttioObjectType(api_slug={{ obj.api_slug_repr }}, name={{ obj.singular_noun_repr }}, attributes={{ obj.attribute_tuple_repr }})
{% else %}
    {{ obj.static_name }} = AttioObjectType(api_slug={{ obj.api_slug_repr }}, name={{ obj.singular_noun_repr }})
{% endif %}
{% endfor %}
{% else %}
class AttioObjects:
    pass
{% endif %}


class Attio:
    @staticmethod
    def skill(obj: {{ "AttioObjectType[Any, Any, Any, Any]" if attio.has_attrs else "AttioObjectType" }} | None = None) -> SkillConfig[{% if attio_approvable_tools %}AttioToolNames{% else %}str{% endif %}]:
        return SkillConfig(integration_id={{ attio.instance_id_repr }}, integration_type='attio', config_type='attio_output', config=_compact_dict(objectSlug=obj.api_slug if obj else None))
{% if attio.has_attrs %}


_ATTIO_MULTI_VALUE_ATTRS: dict[str, frozenset[str]] = {
{% for obj in attio.objects %}
{% if obj.multi_value_slugs %}
    {{ obj.api_slug_repr }}: {{ obj.multi_value_frozenset_repr }},
{% endif %}
{% endfor %}
}

_ATTIO_METADATA_KEYS = frozenset({'active_from', 'active_until', 'attribute_type', 'created_by_actor'})


def _flatten_attio_leaf(value: Any) -> Any:
    if isinstance(value, dict):
        for key in ('value', 'domain', 'email_address', 'phone_number',
                     'original_phone_number', 'full_name', 'first_name', 'url'):
            if key in value:
                return value[key]
    return value


def _flatten_attio_record(obj_slug: str, raw: object) -> AttioTypedRecord[Any]:
    multi = _ATTIO_MULTI_VALUE_ATTRS.get(obj_slug, frozenset())
    flat: dict[str, Any] = {}
    raw_values = getattr(raw, 'values', None) or {}
    for key, val in raw_values.items():
        if key in _ATTIO_METADATA_KEYS:
            continue
        if isinstance(val, list):
            leaves = [_flatten_attio_leaf(item) for item in val]
            flat[key] = leaves if key in multi else (leaves[0] if leaves else None)
        else:
            flat[key] = _flatten_attio_leaf(val)
    return AttioTypedRecord(
        values=flat,
        id=getattr(raw, 'id', None),
        created_at=getattr(raw, 'created_at', None),
        web_url=getattr(raw, 'web_url', None),
    )
{% endif %}
{% else %}


# === Attio ===


class Attio:
    @staticmethod
    def skill(obj: object | None = None) -> SkillConfig[str]:
        object_slug = getattr(obj, 'api_slug', None) if obj is not None else None
        return SkillConfig(
            integration_id='attio_placeholder',
            integration_type='attio',
            config_type='attio_output',
            config=_compact_dict(objectSlug=object_slug),
        )
{% endif %}
{% endmacro %}
