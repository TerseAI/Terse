{# Snowflake skill helper class.
   Emits nothing when Snowflake is not configured. #}
{% macro snowflake_section(snowflake) %}
{% if snowflake %}
{% set snowflake_approvable_tools = snowflake.tools | selectattr('approvable') | list %}


# === Snowflake ===


class Snowflake:
    @staticmethod
    def skill() -> SkillConfig[{% if snowflake_approvable_tools %}SnowflakeToolNames{% else %}str{% endif %}]:
        return SkillConfig(integration_id={{ snowflake.instance_id_repr }}, integration_type='snowflake', config_type='snowflake_output', config=_compact_dict())
{% else %}


# === Snowflake ===


class Snowflake:
    @staticmethod
    def skill() -> SkillConfig[str]:
        return SkillConfig(
            integration_id='snowflake_placeholder',
            integration_type='snowflake',
            config_type='snowflake_output',
            config=_compact_dict(),
        )
{% endif %}
{% endmacro %}
