{% from "macros/attio/query_records_method.jinja2" import attio_query_records_method %}
{% from "macros/attio/upsert_record_method.jinja2" import attio_upsert_record_method %}

{# _AttioTools, _SnowflakeTools, GeneratedTools, TerseAgent, create_tools,
   attach_tools, and __all__. Always emitted. #}
{% macro deterministic_tools_section(attio, snowflake) %}
{% set attio_tools = attio.tools if attio else [] %}
{% set snowflake_tools = snowflake.tools if snowflake else [] %}
{% set has_attio_tools = attio_tools | length > 0 %}
{% set has_snowflake_tools = snowflake_tools | length > 0 %}
{% set attio_approvable_tools = attio_tools | selectattr('approvable') | list %}
{% set snowflake_approvable_tools = snowflake_tools | selectattr('approvable') | list %}
{% set ns = namespace(exported_names=['Schedule', 'GeneratedTools', 'create_tools', 'attach_tools', 'TerseAgent']) %}
{% for tool in attio_tools + snowflake_tools %}
{% if tool.output_model not in ns.exported_names %}
{% set ns.exported_names = ns.exported_names + [tool.output_model] %}
{% endif %}
{% endfor %}
{% if attio_approvable_tools %}
{% set ns.exported_names = ns.exported_names + ['AttioToolNames'] %}
{% endif %}
{% if snowflake_approvable_tools %}
{% set ns.exported_names = ns.exported_names + ['SnowflakeToolNames'] %}
{% endif %}
{% if attio_approvable_tools or snowflake_approvable_tools %}
{% set ns.exported_names = ns.exported_names + ['AllToolNames'] %}
{% endif %}
{% if attio %}
{% set ns.exported_names = ns.exported_names + ['AttioAttributeDefinition', 'AttioObjectType', 'AttioObjects', 'Attio'] %}
{% if attio.has_attrs %}
{% for obj in attio.objects %}
{% if obj.attributes %}
{% set ns.exported_names = ns.exported_names + [obj.pascal ~ 'RecordValues', obj.pascal ~ 'InputValues', obj.pascal ~ 'Filter', obj.pascal ~ 'AttributeSlug'] %}
{% endif %}
{% endfor %}
{% endif %}
{% else %}
{% set ns.exported_names = ns.exported_names + ['Attio'] %}
{% endif %}
{% if snowflake %}
{% set ns.exported_names = ns.exported_names + ['Snowflake'] %}
{% else %}
{% set ns.exported_names = ns.exported_names + ['Snowflake'] %}
{% endif %}


# === Deterministic tools ===

{% if has_attio_tools %}

_ATTIO_FILTER_ATTRS_BY_OBJECT: dict[str, frozenset[str]] = {
{% for obj in attio.objects %}
{% if obj.attributes %}
    {{ obj.api_slug_repr }}: {{ obj.attr_slugs_frozenset_repr }},
{% endif %}
{% endfor %}
}


def _attio_invalid_filter_error(obj_slug: str, attribute: str | None = None) -> ValueError:
    message = f"Invalid Attio filter for object {obj_slug!r}"
    if attribute is not None:
        message += f" on attribute {attribute!r}"
    message += ": list shorthand is not supported."
    if attribute == 'domains':
        message += ' Use scalar shorthand "useterse.ai" or explicit Attio syntax {"domain": {"$eq": "useterse.ai"}}.'
    else:
        message += " Use a scalar shorthand or explicit Attio operator/object syntax instead."
    return ValueError(message)


def _validate_attio_filter_node(
    obj_slug: str,
    value: object,
    *,
    attr_slugs: frozenset[str],
    current_attribute: str | None = None,
) -> None:
    if isinstance(value, dict):
        for raw_key, child in value.items():
            if not isinstance(raw_key, str):
                raise ValueError(f"Invalid Attio filter for object {obj_slug!r}: filter keys must be strings.")
            key = raw_key
            if key in ('$and', '$or'):
                if not isinstance(child, list):
                    raise ValueError(f"Invalid Attio filter for object {obj_slug!r}: {key} must be a list.")
                for item in child:
                    if not isinstance(item, dict):
                        raise ValueError(f"Invalid Attio filter for object {obj_slug!r}: {key} entries must be objects.")
                    _validate_attio_filter_node(obj_slug, item, attr_slugs=attr_slugs)
                continue
            if key == '$not':
                if not isinstance(child, dict):
                    raise ValueError(f"Invalid Attio filter for object {obj_slug!r}: $not must be an object.")
                _validate_attio_filter_node(obj_slug, child, attr_slugs=attr_slugs)
                continue
            if key == '$in':
                if not isinstance(child, list):
                    raise ValueError(f"Invalid Attio filter for object {obj_slug!r}: $in must be a list.")
                continue
            if key == 'path':
                if not isinstance(child, list):
                    raise ValueError(f"Invalid Attio filter for object {obj_slug!r}: path must be a list.")
                continue
            if key == 'constraints':
                if not isinstance(child, dict):
                    raise ValueError(f"Invalid Attio filter for object {obj_slug!r}: constraints must be an object.")
                _validate_attio_filter_node(
                    obj_slug,
                    child,
                    attr_slugs=attr_slugs,
                    current_attribute=current_attribute,
                )
                continue

            attribute: str | None = key if key in attr_slugs else current_attribute
            if isinstance(child, list):
                raise _attio_invalid_filter_error(obj_slug, attribute)
            _validate_attio_filter_node(
                obj_slug,
                child,
                attr_slugs=attr_slugs,
                current_attribute=attribute,
            )


def _serialize_attio_filter(obj_slug: str, value: object | None) -> str | None:
    if value is None:
        return None

    parsed = value
    if isinstance(value, str):
        try:
            parsed = json.loads(value)
        except json.JSONDecodeError as exc:
            raise ValueError(f"Attio filters for object {obj_slug!r} must be valid JSON objects.") from exc

    if not isinstance(parsed, dict):
        raise ValueError(f"Attio filters for object {obj_slug!r} must be objects.")

    _validate_attio_filter_node(
        obj_slug,
        parsed,
        attr_slugs=_ATTIO_FILTER_ATTRS_BY_OBJECT.get(obj_slug, frozenset()),
    )
    return json.dumps(parsed, separators=(',', ':'), sort_keys=True)


def _serialize_attio_records(records: Sequence[object]) -> str:
    return json.dumps(records, separators=(',', ':'), sort_keys=True)


class _AttioTools:
    def __init__(self, agent: _SdkTerseAgent) -> None:
        self._agent = agent
{% for tool in attio_tools %}
{% if tool.name == "attio_list_objects" %}{{ attio_list_objects_method(tool, attio) }}{% elif tool.name == "attio_query_records" %}{{ attio_query_records_method(tool, attio) }}{% elif tool.name == "attio_upsert_record" %}{{ attio_upsert_record_method(tool, attio) }}{% endif %}
{% endfor %}


{% endif %}
{% if has_snowflake_tools %}
class _SnowflakeTools:
    def __init__(self, agent: _SdkTerseAgent) -> None:
        self._agent = agent
{% for tool in snowflake_tools %}

    def {{ tool.method_name }}(self, query: str) -> {{ tool.output_model }}:
        return {{ tool.output_model }}.model_validate(
            self._agent.execute_tool(
                {{ tool.name_repr }},
                {'integrationId': {{ snowflake.instance_id_repr }}, 'query': query},
            )
        )
{% endfor %}


{% endif %}
{% if has_attio_tools or has_snowflake_tools %}
class GeneratedTools:
{% if has_attio_tools %}
    attio: _AttioTools
{% endif %}
{% if has_snowflake_tools %}
    snowflake: _SnowflakeTools
{% endif %}

    def __init__(
        self,
{% if has_attio_tools %}
        attio: _AttioTools | None = None,
{% endif %}
{% if has_snowflake_tools %}
        snowflake: _SnowflakeTools | None = None,
{% endif %}
    ) -> None:
{% if has_attio_tools %}
        if attio is not None:
            self.attio = attio
{% endif %}
{% if has_snowflake_tools %}
        if snowflake is not None:
            self.snowflake = snowflake
{% endif %}
{% else %}
class GeneratedTools:
    pass
{% endif %}


class TerseAgent(_SdkTerseAgent):
    tools: GeneratedTools


def create_tools(agent: _SdkTerseAgent) -> GeneratedTools:
    allowed = {skill.integration_type for skill in agent.skills}
{% if has_attio_tools or has_snowflake_tools %}
    return GeneratedTools(
{% if has_attio_tools %}
        attio=_AttioTools(agent) if 'attio' in allowed else None,
{% endif %}
{% if has_snowflake_tools %}
        snowflake=_SnowflakeTools(agent) if 'snowflake' in allowed else None,
{% endif %}
    )
{% else %}
    _ = allowed
    return GeneratedTools()
{% endif %}


def attach_tools(agent: _SdkTerseAgent) -> GeneratedTools:
    tools = create_tools(agent)
    agent.attach_tools(tools)
    return tools


__all__ = {{ ns.exported_names | pyrepr }}
{% endmacro %}
