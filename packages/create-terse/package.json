{
    "name": "create-terse",
    "version": "0.0.29",
    "type": "module",
    "description": "Scaffold and launch a self-hosted Terse instance with one command.",
    "keywords": [
        "terse",
        "create-terse",
        "scaffold",
        "self-hosted",
        "ai",
        "workflow",
        "docker-compose"
    ],
    "license": "SEE LICENSE IN LICENSE.md",
    "engines": {
        "node": ">=18"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/TerseAI/Terse.git",
        "directory": "packages/create-terse"
    },
    "homepage": "https://docs.useterse.ai",
    "bugs": {
        "url": "https://github.com/TerseAI/Terse/issues"
    },
    "bin": {
        "create-terse": "dist/index.js"
    },
    "files": [
        "dist",
        "templates"
    ],
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch --preserveWatchOutput",
        "install-global": "npm run build && npm link",
        "format": "pnpm exec prettier --config ../../.prettierrc --write \"src/**/*.ts\"",
        "format:check": "pnpm exec prettier --config ../../.prettierrc --check \"src/**/*.ts\""
    },
    "dependencies": {
        "@clack/prompts": "^1.0.0",
        "chalk": "^5.0.0"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "typescript": "^5.0.0"
    }
}
