// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client-js"
  // output   = "../src/generated/prisma"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users {
  id String @id @default(cuid())

  workos_id  String   @unique
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  linear_integrations       linear_integrations[]
  user_slack_integrations   user_slack_integrations[]
  gmail_integrations        gmail_integrations[]
  notion_integrations       notion_integrations[]
  automations               automations[]
  pending_approvals         pending_approvals[]
  github_app_tokens         github_app_tokens[]
  notification_destinations user_notification_destinations[]
  api_tokens                api_tokens[]
  notification_settings     user_notification_settings?
  posthog_integrations      posthog_integrations[]
  launchdarkly_integrations launchdarkly_integrations[]
  datadog_integrations      datadog_integrations[]
  workos_integrations       workos_integrations[]
  attio_integrations        attio_integrations[]
  snowflake_integrations    snowflake_integrations[]
  project_deploys           project_deploys[]

  @@index([workos_id])
}

model github_app_tokens {
  id              String    @id @default(cuid())
  user_id         String
  organization_id String
  github_username String
  token_expiry    DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, github_username])
  @@index([organization_id])
}

model linear_integrations {
  id              String   @id @default(cuid())
  user_id         String
  organization_id String
  linear_user_id  String
  workspace_id    String
  workspace_name  String
  token_expiry    DateTime
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([organization_id])
  @@index([workspace_id])
  @@index([token_expiry]) // For finding tokens that need refresh
}

model user_slack_integrations {
  id              String   @id @default(cuid())
  user_id         String
  organization_id String
  slack_team_id   String
  authed_user_id  String
  is_bot_user     Boolean  @default(true) // true for bot token, false for user token
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  user                           users                            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  slack_integration              slack_integrations               @relation(fields: [slack_team_id], references: [team_id], onDelete: Cascade)
  user_notification_destinations user_notification_destinations[]

  @@unique([user_id, slack_team_id, is_bot_user])
  @@index([organization_id])
}

model slack_integrations {
  id              String   @id @default(cuid())
  app_id          String
  bot_user_id     String
  team_id         String   @unique
  team_name       String
  enterprise_id   String?
  enterprise_name String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  user_slack_integrations user_slack_integrations[]
  processed_slack_events  processed_slack_events[]
}

model gmail_integrations {
  id                          String    @id @default(cuid())
  user_id                     String
  organization_id             String
  email                       String
  history_id                  String
  watch_expiration            DateTime
  token_expiry                DateTime
  is_active                   Boolean   @default(true)
  last_processed_message_date DateTime? // Track last processed email date to avoid reprocessing
  created_at                  DateTime  @default(now())
  updated_at                  DateTime  @updatedAt

  user                     users                      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  processed_gmail_messages processed_gmail_messages[]

  @@unique([user_id, email]) // Allow multiple Gmail accounts per user, but not duplicates
  @@index([organization_id])
  @@index([email])
  @@index([watch_expiration]) // For finding watches that need renewal
  @@index([is_active]) // For finding active integrations
}

model processed_gmail_messages {
  id                   String   @id @default(cuid())
  gmail_integration_id String
  gmail_message_id     String // Gmail's message ID
  internal_date        String // Gmail's internalDate timestamp
  processed_at         DateTime @default(now())

  gmail_integration gmail_integrations @relation(fields: [gmail_integration_id], references: [id], onDelete: Cascade)

  @@unique([gmail_integration_id, gmail_message_id]) // Prevent processing the same message twice
  @@index([gmail_integration_id])
  @@index([processed_at])
}

model processed_slack_events {
  id                   String   @id @default(cuid())
  slack_integration_id String
  event_id             String // Slack's event_id (e.g., "Ev09R4A73BJL")
  processed_at         DateTime @default(now())

  slack_integration slack_integrations @relation(fields: [slack_integration_id], references: [id], onDelete: Cascade)

  @@unique([slack_integration_id, event_id]) // Prevent processing the same event twice
  @@index([slack_integration_id])
  @@index([processed_at])
}

model notion_integrations {
  id              String   @id @default(cuid())
  user_id         String
  organization_id String
  workspace_id    String?
  workspace_name  String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([organization_id])
  @@index([workspace_id])
}

model posthog_integrations {
  id              String   @id @default(cuid())
  user_id         String
  organization_id String
  user_email      String?
  org_name        String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([organization_id])
}

// LaunchDarkly Integration
model launchdarkly_integrations {
  id              String   @id @default(cuid())
  user_id         String
  organization_id String
  user_email      String?
  token_name      String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([organization_id])
}

model datadog_integrations {
  id              String   @id @default(cuid())
  user_id         String
  organization_id String
  region          String
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([organization_id])
}

// WorkOS Integration (customer's own WorkOS account for user lifecycle triggers)
model workos_integrations {
  id              String   @id @default(cuid())
  user_id         String
  organization_id String
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([organization_id])
}

model attio_integrations {
  id              String   @id @default(cuid())
  user_id         String
  organization_id String
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([organization_id])
}

model snowflake_integrations {
  id                 String   @id @default(cuid())
  user_id            String
  organization_id    String
  account_identifier String
  username           String
  warehouse          String
  database_name      String?
  schema_name        String?
  role_name          String?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([organization_id])
}

model projects {
  id              String   @id @default(cuid())
  organization_id String // No ACL at the moment. Put it on the roadmap.
  name            String
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  // Only for self hosted projects
  signing_secret    String?
  remote_server_url String?

  automations automations[]
  deploys     project_deploys[]
  api_tokens  api_tokens[]

  @@unique([organization_id, name])
}

// Automation tables
model automations {
  id                   String           @id @default(cuid())
  user_id              String
  organization_id      String
  name                 String
  is_active            Boolean          @default(true)
  improvements_enabled Boolean          @default(true)
  require_approval     Boolean          @default(false)
  source               AutomationSource @default(WEB_UI)
  created_at           DateTime         @default(now())
  updated_at           DateTime         @updatedAt

  user                       users                             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  prompt                     automation_prompts?
  inputs                     automation_inputs[]
  outputs                    automation_outputs[]
  run_history_records        run_history_records[]
  notification_settings      automation_notification_settings?
  output_change_attributions output_change_attributions[]
  tool_approvals             automation_tool_approvals[]
  agent_reviews              agent_reviews[]
  agent_improvements         agent_improvements[]
  sent_notifications         sent_notifications[]
  project                    projects?                         @relation(fields: [project_id], references: [id], onDelete: Cascade)
  project_id                 String?

  @@index([user_id])
  @@index([organization_id])
  @@index([is_active])
  @@index([name, organization_id, source, project_id])
}

// Separate table for prompts (future-proof for versioning, templates, etc.)
model automation_prompts {
  id            String   @id @default(cuid())
  automation_id String   @unique
  content       String   @db.Text
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  automation automations @relation(fields: [automation_id], references: [id], onDelete: Cascade)
}

model sdk_dependency_images {
  id              String   @id @default(cuid())
  dependency_hash String   @unique
  runtime         String
  base_image_tag  String
  cli_version     String
  image_id        String   @unique
  last_used_at    DateTime @default(now())
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  source_images sdk_source_images[]

  @@index([runtime])
  @@index([last_used_at])
}

model sdk_source_images {
  id                  String   @id @default(cuid())
  organization_id     String
  runtime             String
  source_hash         String
  gcs_key             String
  image_id            String   @unique
  dependency_image_id String
  last_used_at        DateTime @default(now())
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  dependency_image sdk_dependency_images @relation(fields: [dependency_image_id], references: [id], onDelete: Cascade)
  deploys          project_deploys[]

  @@unique([organization_id, dependency_image_id, source_hash])
  @@index([organization_id])
  @@index([gcs_key])
  @@index([last_used_at])
}

model project_deploys {
  id                  String       @id @default(cuid())
  project_id          String
  sdk_source_image_id String?
  deployed_by_user_id String
  status              DeployStatus
  created_at          DateTime     @default(now())
  updated_at          DateTime     @updatedAt
  completed_at        DateTime?
  failure_reason      String?      @db.VarChar(500)
  jobs_added          Int?
  jobs_removed        Int?

  project          projects              @relation(fields: [project_id], references: [id], onDelete: Cascade)
  sdk_source_image sdk_source_images?    @relation(fields: [sdk_source_image_id], references: [id], onDelete: Cascade)
  deployed_by      users                 @relation(fields: [deployed_by_user_id], references: [id], onDelete: SetNull)
  runs             run_history_records[]
  jobs             project_deploy_jobs[]

  @@index([project_id, created_at(sort: Desc)])
  @@index([sdk_source_image_id])
  @@index([deployed_by_user_id])
}

model project_deploy_jobs {
  deploy_id String
  job_name  String

  deploy project_deploys @relation(fields: [deploy_id], references: [id], onDelete: Cascade)

  @@id([deploy_id, job_name])
  @@index([deploy_id])
}

enum DeployStatus {
  IN_PROGRESS
  SUCCEEDED
  FAILED
  ROLLED_BACK
}

// Polymorphic inputs - can reference any integration type
model automation_inputs {
  id             String          @id @default(cuid())
  automation_id  String
  config_type    InputConfigType
  integration_id String
  created_at     DateTime        @default(now())
  updated_at     DateTime        @updatedAt

  automation automations @relation(fields: [automation_id], references: [id], onDelete: Cascade)

  // Configuration relations (one per integration type)
  slack_config        automation_slack_configs?
  notion_config       automation_notion_configs?
  linear_config       automation_linear_configs?
  github_config       automation_github_configs?
  gmail_config        automation_gmail_configs?
  time_trigger_config automation_time_trigger_configs?
  workos_config       automation_workos_configs?
  attio_config        automation_attio_configs?
  webhook_config      automation_webhook_configs?
  webmonitor_config   automation_webmonitor_configs?

  @@index([automation_id])
  @@index([config_type, integration_id])
}

// Multiple outputs per automation
model automation_outputs {
  id             String           @id @default(cuid())
  automation_id  String
  config_type    OutputConfigType
  integration_id String
  created_at     DateTime         @default(now())
  updated_at     DateTime         @updatedAt

  automation automations @relation(fields: [automation_id], references: [id], onDelete: Cascade)

  // Configuration relations (one per integration type)
  slack_config         automation_slack_configs?
  notion_config        automation_notion_configs?
  linear_config        automation_linear_configs?
  github_config        automation_github_configs?
  gmail_config         automation_gmail_configs?
  posthog_config       automation_posthog_configs?
  datadog_config       automation_datadog_configs?
  launchdarkly_config  automation_launchdarkly_configs?
  workos_output_config automation_workos_output_configs?
  attio_config         automation_attio_configs?
  snowflake_config     automation_snowflake_configs?

  @@index([automation_id])
  @@index([config_type, integration_id])
}

model automation_tool_approvals {
  id            String   @id @default(cuid())
  automation_id String
  tool_name     String
  created_at    DateTime @default(now())

  automation automations @relation(fields: [automation_id], references: [id], onDelete: Cascade)

  @@unique([automation_id, tool_name])
  @@index([automation_id])
}

model automation_posthog_configs {
  id                   String              @id @default(cuid())
  automation_output_id String?             @unique // FK to automation_outputs
  project_id           String // Posthog project ID (required)
  project_name         String? // Posthog project display name (for UI, optional)
  automation_output    automation_outputs? @relation(fields: [automation_output_id], references: [id], onDelete: Cascade)

  @@index([project_id])
}

model automation_launchdarkly_configs {
  id                   String   @id @default(cuid())
  automation_output_id String?  @unique // FK to automation_outputs
  project_key          String // LaunchDarkly project key (required)
  environment_keys     String[] // Array of environment keys to monitor (e.g., ["production", "staging"])

  automation_output automation_outputs? @relation(fields: [automation_output_id], references: [id], onDelete: Cascade)

  @@index([project_key])
}

model automation_datadog_configs {
  id                   String   @id @default(cuid())
  automation_output_id String?  @unique // FK to automation_outputs
  default_indexes      String[] @default(["main"]) // Default log indexes to search, stored as JSON array

  automation_output automation_outputs? @relation(fields: [automation_output_id], references: [id], onDelete: Cascade)

  @@index([default_indexes])
}

model automation_snowflake_configs {
  id                   String  @id @default(cuid())
  automation_output_id String  @unique // FK to automation_outputs
  warehouse            String? // Override warehouse for this automation
  database_name        String? // Override database for this automation
  schema_name          String? // Override schema for this automation

  automation_output automation_outputs @relation(fields: [automation_output_id], references: [id], onDelete: Cascade)
}

// Automation Configuration Tables - Typed config per integration type
// Slack Configuration
model automation_slack_configs {
  id                   String  @id @default(cuid())
  automation_input_id  String? @unique // FK to automation_inputs (mutually exclusive with output_id)
  automation_output_id String? @unique // FK to automation_outputs (unique constraint)

  channel_id         String? // Channel ID (required for outputs, optional for inputs)
  channel_name       String? // Channel display name (for UI, optional)
  listen_to_user_dms Boolean  @default(false) // This integration should include listening to user DMs
  user_ids           String[] // User IDs to listen to
  event_types        String[] @default([])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  automation_input  automation_inputs?  @relation(fields: [automation_input_id], references: [id], onDelete: Cascade)
  automation_output automation_outputs? @relation(fields: [automation_output_id], references: [id], onDelete: Cascade)

  @@index([channel_id])
}

// Notion Configuration (unified: list of allowed databases and/or pages)
model automation_notion_configs {
  id                   String  @id @default(cuid())
  automation_input_id  String? @unique // FK to automation_inputs (mutually exclusive with output_id)
  automation_output_id String? @unique // FK to automation_outputs (unique constraint)

  database_ids   String[] @default([]) // Allowed database IDs (at least one of database_ids or page_ids required for output)
  database_names String[] @default([]) // Display names, parallel to database_ids
  page_ids       String[] @default([]) // Allowed page IDs
  page_names     String[] @default([]) // Display names, parallel to page_ids

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  automation_input  automation_inputs?  @relation(fields: [automation_input_id], references: [id], onDelete: Cascade)
  automation_output automation_outputs? @relation(fields: [automation_output_id], references: [id], onDelete: Cascade)
}

// Linear Configuration
model automation_linear_configs {
  id                   String  @id @default(cuid())
  automation_input_id  String? @unique // FK to automation_inputs (mutually exclusive with output_id)
  automation_output_id String? @unique // FK to automation_outputs (unique constraint)

  team_id      String? // Team ID (required for output, optional for input)
  team_name    String? // Team display name (for UI, optional)
  project_id   String? // Project ID (optional - scopes to specific project)
  project_name String? // Project display name (for UI, optional)
  event_types  String[] @default([])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  automation_input  automation_inputs?  @relation(fields: [automation_input_id], references: [id], onDelete: Cascade)
  automation_output automation_outputs? @relation(fields: [automation_output_id], references: [id], onDelete: Cascade)

  @@index([project_id])
  @@index([team_id])
}

// GitHub Configuration
model automation_github_configs {
  id                   String  @id @default(cuid())
  automation_input_id  String? @unique // FK to automation_inputs (mutually exclusive with output_id)
  automation_output_id String? @unique // FK to automation_outputs (unique constraint)

  repository_ids Int[]
  event_types    String[] @default([])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  automation_input  automation_inputs?  @relation(fields: [automation_input_id], references: [id], onDelete: Cascade)
  automation_output automation_outputs? @relation(fields: [automation_output_id], references: [id], onDelete: Cascade)

  @@index([repository_ids])
}

// Gmail Configuration
model automation_gmail_configs {
  id                   String  @id @default(cuid())
  automation_input_id  String? @unique // FK to automation_inputs (mutually exclusive with output_id)
  automation_output_id String? @unique // FK to automation_outputs (unique constraint)

  // Currently no additional config fields needed, but table exists for consistency
  // Future: could add email filters, label configuration, etc.

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  automation_input  automation_inputs?  @relation(fields: [automation_input_id], references: [id], onDelete: Cascade)
  automation_output automation_outputs? @relation(fields: [automation_output_id], references: [id], onDelete: Cascade)
}

// Attio Configuration
model automation_attio_configs {
  id                   String  @id @default(cuid())
  automation_input_id  String? @unique // FK to automation_inputs (mutually exclusive with output_id)
  automation_output_id String? @unique // FK to automation_outputs (unique constraint)

  object_slug String // Attio object slug (e.g. "people", "companies")

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  automation_input  automation_inputs?  @relation(fields: [automation_input_id], references: [id], onDelete: Cascade)
  automation_output automation_outputs? @relation(fields: [automation_output_id], references: [id], onDelete: Cascade)
}

// Time Trigger Configuration
model automation_time_trigger_configs {
  id                  String @id @default(cuid())
  automation_input_id String @unique // FK to automation_inputs

  cron_expression String

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  automation_input automation_inputs @relation(fields: [automation_input_id], references: [id], onDelete: Cascade)
}

// WorkOS Trigger Configuration
model automation_workos_configs {
  id                  String   @id @default(cuid())
  automation_input_id String   @unique
  event_types         String[]
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  automation_input automation_inputs @relation(fields: [automation_input_id], references: [id], onDelete: Cascade)
}

// Webhook Trigger Configuration
model automation_webhook_configs {
  id                  String @id @default(cuid())
  automation_input_id String @unique
  webhook_token       String @unique

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  automation_input automation_inputs @relation(fields: [automation_input_id], references: [id], onDelete: Cascade)

  @@index([webhook_token])
}

// Web Event (scheduled web monitor) trigger configuration
model automation_webmonitor_configs {
  id                  String  @id @default(cuid())
  automation_input_id String  @unique
  provider_monitor_id String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  automation_input automation_inputs @relation(fields: [automation_input_id], references: [id], onDelete: Cascade)
}

// Idempotent webhook deliveries (Parallel webhook-id deduplication)
model webmonitor_webhook_deliveries {
  id          String   @id @default(cuid())
  webhook_id  String   @unique
  received_at DateTime @default(now())
}

model automation_workos_output_configs {
  id                   String   @id @default(cuid())
  automation_output_id String   @unique
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  automation_output automation_outputs @relation(fields: [automation_output_id], references: [id], onDelete: Cascade)
}

// GitHub Event Types
enum GitHubEventType {
  PUSH
  PULL_REQUEST_OPENED
  PULL_REQUEST_UPDATED
  PULL_REQUEST_MERGED
  PULL_REQUEST_CLOSED
}

// Integration Types for Automation
enum IntegrationType {
  GITHUB
  GMAIL
  LINEAR
  SLACK
  NOTION
  NOTION_PAGE
  TERSE
  POSTHOG
  CRON_JOB
  LAUNCHDARKLY
  DATADOG
  WORKOS
  ATTIO
  SNOWFLAKE
  WEBHOOK
  WEBMONITOR
}

enum InputConfigType {
  GMAIL
  SLACK
  NOTION_PAGE
  NOTION_DATABASE
  LINEAR
  GITHUB
  POSTHOG
  TIME_TRIGGER
  WORKOS_INPUT
  WEBHOOK_INPUT
  WEBMONITOR
}

enum OutputConfigType {
  NOTION
  LINEAR_TICKET
  SLACK_CHANNEL
  GMAIL
  GMAIL_DRAFT
  TERSE
  ATTIO
  GITHUB
  POSTHOG
  LAUNCHDARKLY
  DATADOG
  WORKOS
  SNOWFLAKE
}

enum AutomationSource {
  WEB_UI
  SDK
}

enum KnowledgeBaseConfigType {
  POSTHOG
  GITHUB
  LAUNCHDARKLY
  DATADOG
  LINEAR
  SLACK
  WORKOS
}

// Run History enums to mirror terse-types/RunHistoryTypes
enum RunHistoryStatus {
  success
  failed
  cancelled
  skipped
  in_progress
  awaiting_approval
}

enum RunHistoryDecisionAction {
  processed
  skipped
}

// Chat event types for run history (matches terse-types/ModelEvents.ts ModelEvent types)
enum RunHistoryChatEventType {
  TextDelta
  ToolCall
  ToolCallComplete
  ToolApprovalRequest
  NaturalStop
  FilterResult
  UserMessage
  Thinking
  ToolApprovalResponse
  Snippet
  RunError
}

// Run History tables
model run_history_records {
  id                    String                   @id @default(cuid())
  automation_id         String
  project_deploy_id     String?
  // Timestamp of the run (when the trigger was processed)
  timestamp             DateTime                 @default(now())
  // Trigger details (denormalized onto the record for fast reads)
  event                 String
  trigger_integration   IntegrationType
  trigger_source        String
  trigger_title         String?
  trigger_subheader     String?
  trigger_url           String?
  trigger_payload       Json?
  // Whether this run was manually triggered (from builder chat or Trigger Now button)
  is_manually_triggered Boolean                  @default(false)
  // Whether this item was filtered out by rules before action
  filtered              Boolean                  @default(false)
  // Decision summary
  decision_action       RunHistoryDecisionAction
  decision_reason       String
  // Run status
  status                RunHistoryStatus
  // Whether this run ever involved a tool approval request (persists after approval is processed)
  has_approval_request  Boolean                  @default(false)
  // SDK skill configs (SkillConfigData[]) persisted at run time so correction agents can reconstruct tools
  sdk_skills            Json?
  created_at            DateTime                 @default(now())
  updated_at            DateTime                 @updatedAt

  automation              automations               @relation(fields: [automation_id], references: [id], onDelete: Cascade)
  project_deploy          project_deploys?          @relation(fields: [project_deploy_id], references: [id], onDelete: SetNull)
  actions                 run_history_actions[]
  pending_approval        pending_approvals?
  raw_events              run_history_raw_events[]
  approval_slack_messages approval_slack_messages[]
  sent_notifications      sent_notifications[]

  @@index([automation_id])
  @@index([project_deploy_id])
  @@index([status])
  @@index([timestamp])
  @@index([automation_id, timestamp]) // Composite index for user filtering + time range queries
  @@index([has_approval_request, automation_id, timestamp]) // For pending approvals endpoint
}

model run_history_actions {
  id                    String               @id @default(cuid())
  run_history_record_id String
  action                String
  integration           IntegrationType
  target                String
  details               String
  url                   String?
  step_id               String?
  type                  RunHistoryActionType
  is_read_only          Boolean              @default(true)
  created_at            DateTime             @default(now())

  run_history_record run_history_records @relation(fields: [run_history_record_id], references: [id], onDelete: Cascade)

  @@index([run_history_record_id])
  @@index([step_id])
  @@index([created_at]) // Index for recent actions ORDER BY created_at DESC
  @@index([is_read_only])
}

enum RunHistoryActionType {
  create
  update
  delete
  read
  approve
  error
}

// Pending approvals for tools that require human approval
// Status is tracked via run_history_record.status (awaiting_approval)
// This table stores the serialized state and interruptions separately from run_history_records
// for better data organization and compliance tracking (created_at timestamp)
model pending_approvals {
  id                    String    @id @default(cuid())
  run_history_record_id String    @unique
  serialized_state      String    @db.Text // Serialized OpenAI RunState for resumption (JSON string)
  interruptions         Json // Array of RunToolApprovalItem objects
  created_at            DateTime  @default(now()) // Creation timestamp for compliance tracking
  updated_at            DateTime  @updatedAt
  approved_at           DateTime?

  run_history_record run_history_records @relation(fields: [run_history_record_id], references: [id], onDelete: Cascade)
  users              users?              @relation(fields: [usersId], references: [id])
  usersId            String?

  @@index([created_at])
  @@index([run_history_record_id])
}

// Raw AgentStreamEvent stored as JSON for easy loading into OpenAI agent history
model run_history_raw_events {
  id                    String   @id @default(cuid())
  run_history_record_id String
  event_key             String
  raw_event_json        Json // Raw AgentStreamEvent stored as JSON for easy loading into OpenAI agent history
  sequence_order        Int // Order of items within a session to preserve exact sequence
  created_at            DateTime @default(now())

  run_history_record run_history_records @relation(fields: [run_history_record_id], references: [id], onDelete: Cascade)

  @@unique([run_history_record_id, event_key])
  @@index([run_history_record_id])
  @@index([run_history_record_id, sequence_order])
  @@index([created_at])
}

// Chat session types for general chats (not tied to run history)
enum ChatSessionType {
  SLACK_THREAD
  DIRECT_CHAT
}

// Raw AgentStreamEvent stored as JSON for general chat sessions
model chat_raw_events {
  id              String   @id @default(cuid())
  chat_session_id String
  event_key       String
  raw_event_json  Json // Raw AgentStreamEvent stored as JSON for easy loading into OpenAI agent history
  sequence_order  Int // Order of items within a session to preserve exact sequence
  created_at      DateTime @default(now())

  @@unique([chat_session_id, event_key])
  @@index([chat_session_id])
  @@index([chat_session_id, sequence_order])
  @@index([created_at])
}

// MARK: - Notifications

model automation_notification_settings {
  id            String                 @id @default(cuid())
  automation_id String                 @unique
  enabled       Boolean                @default(true)
  action_types  RunHistoryActionType[]
  created_at    DateTime               @default(now())
  updated_at    DateTime               @updatedAt

  automation automations @relation(fields: [automation_id], references: [id], onDelete: Cascade)
}

model user_notification_destinations {
  id               String                      @id @default(cuid())
  user_id          String
  destination_type NotificationDestinationType

  // Slack-specific fields (uses existing slack_integrations for credentials)
  slack_integration_id String?
  slack_channel_id     String?
  slack_channel_name   String?
  slack_user_id        String?
  slack_user_name      String?

  // Email-specific fields
  email_address String?

  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user              users                    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  slack_integration user_slack_integrations? @relation(fields: [slack_integration_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([destination_type])
  @@index([slack_user_id])
}

model api_tokens {
  id              String    @id @default(cuid())
  user_id         String
  organization_id String
  project_id      String?
  name            String
  token_hash      String    @unique
  token_prefix    String
  last_used_at    DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  user    users     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  project projects? @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([organization_id])
  @@index([project_id])
  @@index([token_hash])
}

model user_notification_settings {
  id                          String                 @id @default(cuid())
  user_id                     String                 @unique
  agent_default_notifications RunHistoryActionType[]
  weekly_agent_improvements   Boolean
  created_at                  DateTime               @default(now())
  updated_at                  DateTime               @updatedAt
  user                        users                  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

enum NotificationDestinationType {
  SLACK
  EMAIL
}

model approval_slack_messages {
  id                        String   @id @default(cuid())
  run_id                    String
  step_id                   String
  slack_channel_id          String
  slack_message_ts          String
  user_slack_integration_id String
  status                    String // "pending", "approved", "rejected", "processing"
  summary                   String? // Cached approval summary to avoid regeneration
  rejection_reason          String? // Reason provided when rejecting the approval
  created_at                DateTime @default(now())
  updated_at                DateTime @updatedAt

  run_history_record run_history_records @relation(fields: [run_id], references: [id], onDelete: Cascade)

  @@unique([run_id, step_id])
  @@index([run_id])
  @@index([step_id])
  @@index([status])
}

enum SentNotificationEventType {
  run_notification
  approval_request
  run_failure
  weekly_review
}

enum SentNotificationStatus {
  sent
  failed
}

enum AgentImprovementStatus {
  PENDING
  APPLIED
  DISMISSED
}

model sent_notifications {
  id                String                      @id @default(cuid())
  organization_id   String
  user_id           String
  automation_id     String?
  run_id            String?
  event_type        SentNotificationEventType
  destination_type  NotificationDestinationType
  destination_label String
  status            SentNotificationStatus
  error_message     String?
  agent_name        String?
  notification_url  String?
  sent_at           DateTime                    @default(now())

  automation         automations?         @relation(fields: [automation_id], references: [id], onDelete: Cascade)
  run_history_record run_history_records? @relation(fields: [run_id], references: [id], onDelete: Cascade)

  @@index([organization_id, sent_at])
  @@index([automation_id])
  @@index([run_id])
}

model agent_reviews {
  id                  String   @id @default(cuid())
  automation_id       String
  organization_id     String
  title               String   @default("")
  summary             String   @db.Text
  runs_analyzed       Int
  review_period_start DateTime
  review_period_end   DateTime
  created_at          DateTime @default(now())

  automation   automations          @relation(fields: [automation_id], references: [id], onDelete: Cascade)
  improvements agent_improvements[]

  @@index([automation_id])
  @@index([organization_id])
  @@index([created_at])
}

model agent_improvements {
  id              String                 @id @default(cuid())
  review_id       String
  automation_id   String
  title           String
  description     String                 @db.Text
  target_area     String
  confidence      Float
  status          AgentImprovementStatus @default(PENDING)
  suggested_patch String?                @db.Text
  applied_prompt  String?                @db.Text
  applied_at      DateTime?
  dismissed_at    DateTime?
  created_at      DateTime               @default(now())
  updated_at      DateTime               @updatedAt

  review     agent_reviews @relation(fields: [review_id], references: [id], onDelete: Cascade)
  automation automations   @relation(fields: [automation_id], references: [id], onDelete: Cascade)

  @@index([automation_id])
  @@index([review_id])
  @@index([status])
  @@index([automation_id, title])
}

model identifiable_refs {
  id          String   @id @default(cuid())
  entity_type String // Validated by app against HydratorType enum
  entity_id   String
  created_at  DateTime @default(now())

  output_change_attributions output_change_attributions[]

  @@unique([entity_type, entity_id])
  @@index([entity_type])
}

model output_change_attributions {
  id                 String           @id @default(cuid())
  automation_id      String // Which automation caused the change
  source_item_ref_id String // Reference to identifiable_refs for the source item that caused the change
  output_item_id     String
  output_item_type   OutputConfigType
  created_at         DateTime         @default(now())

  automation      automations       @relation(fields: [automation_id], references: [id], onDelete: Cascade)
  source_item_ref identifiable_refs @relation(fields: [source_item_ref_id], references: [id], onDelete: Cascade)

  @@index([source_item_ref_id, output_item_id])
}

enum OverageMode {
  soft
  strict
}

model billing_customers {
  id                     String      @id @default(cuid())
  organization_id        String      @unique
  stripe_customer_id     String?     @unique // null for free-only orgs that never upgraded
  overage_mode           OverageMode @default(soft)
  overage_cap_multiplier Decimal     @default(2.0)
  created_at             DateTime    @default(now())
  updated_at             DateTime    @updatedAt

  @@index([stripe_customer_id])
}

// Real-time period consumption counter, purely because docs.stripe.com/billing/subscriptions/usage-based/recording-usage-api
model billing_period_consumption {
  id                  String   @id @default(cuid())
  organization_id     String   @unique
  period_start        DateTime
  period_end          DateTime
  consumed_credits    Int      @default(0)
  notified_thresholds Int[]    @default([])
  updated_at          DateTime @updatedAt
}
