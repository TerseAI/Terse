// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users {
  id              String   @id @default(cuid())
  email           String   @unique
  display_name    String
  github_username String?  @unique
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  is_placeholder  Boolean  @default(false)

  user_github_repositories user_github_repositories[]
  linear_api_keys          linear_api_keys[]
  user_slack_integrations  user_slack_integrations[]
  jira_api_keys            jira_api_keys[]
  gmail_integrations       gmail_integrations[]
  notion_integrations      notion_integrations[]
  activity_events          activity_events[]
  ticket_activity_events   ticket_activity_events[]
  project_activity_events  project_activity_events[]
  automations              automations[]
}

model github_repositories {
  id              String   @id @default(cuid())
  name            String
  owner           String
  installation_id Int
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  user_github_repositories user_github_repositories[]
  activity_events          activity_events[]
}

model user_github_repositories {
  id                   String   @id @default(cuid())
  user_id              String
  github_repository_id String
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  user              users               @relation(fields: [user_id], references: [id])
  github_repository github_repositories @relation(fields: [github_repository_id], references: [id])

  @@unique([user_id, github_repository_id])
}

model linear_api_keys {
  id             String   @id @default(cuid())
  user_id        String
  linear_user_id String
  workspace_id   String?
  workspace_name String?
  team_id        String?
  team_name      String?
  api_key        String   @unique
  webhook_secret String
  webhook_id     String
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  user users @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@index([workspace_id, team_id])
}

model user_slack_integrations {
  id             String   @id @default(cuid())
  user_id        String
  slack_team_id  String
  dm_channel_id  String?
  authed_user_id String
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  user              users              @relation(fields: [user_id], references: [id])
  slack_integration slack_integrations @relation(fields: [slack_team_id], references: [team_id])

  @@unique([user_id, slack_team_id])
}

model slack_integrations {
  id              String   @id @default(cuid())
  app_id          String
  scope           String   @default("")
  access_token    String
  bot_user_id     String
  team_id         String   @unique
  team_name       String
  enterprise_id   String?
  enterprise_name String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  user_slack_integrations user_slack_integrations[]
}

model jira_api_keys {
  id              String   @id @default(cuid())
  user_id         String
  jira_user_email String
  base_url        String
  site_name       String?
  project_key     String?
  project_name    String?
  webhook_id      String?
  api_token       String   @unique
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  user users @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@index([base_url, project_key])
}

model gmail_integrations {
  id                          String    @id @default(cuid())
  user_id                     String
  email                       String
  history_id                  String
  watch_expiration            DateTime
  access_token                String
  refresh_token               String
  token_expiry                DateTime
  is_active                   Boolean   @default(true)
  last_processed_message_date DateTime? // Track last processed email date to avoid reprocessing
  created_at                  DateTime  @default(now())
  updated_at                  DateTime  @updatedAt

  user                     users                      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  processed_gmail_messages processed_gmail_messages[]

  @@unique([user_id, email]) // Allow multiple Gmail accounts per user, but not duplicates
  @@index([email])
  @@index([watch_expiration]) // For finding watches that need renewal
  @@index([is_active]) // For finding active integrations
}

model processed_gmail_messages {
  id                   String   @id @default(cuid())
  gmail_integration_id String
  gmail_message_id     String // Gmail's message ID
  internal_date        String // Gmail's internalDate timestamp
  processed_at         DateTime @default(now())

  gmail_integration gmail_integrations @relation(fields: [gmail_integration_id], references: [id], onDelete: Cascade)

  @@unique([gmail_integration_id, gmail_message_id]) // Prevent processing the same message twice
  @@index([gmail_integration_id])
  @@index([processed_at])
}

model notion_integrations {
  id                String   @id @default(cuid())
  user_id           String
  workspace_id      String?
  workspace_name    String?
  database_id       String
  database_name     String?
  integration_token String
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([workspace_id, database_id])
}

// Activity Feed - Starting with GitHub Events
model activity_events {
  id                   String          @id @default(cuid())
  user_id              String
  title                String
  event_type           GitHubEventType
  github_repository_id String
  created_at           DateTime        @default(now())
  updated_at           DateTime        @updatedAt

  github_repository       github_repositories       @relation(fields: [github_repository_id], references: [id], onDelete: Cascade)
  users                   users?                    @relation(fields: [user_id], references: [id])
  sub_activity_events     sub_activity_events[]
  project_activity_events project_activity_events[]
  ticket_activity_events  ticket_activity_events[]

  @@index([event_type])
}

model sub_activity_events {
  id                String   @id @default(cuid())
  summary           String
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
  activity_event_id String

  activity_events                  activity_events                    @relation(fields: [activity_event_id], references: [id], onDelete: Cascade)
  sub_activity_commit_associations sub_activity_commit_associations[]
}

model sub_activity_commit_associations {
  id                    String   @id @default(cuid())
  commit_sha            String
  commit_message        String
  commit_url            String
  created_at            DateTime @default(now())
  sub_activity_event_id String

  sub_activity_events sub_activity_events @relation(fields: [sub_activity_event_id], references: [id], onDelete: Cascade)
}

model ticket_activity_events {
  id                String          @id @default(cuid())
  activity_event_id String
  user_id           String
  event_type        TicketEventType
  ticket_id         String // External ticket ID (Linear/Jira)
  title             String
  created_at        DateTime        @default(now())
  updated_at        DateTime        @updatedAt

  activity_events activity_events @relation(fields: [activity_event_id], references: [id], onDelete: Cascade)
  users           users           @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([ticket_id])
}

model project_activity_events {
  id                String   @id @default(cuid())
  user_id           String
  project_id        String
  activity_event_id String
  title             String // This should be a summary of change in relation to this project
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  activity_events activity_events @relation(fields: [activity_event_id], references: [id], onDelete: Cascade)
  users           users           @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([project_id])
}

// Automation tables
model automations {
  id         String   @id @default(cuid())
  user_id    String
  name       String
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user                users                 @relation(fields: [user_id], references: [id], onDelete: Cascade)
  prompt              automation_prompts?
  inputs              automation_inputs[]
  output              automation_outputs?
  run_history_records run_history_records[]

  @@index([user_id])
  @@index([is_active])
}

// Separate table for prompts (future-proof for versioning, templates, etc.)
model automation_prompts {
  id            String   @id @default(cuid())
  automation_id String   @unique
  content       String   @db.Text
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  automation automations @relation(fields: [automation_id], references: [id], onDelete: Cascade)
}

// Polymorphic inputs - can reference any integration type
model automation_inputs {
  id               String          @id @default(cuid())
  automation_id    String
  integration_type IntegrationType
  integration_id   String
  created_at       DateTime        @default(now())
  updated_at       DateTime        @updatedAt

  automation automations @relation(fields: [automation_id], references: [id], onDelete: Cascade)

  @@index([automation_id])
  @@index([integration_type, integration_id])
}

// Single output per automation
model automation_outputs {
  id               String          @id @default(cuid())
  automation_id    String          @unique
  integration_type IntegrationType
  integration_id   String
  created_at       DateTime        @default(now())
  updated_at       DateTime        @updatedAt

  automation automations @relation(fields: [automation_id], references: [id], onDelete: Cascade)

  @@index([integration_type, integration_id])
}

enum TicketEventType {
  TICKET_CREATED
  TICKET_UPDATED
  COMMENT_ADDED
}

// GitHub Event Types
enum GitHubEventType {
  PUSH
  PULL_REQUEST_OPENED
  PULL_REQUEST_UPDATED
  PULL_REQUEST_MERGED
  PULL_REQUEST_CLOSED
}

// Integration Types for Automation
enum IntegrationType {
  GITHUB
  GMAIL
  LINEAR
  JIRA
  SLACK
  NOTION
}

// Run History enums to mirror backend/shared RunHistoryTypes
enum RunHistoryStatus {
  success
  failed
  skipped
  in_progress
}

enum RunHistoryDecisionAction {
  processed
  skipped
}

// Integration values for Run History (matches backend/src/shared/RunHistoryTypes.ts)
enum RunHistoryIntegration {
  jira
  linear
  slack
  github
  notion
  gmail
}

// Run History tables
model run_history_records {
  id                  String                   @id @default(cuid())
  automation_id       String
  // Timestamp of the run (when the trigger was processed)
  timestamp           DateTime                 @default(now())
  // Trigger details (denormalized onto the record for fast reads)
  event               String
  trigger_integration RunHistoryIntegration
  trigger_source      String
  trigger_title       String?
  trigger_subheader   String?
  trigger_url         String?
  // Whether this item was filtered out by rules before action
  filtered            Boolean                  @default(false)
  // Decision summary
  decision_action     RunHistoryDecisionAction
  decision_reason     String
  // Run status
  status              RunHistoryStatus
  created_at          DateTime                 @default(now())
  updated_at          DateTime                 @updatedAt

  automation automations           @relation(fields: [automation_id], references: [id], onDelete: Cascade)
  actions    run_history_actions[]

  @@index([automation_id])
  @@index([status])
  @@index([timestamp])
}

model run_history_actions {
  id                    String                @id @default(cuid())
  run_history_record_id String
  action                String
  integration           RunHistoryIntegration
  target                String
  details               String
  url                   String?
  created_at            DateTime              @default(now())

  run_history_record run_history_records @relation(fields: [run_history_record_id], references: [id], onDelete: Cascade)

  @@index([run_history_record_id])
}
