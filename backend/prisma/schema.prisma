// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users {
  id              String   @id @default(cuid())
  email           String   @unique
  display_name    String
  github_username String?  @unique
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  is_placeholder  Boolean  @default(false)

  user_github_repositories  user_github_repositories[]
  linear_api_keys           linear_api_keys[] // @deprecated - Use linear_integrations instead
  linear_integrations       linear_integrations[]
  user_slack_integrations   user_slack_integrations[]
  jira_api_keys             jira_api_keys[] // @deprecated - Use atlassian_integrations instead
  atlassian_integrations    atlassian_integrations[]
  gmail_integrations        gmail_integrations[]
  notion_integrations       notion_integrations[]
  figma_integrations        figma_integrations[]
  activity_events           activity_events[]
  ticket_activity_events    ticket_activity_events[]
  project_activity_events   project_activity_events[]
  automations               automations[]
  pending_approvals         pending_approvals[]
  user_github_installation  user_github_installation[]
  github_app_tokens         github_app_tokens[]
  notification_destinations user_notification_destinations[]
}

model github_repositories {
  id              String   @id @default(cuid())
  name            String
  owner           String
  installation_id Int
  repository_id   Int      @default(0) // has to be optional, or we will blow things up in prod.... This is the official id from github
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  user_github_repositories user_github_repositories[]
  activity_events          activity_events[]

  @@unique([installation_id, repository_id])
}

model user_github_installation {
  id              String   @id @default(cuid())
  user_id         String? // Set by SetUpURL step. Webhook could come first though, so this needs to be nullable.
  installation_id Int      @unique
  account_name    String? // GitHub username or organization name where the app was installed
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  user users? @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model user_github_repositories {
  id                   String   @id @default(cuid())
  user_id              String
  github_repository_id String
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  user              users               @relation(fields: [user_id], references: [id])
  github_repository github_repositories @relation(fields: [github_repository_id], references: [id])

  @@unique([user_id, github_repository_id])
}

model github_app_tokens {
  id              String    @id @default(cuid())
  user_id         String
  github_username String
  access_token    String
  refresh_token   String?
  token_expiry    DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, github_username])
}

// @deprecated - This table is deprecated. Use linear_integrations instead for OAuth-based connections.
// The old table is kept for backward compatibility with existing API key-based connections.
model linear_api_keys {
  id             String   @id @default(cuid())
  user_id        String
  linear_user_id String
  workspace_id   String?
  workspace_name String?
  team_id        String? // Connection-level default project/team. Can be overridden per automation via automation_linear_configs.project_id
  team_name      String? // Connection-level default project name. Can be overridden per automation via automation_linear_configs.project_name
  api_key        String   @unique
  webhook_secret String
  webhook_id     String
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  user users @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@index([workspace_id, team_id])
}

// Replaces linear_api_keys for new OAuth connections
model linear_integrations {
  id             String   @id @default(cuid())
  user_id        String
  linear_user_id String
  workspace_id   String
  workspace_name String
  access_token   String
  refresh_token  String
  token_expiry   DateTime
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([workspace_id])
  @@index([token_expiry]) // For finding tokens that need refresh
}

model user_slack_integrations {
  id                       String   @id @default(cuid())
  user_id                  String
  slack_team_id            String
  authed_user_id           String
  authed_user_access_token String?
  is_bot_user              Boolean  @default(true) // true for bot token, false for user token
  created_at               DateTime @default(now())
  updated_at               DateTime @updatedAt

  user                           users                            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  slack_integration              slack_integrations               @relation(fields: [slack_team_id], references: [team_id], onDelete: Cascade)
  user_notification_destinations user_notification_destinations[]

  @@unique([user_id, slack_team_id, is_bot_user])
}

model slack_integrations {
  id              String   @id @default(cuid())
  app_id          String
  access_token    String
  bot_user_id     String
  team_id         String   @unique
  team_name       String
  enterprise_id   String?
  enterprise_name String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  user_slack_integrations user_slack_integrations[]
  processed_slack_events  processed_slack_events[]
}

// @deprecated - This table is deprecated. Use atlassian_integrations instead for OAuth-based connections.
// The old table is kept for backward compatibility with existing API key-based connections.
model jira_api_keys {
  id              String   @id @default(cuid())
  user_id         String
  jira_user_email String
  base_url        String
  site_name       String?
  project_key     String? // Connection-level default project key. Can be overridden per automation via automation_jira_configs.project_key
  project_name    String? // Connection-level default project name (display only, not migrated to config table)
  webhook_id      String?
  api_token       String   @unique
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  user users @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@index([base_url, project_key])
}

// Replaces jira_api_keys for new OAuth connections
model atlassian_integrations {
  id              String   @id @default(cuid())
  user_id         String
  jira_user_email String // User email in Atlassian/Jira
  base_url        String // Base URL of the Atlassian instance (e.g., https://company.atlassian.net)
  cloud_id        String // Atlassian cloud ID for API calls
  site_name       String? // Extracted site name from base_url
  project_key     String? // Connection-level default project key. Can be overridden per automation via automation_jira_configs.project_key
  project_name    String? // Connection-level default project name (display only)
  webhook_id      String? // Webhook ID for Jira events
  webhook_secret  String? // Webhook secret for verifying webhook payloads
  access_token    String // OAuth access token
  refresh_token   String // OAuth refresh token
  token_expiry    DateTime // Token expiration time
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([base_url, project_key])
  @@index([token_expiry]) // For finding tokens that need refresh
}

model gmail_integrations {
  id                          String    @id @default(cuid())
  user_id                     String
  email                       String
  history_id                  String
  watch_expiration            DateTime
  access_token                String
  refresh_token               String
  token_expiry                DateTime
  is_active                   Boolean   @default(true)
  last_processed_message_date DateTime? // Track last processed email date to avoid reprocessing
  created_at                  DateTime  @default(now())
  updated_at                  DateTime  @updatedAt

  user                     users                      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  processed_gmail_messages processed_gmail_messages[]

  @@unique([user_id, email]) // Allow multiple Gmail accounts per user, but not duplicates
  @@index([email])
  @@index([watch_expiration]) // For finding watches that need renewal
  @@index([is_active]) // For finding active integrations
}

model processed_gmail_messages {
  id                   String   @id @default(cuid())
  gmail_integration_id String
  gmail_message_id     String // Gmail's message ID
  internal_date        String // Gmail's internalDate timestamp
  processed_at         DateTime @default(now())

  gmail_integration gmail_integrations @relation(fields: [gmail_integration_id], references: [id], onDelete: Cascade)

  @@unique([gmail_integration_id, gmail_message_id]) // Prevent processing the same message twice
  @@index([gmail_integration_id])
  @@index([processed_at])
}

model processed_slack_events {
  id                   String   @id @default(cuid())
  slack_integration_id String
  event_id             String // Slack's event_id (e.g., "Ev09R4A73BJL")
  processed_at         DateTime @default(now())

  slack_integration slack_integrations @relation(fields: [slack_integration_id], references: [id], onDelete: Cascade)

  @@unique([slack_integration_id, event_id]) // Prevent processing the same event twice
  @@index([slack_integration_id])
  @@index([processed_at])
}

model notion_integrations {
  id                String   @id @default(cuid())
  user_id           String
  workspace_id      String?
  workspace_name    String?
  integration_token String
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([workspace_id])
}

model figma_integrations {
  id            String   @id @default(cuid())
  user_id       String
  handle        String
  figma_user_id String
  access_token  String
  refresh_token String
  token_expiry  DateTime
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  user                     users                      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  processed_figma_comments processed_figma_comments[]
  figma_comment_context    figma_comment_context[]
  figma_webhooks           figma_webhooks[]

  @@index([user_id])
  @@index([figma_user_id])
}

// Track processed Figma comments to prevent duplicate processing
model processed_figma_comments {
  id                   String   @id @default(cuid())
  figma_integration_id String
  comment_id           String // Figma's comment ID
  file_key             String
  processed_at         DateTime @default(now())

  figma_integration figma_integrations @relation(fields: [figma_integration_id], references: [id], onDelete: Cascade)

  @@unique([figma_integration_id, comment_id]) // Prevent processing the same comment twice
  @@index([figma_integration_id])
  @@index([file_key])
  @@index([processed_at])
}

// Track Figma webhooks created for automations
// Team-level webhooks: one per team per event type per integration
// Multiple automations can share the same team-level webhook
model figma_webhooks {
  id                   String   @id @default(cuid())
  figma_integration_id String
  webhook_id           String // Figma's webhook ID
  team_id              String // Team ID (required for team-level webhooks)
  endpoint_url         String // Our webhook endpoint URL
  passcode             String // Secure passcode for webhook verification
  event_type           String   @default("FILE_UPDATE") // Event type: FILE_COMMENT or FILE_UPDATE
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  figma_integration figma_integrations @relation(fields: [figma_integration_id], references: [id], onDelete: Cascade)

  @@unique([figma_integration_id, team_id, event_type]) // One webhook per team per event type per integration
  @@index([figma_integration_id])
  @@index([team_id])
  @@index([webhook_id])
  @@index([event_type])
}

// Store enriched comment context for AI/documentation
model figma_comment_context {
  id                   String    @id @default(cuid())
  figma_integration_id String
  comment_id           String
  file_key             String
  node_id              String? // Node ID the comment is attached to
  comment_data         Json // Full comment data from Figma API
  file_metadata        Json? // File metadata (from GET /v1/files/:key/meta)
  positioning_data     Json? // Parsed client_meta positioning data (Vector/FrameOffset/Region/etc.)
  matched_node_ids     String[] // Array of node IDs that match the comment position
  image_urls           Json? // Object with image URLs (e.g., { nodeImage: "...", contextImage: "...", fullFrame: "..." })
  image_expiry         DateTime? // Images expire after 24-48 hours per Figma API
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  figma_integration figma_integrations @relation(fields: [figma_integration_id], references: [id], onDelete: Cascade)

  @@unique([figma_integration_id, comment_id])
  @@index([figma_integration_id])
  @@index([file_key])
  @@index([node_id])
  @@index([created_at])
}

// Activity Feed - Starting with GitHub Events
model activity_events {
  id                   String          @id @default(cuid())
  user_id              String
  title                String
  event_type           GitHubEventType
  github_repository_id String
  created_at           DateTime        @default(now())
  updated_at           DateTime        @updatedAt

  github_repository       github_repositories       @relation(fields: [github_repository_id], references: [id], onDelete: Cascade)
  users                   users?                    @relation(fields: [user_id], references: [id])
  sub_activity_events     sub_activity_events[]
  project_activity_events project_activity_events[]
  ticket_activity_events  ticket_activity_events[]

  @@index([event_type])
}

model sub_activity_events {
  id                String   @id @default(cuid())
  summary           String
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
  activity_event_id String

  activity_events                  activity_events                    @relation(fields: [activity_event_id], references: [id], onDelete: Cascade)
  sub_activity_commit_associations sub_activity_commit_associations[]
}

model sub_activity_commit_associations {
  id                    String   @id @default(cuid())
  commit_sha            String
  commit_message        String
  commit_url            String
  created_at            DateTime @default(now())
  sub_activity_event_id String

  sub_activity_events sub_activity_events @relation(fields: [sub_activity_event_id], references: [id], onDelete: Cascade)
}

model ticket_activity_events {
  id                String          @id @default(cuid())
  activity_event_id String
  user_id           String
  event_type        TicketEventType
  ticket_id         String // External ticket ID (Linear/Jira)
  title             String
  created_at        DateTime        @default(now())
  updated_at        DateTime        @updatedAt

  activity_events activity_events @relation(fields: [activity_event_id], references: [id], onDelete: Cascade)
  users           users           @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([ticket_id])
}

model project_activity_events {
  id                String   @id @default(cuid())
  user_id           String
  project_id        String
  activity_event_id String
  title             String // This should be a summary of change in relation to this project
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  activity_events activity_events @relation(fields: [activity_event_id], references: [id], onDelete: Cascade)
  users           users           @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([project_id])
}

// Automation tables
model automations {
  id         String   @id @default(cuid())
  user_id    String
  name       String
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user                  users                             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  prompt                automation_prompts?
  inputs                automation_inputs[]
  output                automation_outputs?
  run_history_records   run_history_records[]
  directiveRecords      directive_records[]
  notification_settings automation_notification_settings?

  @@index([user_id])
  @@index([is_active])
}

// Separate table for prompts (future-proof for versioning, templates, etc.)
model automation_prompts {
  id            String   @id @default(cuid())
  automation_id String   @unique
  content       String   @db.Text
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  automation automations @relation(fields: [automation_id], references: [id], onDelete: Cascade)
}

// Polymorphic inputs - can reference any integration type
model automation_inputs {
  id             String          @id @default(cuid())
  automation_id  String
  config_type    InputConfigType
  integration_id String
  created_at     DateTime        @default(now())
  updated_at     DateTime        @updatedAt

  automation automations @relation(fields: [automation_id], references: [id], onDelete: Cascade)

  // Configuration relations (one per integration type)
  slack_config       automation_slack_configs?
  notion_config      automation_notion_configs?
  notion_page_config automation_notion_page_configs?
  linear_config      automation_linear_configs?
  jira_config        automation_jira_configs?
  confluence_config  automation_confluence_configs?
  github_config      automation_github_configs?
  gmail_config       automation_gmail_configs?
  figma_config       automation_figma_configs?

  @@index([automation_id])
  @@index([config_type, integration_id])
}

// Single output per automation
model automation_outputs {
  id             String           @id @default(cuid())
  automation_id  String           @unique
  config_type    OutputConfigType
  integration_id String
  created_at     DateTime         @default(now())
  updated_at     DateTime         @updatedAt

  automation automations @relation(fields: [automation_id], references: [id], onDelete: Cascade)

  // Configuration relations (one per integration type)
  slack_config       automation_slack_configs?
  notion_config      automation_notion_configs?
  notion_page_config automation_notion_page_configs?
  linear_config      automation_linear_configs?
  jira_config        automation_jira_configs?
  confluence_config  automation_confluence_configs?
  github_config      automation_github_configs?
  gmail_config       automation_gmail_configs?
  figma_config       automation_figma_configs?

  @@index([config_type, integration_id])
}

// Automation Configuration Tables - Typed config per integration type
// Slack Configuration
model automation_slack_configs {
  id                   String  @id @default(cuid())
  automation_input_id  String? @unique // FK to automation_inputs (mutually exclusive with output_id)
  automation_output_id String? @unique // FK to automation_outputs (unique constraint)

  channel_id         String? // Channel ID (required for outputs, optional for inputs)
  channel_name       String? // Channel display name (for UI, optional)
  listen_to_user_dms Boolean @default(false) // This integration should include listening to user DMs

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  automation_input  automation_inputs?  @relation(fields: [automation_input_id], references: [id], onDelete: Cascade)
  automation_output automation_outputs? @relation(fields: [automation_output_id], references: [id], onDelete: Cascade)

  @@index([channel_id])
}

// Notion Configuration - This is really for Databases!!
model automation_notion_configs {
  id                   String  @id @default(cuid())
  automation_input_id  String? @unique // FK to automation_inputs (mutually exclusive with output_id)
  automation_output_id String? @unique // FK to automation_outputs (unique constraint)

  database_id   String // Database ID (required for outputs, optional for inputs)
  database_name String // Database display name (for UI, optional)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  automation_input  automation_inputs?  @relation(fields: [automation_input_id], references: [id], onDelete: Cascade)
  automation_output automation_outputs? @relation(fields: [automation_output_id], references: [id], onDelete: Cascade)

  @@index([database_id])
}

// Notion Page Configuration
model automation_notion_page_configs {
  id                   String  @id @default(cuid())
  automation_input_id  String? @unique // FK to automation_inputs (mutually exclusive with output_id)
  automation_output_id String? @unique // FK to automation_outputs (unique constraint)

  page_id   String // Page ID (required for outputs, optional for inputs)
  page_name String // Page display name (for UI, optional)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  automation_input  automation_inputs?  @relation(fields: [automation_input_id], references: [id], onDelete: Cascade)
  automation_output automation_outputs? @relation(fields: [automation_output_id], references: [id], onDelete: Cascade)

  @@index([page_id])
}

// Linear Configuration
model automation_linear_configs {
  id                   String  @id @default(cuid())
  automation_input_id  String? @unique // FK to automation_inputs (mutually exclusive with output_id)
  automation_output_id String? @unique // FK to automation_outputs (unique constraint)

  team_id      String? // Team ID (required for output, optional for input)
  team_name    String? // Team display name (for UI, optional)
  project_id   String? // Project ID (optional - scopes to specific project)
  project_name String? // Project display name (for UI, optional)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  automation_input  automation_inputs?  @relation(fields: [automation_input_id], references: [id], onDelete: Cascade)
  automation_output automation_outputs? @relation(fields: [automation_output_id], references: [id], onDelete: Cascade)

  @@index([project_id])
  @@index([team_id])
}

// Jira Configuration
model automation_jira_configs {
  id                   String  @id @default(cuid())
  automation_input_id  String? @unique // FK to automation_inputs (mutually exclusive with output_id)
  automation_output_id String? @unique // FK to automation_outputs (unique constraint)

  project_key String? // Project key (optional - can override connection default)
  project_id  String? // Project ID (optional - can be used instead of key)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  automation_input  automation_inputs?  @relation(fields: [automation_input_id], references: [id], onDelete: Cascade)
  automation_output automation_outputs? @relation(fields: [automation_output_id], references: [id], onDelete: Cascade)

  @@index([project_key])
  @@index([project_id])
}

// Confluence Configuration
model automation_confluence_configs {
  id                   String  @id @default(cuid())
  automation_input_id  String? @unique // FK to automation_inputs (mutually exclusive with output_id)
  automation_output_id String? @unique // FK to automation_outputs (unique constraint)

  space_id   String // Space ID (optional - can be used to target specific space)
  space_name String // Space name (optional - can be used instead of space_id)
  page_id    String // Page ID (required for outputs - specific page to write to)
  page_name  String // Page display name (for UI, optional)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  automation_input  automation_inputs?  @relation(fields: [automation_input_id], references: [id], onDelete: Cascade)
  automation_output automation_outputs? @relation(fields: [automation_output_id], references: [id], onDelete: Cascade)

  @@index([space_name])
  @@index([space_id])
  @@index([page_id])
}

// GitHub Configuration
model automation_github_configs {
  id                   String  @id @default(cuid())
  automation_input_id  String? @unique // FK to automation_inputs (mutually exclusive with output_id)
  automation_output_id String? @unique // FK to automation_outputs (unique constraint)

  repository_ids Int[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  automation_input  automation_inputs?  @relation(fields: [automation_input_id], references: [id], onDelete: Cascade)
  automation_output automation_outputs? @relation(fields: [automation_output_id], references: [id], onDelete: Cascade)
  // Future: could add branch, path filters for more granular control

  @@index([repository_ids])
}

// Gmail Configuration
model automation_gmail_configs {
  id                   String  @id @default(cuid())
  automation_input_id  String? @unique // FK to automation_inputs (mutually exclusive with output_id)
  automation_output_id String? @unique // FK to automation_outputs (unique constraint)

  // Currently no additional config fields needed, but table exists for consistency
  // Future: could add email filters, label configuration, etc.

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  automation_input  automation_inputs?  @relation(fields: [automation_input_id], references: [id], onDelete: Cascade)
  automation_output automation_outputs? @relation(fields: [automation_output_id], references: [id], onDelete: Cascade)
}

// Figma Configuration
model automation_figma_configs {
  id                   String  @id @default(cuid())
  automation_input_id  String? @unique // FK to automation_inputs (mutually exclusive with output_id)
  automation_output_id String? @unique // FK to automation_outputs (unique constraint)

  file_key  String // Figma file key (required for inputs - specifies which file to monitor)
  file_name String? // File display name (for UI, optional)
  team_id   String? // Figma team ID (required for webhook creation)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  automation_input  automation_inputs?  @relation(fields: [automation_input_id], references: [id], onDelete: Cascade)
  automation_output automation_outputs? @relation(fields: [automation_output_id], references: [id], onDelete: Cascade)

  @@index([file_key])
  @@index([team_id])
}

enum TicketEventType {
  TICKET_CREATED
  TICKET_UPDATED
  COMMENT_ADDED
}

// GitHub Event Types
enum GitHubEventType {
  PUSH
  PULL_REQUEST_OPENED
  PULL_REQUEST_UPDATED
  PULL_REQUEST_MERGED
  PULL_REQUEST_CLOSED
}

// Integration Types for Automation
enum IntegrationType {
  GITHUB
  GMAIL
  LINEAR
  JIRA
  CONFLUENCE
  SLACK
  NOTION
  NOTION_PAGE
  FIGMA
  TERSE
}

enum InputConfigType {
  GMAIL
  FIGMA
  SLACK
  NOTION_PAGE
  NOTION_DATABASE
  LINEAR
  GITHUB
  JIRA
  CONFLUENCE
}

enum OutputConfigType {
  NOTION_PAGE
  NOTION_DATABASE
  CONFLUENCE
  LINEAR_TICKET
}

// Run History enums to mirror backend/shared RunHistoryTypes
enum RunHistoryStatus {
  success
  failed
  skipped
  in_progress
  awaiting_approval
}

enum RunHistoryDecisionAction {
  processed
  skipped
}

// Chat event types for run history (matches shared/ModelEvents.ts ModelEvent types)
enum RunHistoryChatEventType {
  TextDelta
  ToolCall
  ToolCallComplete
  ToolApprovalRequest
  NaturalStop
  Failure
  FilterResult
  UserMessage
  Thinking
}

// Run History tables
model run_history_records {
  id                  String                   @id @default(cuid())
  automation_id       String
  // Timestamp of the run (when the trigger was processed)
  timestamp           DateTime                 @default(now())
  // Trigger details (denormalized onto the record for fast reads)
  event               String
  trigger_integration IntegrationType
  trigger_source      String
  trigger_title       String?
  trigger_subheader   String?
  trigger_url         String?
  // Whether this item was filtered out by rules before action
  filtered            Boolean                  @default(false)
  // Decision summary
  decision_action     RunHistoryDecisionAction
  decision_reason     String
  // Run status
  status              RunHistoryStatus
  created_at          DateTime                 @default(now())
  updated_at          DateTime                 @updatedAt

  automation       automations               @relation(fields: [automation_id], references: [id], onDelete: Cascade)
  actions          run_history_actions[]
  pending_approval pending_approvals?
  chat_events      run_history_chat_events[]
  raw_events       run_history_raw_events[]
  directiveRecords directive_records[]

  @@index([automation_id])
  @@index([status])
  @@index([timestamp])
  @@index([automation_id, timestamp]) // Composite index for user filtering + time range queries
}

model run_history_actions {
  id                    String               @id @default(cuid())
  run_history_record_id String
  action                String
  integration           IntegrationType
  target                String
  details               String
  url                   String?
  step_id               String?
  type                  RunHistoryActionType
  is_read_only          Boolean              @default(true)
  created_at            DateTime             @default(now())

  run_history_record run_history_records @relation(fields: [run_history_record_id], references: [id], onDelete: Cascade)

  @@index([run_history_record_id])
  @@index([step_id])
  @@index([created_at]) // Index for recent actions ORDER BY created_at DESC
  @@index([is_read_only])
}

enum RunHistoryActionType {
  create
  update
  delete
  read
}

// Pending approvals for tools that require human approval
// Status is tracked via run_history_record.status (awaiting_approval)
model pending_approvals {
  id                    String    @id @default(cuid())
  user_id               String
  run_history_record_id String    @unique
  run_state_json        String    @db.Text // Serialized OpenAI RunState for resumption
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt
  approved_at           DateTime?

  user               users               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  run_history_record run_history_records @relation(fields: [run_history_record_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([created_at])
}

// Chat events from ChannelAgent streaming
model run_history_chat_events {
  id                    String                  @id @default(cuid())
  run_history_record_id String
  event_type            RunHistoryChatEventType
  event_json            Json // Full ModelEvent stored as JSON for easy deserialization
  timestamp             DateTime                @default(now())
  created_at            DateTime                @default(now())

  run_history_record run_history_records @relation(fields: [run_history_record_id], references: [id], onDelete: Cascade)
  directiveRecords   directive_records[]

  @@index([run_history_record_id])
  @@index([timestamp])
}

// Raw AgentStreamEvent stored as JSON for easy loading into OpenAI agent history
model run_history_raw_events {
  id                    String   @id @default(cuid())
  run_history_record_id String
  raw_event_json        Json // Raw AgentStreamEvent stored as JSON for easy loading into OpenAI agent history
  sequence_order        Int // Order of items within a session to preserve exact sequence
  created_at            DateTime @default(now())

  run_history_record run_history_records @relation(fields: [run_history_record_id], references: [id], onDelete: Cascade)

  @@index([run_history_record_id])
  @@index([run_history_record_id, sequence_order])
  @@index([created_at])
}

// MARK: - Notifications

model automation_notification_settings {
  id            String                 @id @default(cuid())
  automation_id String                 @unique
  enabled       Boolean                @default(true)
  action_types  RunHistoryActionType[]
  created_at    DateTime               @default(now())
  updated_at    DateTime               @updatedAt

  automation automations @relation(fields: [automation_id], references: [id], onDelete: Cascade)
}

model user_notification_destinations {
  id               String                      @id @default(cuid())
  user_id          String
  destination_type NotificationDestinationType

  // Slack-specific fields (uses existing slack_integrations for credentials)
  slack_integration_id String?
  slack_channel_id     String?
  slack_channel_name   String?

  // Email-specific fields
  email_address String?

  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user              users                    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  slack_integration user_slack_integrations? @relation(fields: [slack_integration_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([destination_type])
}

enum NotificationDestinationType {
  SLACK
  EMAIL
}

model directive_records {
  id                        String   @id @default(cuid())
  automation_id             String
  run_history_record_id     String
  run_history_chat_event_id String
  directive_description     String
  is_active                 Boolean  @default(true)
  created_at                DateTime @default(now())

  automation             automations             @relation(fields: [automation_id], references: [id], onDelete: Cascade)
  run_history_record     run_history_records     @relation(fields: [run_history_record_id], references: [id], onDelete: Cascade)
  run_history_chat_event run_history_chat_events @relation(fields: [run_history_chat_event_id], references: [id], onDelete: Cascade)

  @@index([automation_id])
  @@index([run_history_record_id])
  @@index([run_history_chat_event_id])
  @@index([is_active])
}

model identifiable_refs {
  id          String   @id @default(cuid())
  entity_type String   // Validated by app against HydratorType enum
  entity_id   String
  created_at  DateTime @default(now())

  @@unique([entity_type, entity_id])
  @@index([entity_type])
}