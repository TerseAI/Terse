# WORKOS_WEBHOOK_SECRET=  # Optional, for webhook verification

# WorkOS Session Duration Configuration (configured in WorkOS Dashboard, not env vars):
# Go to WorkOS Dashboard > Authentication to configure:
# - Access token duration: Default is 5 minutes. For testing session refresh, set to 30 seconds.
# - Maximum session length: Default is 7 days.
# - Inactivity timeout: Default is disabled.
#
# For testing proactive session refresh:
# 1. Set WorkOS Dashboard "Access token duration" to 30 seconds
# 2. Set frontend VITE_SESSION_REFRESH_INTERVAL_MS=20000 (20 seconds)
# 3. Watch backend logs for "Session expired, attempting refresh" messages
