# ─────────────────────────────────────────────────────────────────────────────
# Terse backend env vars. See backend/src/settings.ts for the source of
# truth — every variable below is read there. requireEnv() entries are
# required for the server to boot; optionalEnv() entries are optional and
# fall back to the default shown here in parentheses.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
JWT_SECRET=

# Postgres connection URL for the main app database.
DATABASE_URL=postgres://postgres@localhost/terse

# HTTP path for deployment health probes (load balancers, orchestrators).
HEALTH_CHECK_PATH=/healthz                            # optional, default /healthz

# ── URLs ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001
# SOCKET_FRONTEND_URL=                             # optional, extra origin allowed for socket.io
# BACKEND_PROXY_URL=                               # optional, public proxy URL if backend is fronted by one
# COOKIE_DOMAIN=                                   # optional, set in prod to share cookies across subdomains
# CORS_ALLOWED_ORIGINS=                            # optional, comma-separated extra browser origins (e.g. preview deploys)

# ── Auth (WorkOS) ────────────────────────────────────────────────────────────
# Get these from the WorkOS dashboard: https://dashboard.workos.com
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_COOKIE_PASSWORD=                            # must be 32+ characters
WORKOS_REDIRECT_URI=http://localhost:3001/auth/callback
# WORKOS_WEBHOOK_SECRET=                           # optional, for webhook signature verification

# ── Model providers ──────────────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Separate Anthropic credentials for SDK improvement sandbox runs (see Anthropic console).
ANTHROPIC_IMPROVEMENT_API_KEY=
ANTHROPIC_IMPROVEMENT_WORKSPACE_ID=
GEMINI_API_KEY=
TAVILY_API_KEY=
# MODEL_DEFAULT=openai:gpt-5.6-sol                 # optional, default openai:gpt-5.6-sol

# ── LiteLLM proxy (SDK improvement reviews) ──────────────────────────────────
# When LITELLM_BASE_URL + LITELLM_MASTER_KEY are set, improvement runs mint a per-job virtual key
# instead of using ANTHROPIC_IMPROVEMENT_API_KEY.
LITELLM_BASE_URL=
LITELLM_MASTER_KEY=
# LITELLM_PER_JOB_BUDGET_USD=5                      # optional, default 5
# LITELLM_KEY_TTL=20m                               # optional, default 20m
# LITELLM_KEY_RPM=60                                # optional, default 60

# ── Sandbox execution (Modal) ────────────────────────────────────────────────
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
# RESEND_FROM_EMAIL=notifications@updates.useterse.ai  # optional

# ── Web event monitors (Parallel) ────────────────────────────────────────────
PARALLEL_API_KEY=
PARALLEL_WEBHOOK_SECRET=

# ── Cron auth (Google Cloud Scheduler) ───────────────────────────────────────
# Shared secret used to authenticate Cloud Scheduler → backend cron callbacks.
CLOUD_SCHEDULER_SECRET=

# ── Observability (PostHog) ──────────────────────────────────────────────────
POSTHOG_API_KEY=
# POSTHOG_HOST=https://us.i.posthog.com            # optional
# POSTHOG_SERVICE_NAME=terse-backend               # optional
# POSTHOG_ENABLE_IN_DEV=false                      # optional, set "true" to send dev events

# ── Google Cloud (Secret Manager + GCS) ──────────────────────────────────────
# All optional; only needed if you use Google Secret Manager for integration
# credential storage or GCS for image/code blobs.
# GCP_SERVICE_ACCOUNT_BASE64=                      # base64-encoded service account JSON
# GCP_PROJECT_ID=
# GCP_REGION=us-central1                           # optional, default us-central1
# GCS_IMAGE_BUCKET=terse-documents                 # optional
# GCS_IMAGE_PREFIX=events/images                   # optional
# GCS_CODE_BUCKET=terse-sdk-zips                   # optional
# GCS_CODE_PREFIX=sdk-zips                         # optional

# ── Optional: Redis (rate limiting / caching) ────────────────────────────────
# REDIS_URL=

# ── Billing (external billing service) ───────────────────────────────────────
# When enabled, the backend gates runs and records usage via the billing service.
# BILLING_ENABLED=false                            # optional, default false
# BILLING_SERVICE_URL=                             # optional, billing service base URL
# BILLING_JWT_SECRET=                              # optional, shared secret for billing JWTs

# ─────────────────────────────────────────────────────────────────────────────
# Integration OAuth credentials. Each integration is independent — you only
# need to fill in the ones you plan to use.
# ─────────────────────────────────────────────────────────────────────────────

# ── GitHub App ───────────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_NAME=
GITHUB_APP_CALLBACK_URL=http://localhost:3001/auth/github-app
# GITHUB_LOGIN_CALLBACK_URL=                       # optional
# GITHUB_LOGIN_REDIRECT=http://localhost:5173/     # optional

# ── Slack ────────────────────────────────────────────────────────────────────
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_OAUTH_CALLBACK_URL=http://localhost:3001/slack/oauth-callback
# SLACK_SIGNING_SECRET=                            # optional, required for webhook verification

# ── Linear ───────────────────────────────────────────────────────────────────
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET_ID=
LINEAR_OAUTH_CALLBACK_URL=http://localhost:3001/linear/oauth/callback
LINEAR_WEBHOOK_SIGNING_SECRET=

# ── Notion ───────────────────────────────────────────────────────────────────
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
NOTION_OAUTH_REDIRECT_URI=http://localhost:3001/notion/oauth/callback

# ── Gmail ────────────────────────────────────────────────────────────────────
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3001/gmail/callback
GMAIL_FRONTEND_REDIRECT=http://localhost:5173/
GMAIL_PUBSUB_TOPIC=
# GMAIL_PUBSUB_AUDIENCE=                             # optional in dev; required in prod — Pub/Sub push OIDC audience (often your /webhooks/gmail URL)
# GMAIL_PUBSUB_SERVICE_ACCOUNT_EMAIL=              # optional — verified OIDC token email must match (defense in depth)

# ── Attio ────────────────────────────────────────────────────────────────────
ATTIO_CLIENT_ID=
ATTIO_CLIENT_SECRET=
ATTIO_REDIRECT_URI=http://localhost:3001/attio/oauth/callback

# Meta Ads OAuth (Facebook Login for Business). ads_management / ads_read need
# Advanced Access via Meta App Review before non-developers can connect.
META_ADS_CLIENT_ID=
META_ADS_CLIENT_SECRET=
META_ADS_REDIRECT_URI=http://localhost:3001/meta-ads/oauth/callback

# ─────────────────────────────────────────────────────────────────────────────
# WorkOS session-duration knobs are configured in the WorkOS dashboard, not
# here. For testing proactive session refresh, set the dashboard "Access
# token duration" to 30s and the frontend VITE_SESSION_REFRESH_INTERVAL_MS
# to 20000.
# ─────────────────────────────────────────────────────────────────────────────
