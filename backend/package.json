        "@types/express": "^5.0.3",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/luxon": "^3.7.1",
        "@types/morgan": "^1.9.10",
        "@types/node": "^24.0.10",
        "@types/uuid": "^10.0.0",
        "@types/ws": "^8.18.1",
        "prettier": "^3.8.1",
        "prisma": "^6.19.0",
        "tsc-esm-fix": "^3.1.2",
        "tsx": "^4.20.3",
        "typescript": "^5.8.3"
    }
}
