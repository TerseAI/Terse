{
    "name": "backend",
    "version": "1.0.0",
    "private": true,
    "description": "",
    "main": "index.js",
    "type": "module",
    "scripts": {
        "format": "prettier --config ../.prettierrc --write \"src/**/*.ts\" ",
        "format:check": "prettier --config ../.prettierrc --check \"src/**/*.ts\"",
        "predev": "pnpm run db:generate",
        "dev": "node ./scripts/dev.mjs",
        "dev:server": "tsx watch src/server.ts",
        "dev:tunnel": "node ./scripts/dev.mjs --tunnel",
        "build": "tsc && pnpm run postbuild",
        "postbuild": "tsc-esm-fix dist && mkdir -p dist/generated && cp -r src/generated/local-prisma dist/generated/local-prisma && cp -r src/modules/notifications/emails/templates dist/modules/notifications/emails/templates && cp -r src/modules/notifications/emails/assets dist/modules/notifications/emails/assets && cp -r ../packages/terse-claude-plugin dist/terse-claude-plugin",
        "start": "node dist/server.js",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "test:owner": "tsx src/testing/testRunner.ts",
        "test:processor": "tsx src/testing/testEventProcessor.ts",
        "test:processor:quick": "tsx src/testing/quickProcessorTest.ts",
        "test:seed-run-history": "tsx src/testing/seedRunHistory.ts",
        "db:generate": "prisma generate && prisma generate --schema=./prisma/local/schema.prisma",
        "db:push": "prisma db push",
        "db:push:local": "prisma db push --schema=./prisma/local/schema.prisma",
        "db:migrate:local": "prisma migrate dev --schema=./prisma/local/schema.prisma",
        "db:studio": "prisma studio",
        "index-tickets": "./index-tickets.sh"
    },
    "keywords": [],
    "author": "",
    "license": "SEE LICENSE IN ../LICENSE.md",
    "dependencies": {
        "@ai-sdk/anthropic": "^3.0.71",
        "@ai-sdk/openai": "^3.0.53",
        "@datadog/datadog-api-client": "^1.51.0",
        "@google-cloud/scheduler": "^5.3.1",
        "@google-cloud/secret-manager": "^6.1.1",
        "@google-cloud/storage": "^7.14.0",
        "@google/genai": "^1.42.0",
        "@googleapis/gmail": "^16.1.1",
        "@linear/sdk": "^45.3.0",
        "@notionhq/client": "^5.4.0",
        "@octokit/rest": "^22.0.1",
        "@openai/agents": "^0.8.5",
        "@openai/agents-core": "^0.8.5",
        "@openai/agents-extensions": "^0.8.5",
        "@opentelemetry/api-logs": "^0.217.0",
        "@opentelemetry/exporter-logs-otlp-http": "^0.217.0",
        "@opentelemetry/resources": "^2.2.0",
        "@opentelemetry/sdk-logs": "^0.217.0",
        "@opentelemetry/sdk-node": "^0.217.0",
        "@posthog/ai": "^7.8.11",
        "@prisma/client": "6.19.0",
        "@slack/bolt": "^4.6.0",
        "@slack/types": "^2.19.0",
        "@slack/web-api": "^7.13.0",
        "@socket.io/redis-adapter": "^8.3.0",
        "@tavily/core": "^0.7.2",
        "@workos-inc/node": "^8.0.0",
        "adm-zip": "^0.5.16",
        "ai": "^6.0.168",
        "axios": "^1.15.2",
        "body-parser": "^2.2.1",
        "bottleneck": "^2.19.5",
        "chalk": "^5.4.1",
        "cheerio": "^1.2.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^17.0.1",
        "express": "^5.1.0",
        "fernet": "^0.3.3",
        "fflate": "^0.8.2",
        "google-auth-library": "^10.5.0",
        "handlebars": "^4.7.8",
        "helmet": "^8.2.0",
        "ipaddr.js": "^2.4.0",
        "jose": "6.1.3",
        "jsonwebtoken": "^9.0.2",
        "luxon": "^3.7.2",
        "mime": "^4.0.7",
        "modal": "^0.7.2",
        "morgan": "^1.10.1",
        "openai": "^6.10.0",
        "parallel-web": "^0.3.2",
        "posthog-node": "^4.18.0",
        "rate-limiter-flexible": "^11.1.0",
        "redis": "^5.9.0",
        "resend": "^6.9.2",
        "snowflake-sdk": "^2.3.5",
        "socket.io": "^4.8.1",
        "terse-types": "workspace:*",
        "undici": "^8.3.0",
        "uuid": "^11.0.3",
