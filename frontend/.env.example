# Vite-injected env vars for the frontend. Anything starting with VITE_ is
# bundled into the client; do not put secrets here.

# Socket.io endpoint (websocket). In dev this hits the backend directly.
VITE_SOCKET_URL=ws://localhost:3001

# Path mounted under window.location for socket.io's HTTP polling fallback.
VITE_WS_BASE=/api

# Backend URL used for browser redirects (login/logout) that bypass axios.
# In dev this points at the backend dev server directly.
VITE_BACKEND_REDIRECT_URL=http://localhost:3001

# How often (ms) the client proactively refreshes the WorkOS session.
# Match this to your WorkOS access-token duration; default is set for the
# 30-second dashboard setting used during refresh testing.
VITE_SESSION_REFRESH_INTERVAL_MS=20000

# PostHog (frontend product analytics). Optional — leave blank to disable.
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
